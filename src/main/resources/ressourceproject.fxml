<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controles.ressourceprojectcontroller">

   <!-- Header -->
   <top>
      <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: white; -fx-padding: 15px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);">
         <Button text="🡄 Retour aux Projets" styleClass="btn-nav" onAction="#goToProjects" prefHeight="35"/>
         <Region HBox.hgrow="ALWAYS" />
         <Label text="Gestion des Ressources" styleClass="title-label" />
      </HBox>
   </top>

   <!-- Main Content -->
   <center>
      <HBox spacing="20" BorderPane.alignment="CENTER">
         <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
         </padding>

         <!-- Left Side: Form -->
         <VBox spacing="15" prefWidth="380" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <Label text="Détails de la Ressource" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #476C1A;"/>

            <GridPane vgap="12" hgap="10">
               <columnConstraints>
                  <ColumnConstraints percentWidth="35"/>
                  <ColumnConstraints percentWidth="65"/>
               </columnConstraints>

               <Label text="Projet Lié (ID):" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
               <ComboBox fx:id="cbIdProject" promptText="Choisir Projet..." prefWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

               <Label text="Nom Ressource:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
               <TextField fx:id="tfNomRessource" promptText="Ex: Tracteur" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

               <Label text="Type:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
               <ComboBox fx:id="cbTypeRessource" promptText="Type..." prefWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

               <Label text="Quantité:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
               <TextField fx:id="tfQuantite" promptText="Ex: 1" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

               <Label text="Coût Total:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
               <TextField fx:id="tfCout" promptText="Ex: 8000.00" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

               <Label text="Fournisseur:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
               <TextField fx:id="tfFournisseur" promptText="Ex: Agro Equipement" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

               <Label text="Statut:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
               <ComboBox fx:id="cbStatutRessource" promptText="Statut..." prefWidth="Infinity" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

               <Label text="Date Ajout:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
               <DatePicker fx:id="dpDateAjout" prefWidth="Infinity" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
            </GridPane>

            <Region VBox.vgrow="ALWAYS" /> <!-- Pushes buttons to bottom -->

            <HBox spacing="10" alignment="CENTER">
               <Button text="Ajouter" styleClass="btn-primary" onAction="#addRessource" prefWidth="90" prefHeight="35"/>
               <Button text="Modifier" styleClass="btn-secondary" onAction="#updateRessource" prefWidth="90" prefHeight="35"/>
               <Button text="Supprimer" styleClass="btn-danger" onAction="#deleteRessource" prefWidth="90" prefHeight="35"/>
            </HBox>
            <Button text="Vider les champs" style="-fx-background-color: transparent; -fx-text-fill: #848A86; -fx-cursor: hand;" onAction="#clearFields" maxWidth="Infinity" alignment="CENTER"/>
         </VBox>

         <!-- Right Side: Zone des Cartes (Remplaçant le TableView) -->
         <VBox HBox.hgrow="ALWAYS" spacing="10">
            <Label text="Liste des Ressources" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #060806;"/>

            <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
               <FlowPane fx:id="ressourcesContainer" hgap="15" vgap="15" style="-fx-padding: 5;">
                  <!-- Les cartes de ressources générées en Java iront ici -->
               </FlowPane>
            </ScrollPane>
         </VBox>
      </HBox>
   </center>
</BorderPane>