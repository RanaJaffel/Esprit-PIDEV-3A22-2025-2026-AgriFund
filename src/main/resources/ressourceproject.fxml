<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@style.css" style="-fx-background-color: #F8F9FA;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controles.ressourceprojectcontroller">


   <top>
      <VBox spacing="0">

         <HBox alignment="CENTER_LEFT" spacing="20" styleClass="page-header">
            <padding>
               <Insets top="18" right="30" bottom="18" left="30"/>
            </padding>

            <Button text="← Retour aux Projets" styleClass="btn-nav"
                    onAction="#goToProjects" prefHeight="38" prefWidth="180"
                    style="-fx-text-fill: white; -fx-font-size: 14px;"/>

            <Region HBox.hgrow="ALWAYS"/>


            <HBox alignment="CENTER" spacing="12">
               <Label text="📦" style="-fx-font-size: 32px;"/>
               <VBox spacing="0">
                  <Label text="Inventaire des Ressources" styleClass="header-title" style="-fx-font-size: 26px;"/>
                  <Label text="Gestion complète des ressources agricoles"
                         style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 13px;"/>
               </VBox>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>


            <Button text="📄 Exporter PDF" styleClass="btn-info"
                    style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600;"
                    onAction="#exportToPDF" prefHeight="38" prefWidth="150">
               <tooltip>
                  <Tooltip text="Exporter la liste des ressources en PDF"/>
               </tooltip>
            </Button>
         </HBox>


         <HBox alignment="CENTER_LEFT" spacing="15" styleClass="toolbar">
            <padding>
               <Insets top="15" right="30" bottom="15" left="30"/>
            </padding>

            <VBox spacing="3">
               <Label text="📋 Liste des Ressources" styleClass="subtitle-label" style="-fx-font-size: 18px;"/>
               <Label text="Visualisez et gérez toutes vos ressources" style="-fx-text-fill: #6C757D; -fx-font-size: 12px;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>


            <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-background-color: #F8F9FA; -fx-background-radius: 20; -fx-padding: 8 16;">
               <Label text="🔍" style="-fx-font-size: 16px;"/>
               <TextField fx:id="tfSearchRessource" promptText="Rechercher par nom..."
                          prefWidth="220" style="-fx-background-color: transparent; -fx-border-width: 0;"/>
            </HBox>


            <ComboBox fx:id="cbFilterTypeList" promptText="Filtrer par type"
                      prefWidth="160" style="-fx-font-size: 13px;"/>


            <Button text="+ Nouvelle Ressource" styleClass="btn-primary"
                    onAction="#openAddResourceForm"
                    prefHeight="40"
                    prefWidth="190"
                    style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
         </HBox>
      </VBox>
   </top>


   <center>
      <VBox spacing="0" VBox.vgrow="ALWAYS">
         <padding>
            <Insets top="25" right="30" bottom="25" left="30"/>
         </padding>


         <HBox spacing="20" alignment="CENTER_LEFT">
            <padding>
               <Insets bottom="20"/>
            </padding>


            <HBox spacing="15" alignment="CENTER_LEFT" styleClass="stat-card" HBox.hgrow="ALWAYS">
               <StackPane styleClass="icon-container" style="-fx-min-width: 55; -fx-min-height: 55; -fx-background-color: #D8F3DC;">
                  <Label text="📊" style="-fx-font-size: 28px;"/>
               </StackPane>
               <VBox spacing="4">
                  <Label text="Total Ressources" styleClass="stat-label" style="-fx-font-size: 13px;"/>
                  <Label fx:id="lblTotalRessources" text="--" styleClass="stat-value" style="-fx-font-size: 28px;"/>
               </VBox>
            </HBox>


            <HBox spacing="15" alignment="CENTER_LEFT" styleClass="stat-card" HBox.hgrow="ALWAYS">
               <StackPane styleClass="icon-container" style="-fx-min-width: 55; -fx-min-height: 55; -fx-background-color: #FFE5CC;">
                  <Label text="🚜" style="-fx-font-size: 28px;"/>
               </StackPane>
               <VBox spacing="4">
                  <Label text="Équipements" styleClass="stat-label" style="-fx-font-size: 13px;"/>
                  <Label fx:id="lblEquipments" text="--" styleClass="stat-value" style="-fx-font-size: 28px; -fx-text-fill: #E67E22;"/>
               </VBox>
            </HBox>


            <HBox spacing="15" alignment="CENTER_LEFT" styleClass="stat-card" HBox.hgrow="ALWAYS">
               <StackPane styleClass="icon-container" style="-fx-min-width: 55; -fx-min-height: 55; -fx-background-color: #E5F4FF;">
                  <Label text="⚙" style="-fx-font-size: 28px;"/>
               </StackPane>
               <VBox spacing="4">
                  <Label text="Matériaux" styleClass="stat-label" style="-fx-font-size: 13px;"/>
                  <Label fx:id="lblMaterials" text="--" styleClass="stat-value" style="-fx-font-size: 28px; -fx-text-fill: #457B9D;"/>
               </VBox>
            </HBox>


            <HBox spacing="15" alignment="CENTER_LEFT" styleClass="stat-card" HBox.hgrow="ALWAYS">
               <StackPane styleClass="icon-container" style="-fx-min-width: 55; -fx-min-height: 55; -fx-background-color: #F3E5F5;">
                  <Label text="🔧" style="-fx-font-size: 28px;"/>
               </StackPane>
               <VBox spacing="4">
                  <Label text="Services" styleClass="stat-label" style="-fx-font-size: 13px;"/>
                  <Label fx:id="lblServices" text="--" styleClass="stat-value" style="-fx-font-size: 28px; -fx-text-fill: #8B7355;"/>
               </VBox>
            </HBox>
         </HBox>


         <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS"
                     style="-fx-background-color: transparent; -fx-border-width: 0;">
            <FlowPane fx:id="ressourcesContainer" hgap="20" vgap="20"
                      style="-fx-padding: 5; -fx-background-color: transparent;"/>
         </ScrollPane>
      </VBox>
   </center>
</BorderPane>
