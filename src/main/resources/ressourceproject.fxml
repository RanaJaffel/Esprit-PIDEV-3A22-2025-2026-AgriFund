<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@style.css" style="-fx-background-color: #f4f7f4;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controles.ressourceprojectcontroller">

   <!-- Header -->
   <top>
      <HBox alignment="CENTER_LEFT" spacing="20"
            style="-fx-background-color: linear-gradient(to right, #095032, #089647); -fx-padding: 15px 25px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.25), 10, 0, 0, 2);">
         <Button text="🡄 Retour aux Projets" styleClass="btn-nav"
                 style="-fx-background-color: #E1B323; -fx-text-fill: #133D03;"
                 onAction="#goToProjects" prefHeight="35"/>
         <Region HBox.hgrow="ALWAYS" />
         <Label text="🚜 Inventaire des Ressources" styleClass="title-label"
                style="-fx-text-fill: white; -fx-font-size: 22px;" />
         <Region HBox.hgrow="ALWAYS" />
      </HBox>
   </top>

   <!-- Main Content -->
   <center>
      <VBox spacing="15">
         <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>

         <HBox alignment="CENTER_LEFT" spacing="15">
            <Label text="📦 Ressources Disponibles / Prévues"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #133D03;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="tfSearchRessource" promptText="🔍 Rechercher par nom..."
                       prefWidth="250" style="-fx-font-size: 14px; -fx-padding: 8px;"/>
            <ComboBox fx:id="cbFilterTypeList" promptText="Tous les types"
                      style="-fx-font-size: 14px; -fx-padding: 4px;"/>
            <Button text="➕ Nouvelle Ressource" styleClass="btn-primary"
                    onAction="#openAddRessourceForm" prefHeight="38"/>
         </HBox>

         <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
            <FlowPane fx:id="ressourcesContainer" hgap="15" vgap="15" style="-fx-padding: 5;"/>
         </ScrollPane>
      </VBox>
   </center>
</BorderPane>