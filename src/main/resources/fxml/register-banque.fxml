<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controllers.RegisterBanqueController"
            stylesheets="@../css/styles.css"
            style="-fx-background-color: #f5f5f5;">

    <!-- NAVBAR -->
    <top>
        <HBox styleClass="navbar" alignment="CENTER">
            <HBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <VBox alignment="CENTER_LEFT" style="-fx-cursor: hand;" onMouseClicked="#goToHome">
                    <Label text="🌾 AgriFund" styleClass="navbar-brand"/>
                    <Label text="Plateforme de Financement Agricole" style="-fx-font-size: 11px; -fx-text-fill: #848A86;"/>
                </VBox>
            </HBox>

            <HBox spacing="15" alignment="CENTER_RIGHT">
                <Label text="Déjà un compte ?" style="-fx-text-fill: white;"/>
                <Button text="Se connecter" styleClass="btn, btn-secondary" onAction="#goToLogin"/>
            </HBox>
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <HBox alignment="CENTER" style="-fx-padding: 50;">

                <!-- LEFT SIDE - Info -->
                <VBox alignment="CENTER" spacing="30" prefWidth="400" style="-fx-padding: 50;">
                    <Label text="🏦" style="-fx-font-size: 80px;"/>
                    <Label text="Rejoignez AgriFund" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #060806;"/>
                    <Label text="En tant qu'institution financière" style="-fx-font-size: 18px; -fx-text-fill: #E1B323;"/>

                    <VBox spacing="20" style="-fx-padding: 30 0 0 0;">
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="✓" style="-fx-text-fill: #E1B323; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                            <VBox>
                                <Label text="Accès aux agriculteurs" style="-fx-font-weight: bold;"/>
                                <Label text="Consultez les profils des agriculteurs vérifiés" style="-fx-text-fill: #848A86; -fx-font-size: 12px;"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="✓" style="-fx-text-fill: #E1B323; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                            <VBox>
                                <Label text="Gestion des demandes" style="-fx-font-weight: bold;"/>
                                <Label text="Évaluez et traitez les demandes de financement" style="-fx-text-fill: #848A86; -fx-font-size: 12px;"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="✓" style="-fx-text-fill: #E1B323; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                            <VBox>
                                <Label text="Tableau de bord" style="-fx-font-weight: bold;"/>
                                <Label text="Suivez vos financements et statistiques" style="-fx-text-fill: #848A86; -fx-font-size: 12px;"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="✓" style="-fx-text-fill: #E1B323; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                            <VBox>
                                <Label text="Communication directe" style="-fx-font-weight: bold;"/>
                                <Label text="Échangez avec les agriculteurs via la messagerie" style="-fx-text-fill: #848A86; -fx-font-size: 12px;"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- RIGHT SIDE - Form -->
                <VBox styleClass="card" prefWidth="550" spacing="20" style="-fx-padding: 40;">
                    <Label text="Créer votre compte" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #060806;"/>
                    <Label text="Remplissez les informations de votre établissement" style="-fx-text-fill: #848A86;"/>

                    <!-- Alert Box -->
                    <HBox fx:id="alertBox" styleClass="alert, alert-danger" visible="false" managed="false">
                        <Label fx:id="alertMessage" style="-fx-text-fill: #dc3545;"/>
                    </HBox>

                    <!-- Success Box -->
                    <HBox fx:id="successBox" styleClass="alert, alert-success" visible="false" managed="false">
                        <Label fx:id="successMessage" style="-fx-text-fill: #089647;"/>
                    </HBox>

                    <!-- Form -->
                    <VBox styleClass="form-group" spacing="8">
                        <Label text="Nom de la banque *" styleClass="form-label"/>
                        <TextField fx:id="nomBanqueField" styleClass="form-control" promptText="Nom de votre établissement"/>
                    </VBox>

                    <HBox spacing="20">
                        <VBox styleClass="form-group" spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Code banque *" styleClass="form-label"/>
                            <TextField fx:id="codeBanqueField" styleClass="form-control" promptText="Ex: BNA, STB..."/>
                        </VBox>
                        <VBox styleClass="form-group" spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Représentant légal *" styleClass="form-label"/>
                            <TextField fx:id="representantField" styleClass="form-control" promptText="Nom du représentant"/>
                        </VBox>
                    </HBox>

                    <VBox styleClass="form-group" spacing="8">
                        <Label text="Email professionnel *" styleClass="form-label"/>
                        <TextField fx:id="emailField" styleClass="form-control" promptText="contact@banque.tn"/>
                    </VBox>

                    <HBox spacing="20">
                        <VBox styleClass="form-group" spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Mot de passe *" styleClass="form-label"/>
                            <PasswordField fx:id="passwordField" styleClass="form-control" promptText="••••••••"/>
                        </VBox>
                        <VBox styleClass="form-group" spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Confirmer *" styleClass="form-label"/>
                            <PasswordField fx:id="confirmPasswordField" styleClass="form-control" promptText="••••••••"/>
                        </VBox>
                    </HBox>

                    <Separator style="-fx-padding: 10 0;"/>

                    <Label text="Informations complémentaires" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #E1B323;"/>

                    <VBox styleClass="form-group" spacing="8">
                        <Label text="Adresse du siège *" styleClass="form-label"/>
                        <TextField fx:id="adresseSiegeField" styleClass="form-control" promptText="Adresse complète du siège"/>
                    </VBox>

                    <HBox spacing="20">
                        <VBox styleClass="form-group" spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Adresse agence" styleClass="form-label"/>
                            <TextField fx:id="adresseAgenceField" styleClass="form-control" promptText="Adresse de l'agence (optionnel)"/>
                        </VBox>
                        <VBox styleClass="form-group" spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Site web" styleClass="form-label"/>
                            <TextField fx:id="siteWebField" styleClass="form-control" promptText="www.banque.tn"/>
                        </VBox>
                    </HBox>

                    <VBox styleClass="form-group" spacing="8">
                        <Label text="Téléphone" styleClass="form-label"/>
                        <TextField fx:id="telField" styleClass="form-control" promptText="+216 XX XXX XXX"/>
                    </VBox>

                    <!-- Terms -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <CheckBox fx:id="termsCheckbox"/>
                        <Label text="J'accepte les " style="-fx-text-fill: #060806;"/>
                        <Hyperlink text="conditions d'utilisation" style="-fx-text-fill: #E1B323;"/>
                        <Label text=" et la " style="-fx-text-fill: #060806;"/>
                        <Hyperlink text="politique de confidentialité" style="-fx-text-fill: #E1B323;"/>
                    </HBox>

                    <!-- Submit Button -->
                    <Button text="Créer mon compte" styleClass="btn, btn-accent, btn-large"
                            onAction="#handleRegister" prefWidth="1000"/>

                    <!-- Links -->
                    <HBox alignment="CENTER" spacing="5">
                        <Label text="Vous êtes un agriculteur ?" style="-fx-text-fill: #848A86;"/>
                        <Hyperlink text="Inscrivez-vous ici" onAction="#goToRegisterAgriculteur" style="-fx-text-fill: #089647;"/>
                    </HBox>

                    <HBox alignment="CENTER">
                        <Hyperlink text="← Retour à l'accueil" onAction="#goToHome" style="-fx-text-fill: #848A86;"/>
                    </HBox>
                </VBox>

            </HBox>
        </ScrollPane>
    </center>

</BorderPane>