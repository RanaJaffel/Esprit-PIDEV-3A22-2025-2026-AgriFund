<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controllers.LoginController"
            stylesheets="@../css/styles.css"
            style="-fx-background-color: linear-gradient(to right, #060806, #095032);">

    <center>
        <HBox alignment="CENTER" spacing="0">

            <!-- LEFT SIDE - Branding -->
            <VBox alignment="CENTER" spacing="30" prefWidth="500" style="-fx-padding: 50;">
                <Label text="🌾" style="-fx-font-size: 80px;"/>
                <Label text="AgriFund" style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-text-fill: #B2D944;"/>
                <Label text="Plateforme de Financement Agricole" style="-fx-font-size: 18px; -fx-text-fill: white;"/>

                <VBox spacing="15" style="-fx-padding: 40 0 0 0;">
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label text="✓" style="-fx-text-fill: #B2D944; -fx-font-size: 18px;"/>
                        <Label text="Financements adaptés aux agriculteurs" style="-fx-text-fill: white;"/>
                    </HBox>
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label text="✓" style="-fx-text-fill: #B2D944; -fx-font-size: 18px;"/>
                        <Label text="Processus simple et transparent" style="-fx-text-fill: white;"/>
                    </HBox>
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label text="✓" style="-fx-text-fill: #B2D944; -fx-font-size: 18px;"/>
                        <Label text="Réseau de banques partenaires" style="-fx-text-fill: white;"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- RIGHT SIDE - Login Form -->
            <VBox alignment="CENTER" prefWidth="450" style="-fx-background-color: white; -fx-background-radius: 20 0 0 20; -fx-padding: 50;">

                <VBox spacing="25" maxWidth="350">
                    <VBox spacing="5">
                        <Label text="Connexion" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #060806;"/>
                        <Label text="Bienvenue ! Connectez-vous à votre compte" style="-fx-text-fill: #848A86;"/>
                    </VBox>

                    <!-- Alert Message -->
                    <HBox fx:id="alertBox" styleClass="alert, alert-danger" visible="false" managed="false">
                        <Label fx:id="alertMessage" style="-fx-text-fill: #dc3545;"/>
                    </HBox>

                    <!-- Email Field -->
                    <VBox styleClass="form-group" spacing="8">
                        <Label text="Email" styleClass="form-label"/>
                        <TextField fx:id="emailField" styleClass="form-control" promptText="votre@email.com"/>
                    </VBox>

                    <!-- Password Field -->
                    <VBox styleClass="form-group" spacing="8">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Mot de passe" styleClass="form-label" HBox.hgrow="ALWAYS"/>
                            <Hyperlink text="Mot de passe oublié ?" onAction="#goToForgotPassword"
                                       style="-fx-text-fill: #089647; -fx-font-size: 12px;"/>
                        </HBox>
                        <PasswordField fx:id="passwordField" styleClass="form-control" promptText="••••••••"/>
                    </VBox>

                    <!-- Remember Me -->
                    <CheckBox fx:id="rememberMe" text="Se souvenir de moi" style="-fx-text-fill: #060806;"/>

                    <!-- Login Button -->
                    <Button text="Se connecter" styleClass="btn, btn-primary"
                            onAction="#handleLogin" prefWidth="350" prefHeight="45"/>

                    <!-- Separator -->
                    <HBox alignment="CENTER" spacing="15" style="-fx-padding: 10 0;">
                        <Separator HBox.hgrow="ALWAYS"/>
                        <Label text="OU" style="-fx-text-fill: #848A86;"/>
                        <Separator HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <!-- Register Links -->
                    <VBox spacing="10" alignment="CENTER">
                        <Label text="Pas encore de compte ?" style="-fx-text-fill: #848A86;"/>
                        <HBox spacing="15" alignment="CENTER">
                            <Button text="🌾 Inscription Agriculteur" styleClass="btn, btn-secondary"
                                    onAction="#goToRegisterAgriculteur"/>
                            <Button text="🏦 Inscription Banque" styleClass="btn, btn-secondary"
                                    onAction="#goToRegisterBanque"/>
                        </HBox>
                    </VBox>

                    <!-- Back to Home -->
                    <HBox alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                        <Hyperlink text="← Retour à l'accueil" onAction="#goToHome"
                                   style="-fx-text-fill: #848A86;"/>
                    </HBox>
                </VBox>

            </VBox>
        </HBox>
    </center>

</BorderPane>