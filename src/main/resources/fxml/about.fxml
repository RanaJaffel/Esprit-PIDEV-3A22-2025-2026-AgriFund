<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controllers.AboutController"
            stylesheets="@../css/about.css">

    <!-- NAVBAR -->
    <top>
        <HBox styleClass="navbar-modern" alignment="CENTER">
            <!-- Logo -->
            <HBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" spacing="15">
                <VBox styleClass="logo-container" alignment="CENTER_LEFT" onMouseClicked="#goToHome">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="🌾" style="-fx-font-size: 32px;"/>
                        <Label text="AgriFund" styleClass="logo-text"/>
                    </HBox>
                    <Label text="Plateforme de Financement Agricole" styleClass="logo-subtitle"/>
                </VBox>
            </HBox>

            <!-- Nav Links -->
            <HBox styleClass="nav-links" alignment="CENTER">
                <Button text="Accueil" styleClass="nav-link" onAction="#goToHome"/>
                <Button text="À propos" styleClass="nav-link, nav-link-active"/>
                <Button text="Services" styleClass="nav-link" onAction="#goToHome"/>
                <Button text="Contact" styleClass="nav-link" onAction="#scrollToContact"/>
            </HBox>

            <!-- Auth Buttons -->
            <HBox spacing="15" alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                <Button text="Se connecter" styleClass="btn-nav-secondary" onAction="#goToLogin"/>
                <Button text="S'inscrire" styleClass="btn-nav-primary" onAction="#showRegisterOptions"/>
            </HBox>
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
