        <ScrollPane fitToWidth="true" styleClass="transparent-scroll" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER">
            <VBox spacing="0">

                <!-- ==================== HERO SECTION ==================== -->
                <StackPane styleClass="hero-about">
                    <!-- Floating Shapes -->
                    <Pane mouseTransparent="true">
                        <Circle layoutX="100" layoutY="80" radius="120" styleClass="floating-shape, shape-filled-1"/>
                        <Circle layoutX="1100" layoutY="300" radius="150" styleClass="floating-shape, shape-filled-2"/>
                        <Rectangle layoutX="950" layoutY="50" width="80" height="80" arcWidth="20" arcHeight="20"
                                   styleClass="floating-shape, shape-filled-1" rotate="45"/>
                        <Circle layoutX="200" layoutY="350" radius="60" styleClass="floating-shape"/>
                    </Pane>

                    <VBox spacing="25" alignment="CENTER">
                        <!-- Breadcrumb -->
                        <HBox spacing="10" alignment="CENTER">
                            <Label text="Accueil" styleClass="breadcrumb" style="-fx-cursor: hand;" onMouseClicked="#goToHome"/>
                            <Label text="→" styleClass="breadcrumb"/>
                            <Label text="À propos" styleClass="breadcrumb, breadcrumb-active"/>
                        </HBox>

                        <!-- Badge -->
                        <HBox alignment="CENTER">
                            <HBox styleClass="hero-badge" spacing="10">
                                <Label text="🌱" style="-fx-font-size: 16px;"/>
                                <Label text="Notre Histoire" styleClass="hero-badge-text"/>
                            </HBox>
                        </HBox>

                        <Label text="À Propos de Nous" styleClass="hero-title-about"/>
                        <Label text="Découvrez notre mission, nos valeurs et l'équipe passionnée derrière AgriFund"
                               styleClass="hero-subtitle-about" wrapText="true" maxWidth="600" textAlignment="CENTER"/>
                    </VBox>
                </StackPane>

                <!-- ==================== MISSION SECTION ==================== -->
                <VBox styleClass="mission-section" spacing="60">
                    <HBox spacing="80" alignment="CENTER">
                        <!-- Left Content -->
                        <VBox spacing="25" maxWidth="550">
                            <HBox>
                                <HBox styleClass="section-badge">
                                    <Label text="🎯 NOTRE MISSION" styleClass="section-badge-text"/>
                                </HBox>
                            </HBox>

                            <Label text="Démocratiser le financement agricole" styleClass="section-title" wrapText="true"/>

                            <Label text="AgriFund est née d'une vision simple mais ambitieuse : faciliter l'accès au financement pour tous les agriculteurs tunisiens."
                                   styleClass="mission-text" wrapText="true"/>

                            <Label text="Notre plateforme innovante met en relation directe les agriculteurs avec les institutions financières, simplifiant le processus de demande de financement et offrant des solutions sur mesure adaptées aux besoins spécifiques du secteur agricole tunisien."
                                   styleClass="mission-description" wrapText="true"/>

                            <!-- Stats -->
                            <HBox spacing="20" style="-fx-padding: 20 0 0 0;">
                                <VBox styleClass="stat-box" spacing="5">
                                    <Label text="500+" styleClass="stat-number"/>
                                    <Label text="Agriculteurs" styleClass="stat-label"/>
                                </VBox>
                                <VBox styleClass="stat-box" spacing="5">
                                    <Label text="25+" styleClass="stat-number"/>
                                    <Label text="Banques" styleClass="stat-label"/>
                                </VBox>
                                <VBox styleClass="stat-box" spacing="5">
                                    <Label text="15M" styleClass="stat-number"/>
                                    <Label text="DT Financés" styleClass="stat-label"/>
                                </VBox>
                                <VBox styleClass="stat-box" spacing="5">
                                    <Label text="98%" styleClass="stat-number"/>
                                    <Label text="Satisfaction" styleClass="stat-label"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Right Content - Image -->
                        <StackPane styleClass="mission-image-container" prefWidth="420" prefHeight="380">
                            <VBox alignment="CENTER" spacing="15">
                                <Label text="🌾" styleClass="mission-emoji"/>
                                <HBox spacing="15" alignment="CENTER">
                                    <Label text="🚜" style="-fx-font-size: 35px;"/>
                                    <Label text="💰" style="-fx-font-size: 35px;"/>
                                    <Label text="🏦" style="-fx-font-size: 35px;"/>
                                </HBox>
                            </VBox>
                        </StackPane>
                    </HBox>
                </VBox>

                <!-- ==================== VALUES SECTION ==================== -->
