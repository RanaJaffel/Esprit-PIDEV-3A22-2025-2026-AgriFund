<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controllers.ForgotPasswordController"
            stylesheets="@../css/styles.css"
            style="-fx-background-color: linear-gradient(to right, #060806, #095032);">

    <center>
        <HBox alignment="CENTER">

            <!-- Card Container -->
            <VBox styleClass="card" prefWidth="500" spacing="25" style="-fx-padding: 50;">

                <!-- Header -->
                <VBox alignment="CENTER" spacing="10">
                    <Label text="🔐" style="-fx-font-size: 60px;"/>
                    <Label text="Mot de passe oublié ?" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #060806;"/>
                    <Label text="Pas de panique ! Nous allons vous aider." style="-fx-text-fill: #848A86;"/>
                </VBox>

                <!-- Alert Box -->
                <HBox fx:id="alertBox" styleClass="alert, alert-danger" visible="false" managed="false">
                    <Label fx:id="alertMessage" style="-fx-text-fill: #dc3545;"/>
                </HBox>

                <!-- Success Box -->
                <HBox fx:id="successBox" styleClass="alert, alert-success" visible="false" managed="false">
                    <Label fx:id="successMessage" style="-fx-text-fill: #089647;" wrapText="true"/>
                </HBox>

                <!-- Step 1: Email -->
                <VBox fx:id="step1" spacing="20">
                    <Label text="Entrez votre adresse email et nous vous enverrons un code de réinitialisation."
                           style="-fx-text-fill: #848A86;" wrapText="true" textAlignment="CENTER"/>

                    <VBox styleClass="form-group" spacing="8">
                        <Label text="Email" styleClass="form-label"/>
                        <TextField fx:id="emailField" styleClass="form-control" promptText="votre@email.com"/>
                    </VBox>

                    <Button text="Envoyer le code" styleClass="btn, btn-primary, btn-large"
                            onAction="#handleSendCode" prefWidth="1000"/>
                </VBox>

                <!-- Step 2: Token + New Password -->
                <VBox fx:id="step2" spacing="20" visible="false" managed="false">
                    <Label text="Un code a été envoyé à votre adresse email. Entrez-le ci-dessous avec votre nouveau mot de passe."
                           style="-fx-text-fill: #848A86;" wrapText="true" textAlignment="CENTER"/>

                    <VBox styleClass="form-group" spacing="8">
                        <Label text="Code de réinitialisation" styleClass="form-label"/>
                        <TextField fx:id="tokenField" styleClass="form-control" promptText="Collez le code reçu par email"/>
                    </VBox>

                    <VBox styleClass="form-group" spacing="8">
                        <Label text="Nouveau mot de passe" styleClass="form-label"/>
                        <PasswordField fx:id="newPasswordField" styleClass="form-control" promptText="••••••••"/>
                    </VBox>

                    <VBox styleClass="form-group" spacing="8">
                        <Label text="Confirmer le mot de passe" styleClass="form-label"/>
                        <PasswordField fx:id="confirmPasswordField" styleClass="form-control" promptText="••••••••"/>
                    </VBox>

                    <Button text="Réinitialiser le mot de passe" styleClass="btn, btn-primary, btn-large"
                            onAction="#handleResetPassword" prefWidth="1000"/>

                    <HBox alignment="CENTER">
                        <Hyperlink text="← Renvoyer le code" onAction="#handleResendCode" style="-fx-text-fill: #089647;"/>
                    </HBox>
                </VBox>

                <!-- Step 3: Success -->
                <VBox fx:id="step3" spacing="20" visible="false" managed="false" alignment="CENTER">
                    <Label text="✅" style="-fx-font-size: 60px;"/>
                    <Label text="Mot de passe réinitialisé !" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #089647;"/>
                    <Label text="Vous pouvez maintenant vous connecter avec votre nouveau mot de passe."
                           style="-fx-text-fill: #848A86;" textAlignment="CENTER"/>

                    <Button text="Se connecter" styleClass="btn, btn-primary, btn-large"
                            onAction="#goToLogin" prefWidth="1000"/>
                </VBox>

                <!-- Back Link -->
                <HBox alignment="CENTER">
                    <Hyperlink text="← Retour à la connexion" onAction="#goToLogin" style="-fx-text-fill: #848A86;"/>
                </HBox>

            </VBox>

        </HBox>
    </center>

</BorderPane>