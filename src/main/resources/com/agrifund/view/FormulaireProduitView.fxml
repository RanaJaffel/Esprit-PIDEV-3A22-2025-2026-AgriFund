<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.*?>

<VBox spacing="25" alignment="CENTER" prefWidth="550"
      style="-fx-padding: 40; -fx-background-color: linear-gradient(to bottom, #FFFFFF, #E8F5E9, #C8E6C9);"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.agrifund.view.FormulaireProduitController">

    <!-- HEADER -->
    <VBox alignment="CENTER" spacing="8"
          style="-fx-background-color: linear-gradient(to right, #4CAF50, #66BB6A, #4CAF50);
                 -fx-padding: 25 50; -fx-background-radius: 25;">
        <effect>
            <DropShadow color="#2E7D32" offsetY="5" radius="15"/>
        </effect>
        <Label fx:id="lblTitre" text="NOUVEAU PRODUIT"
               style="-fx-text-fill: white; -fx-font-size: 26; -fx-font-weight: bold;"/>
        <Label fx:id="lblSousTitre" text="Remplissez les informations ci-dessous"
               style="-fx-text-fill: #E8F5E9; -fx-font-size: 13;"/>
    </VBox>

    <!-- FORMULAIRE -->
    <VBox spacing="18"
          style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 20;
                 -fx-border-color: #81C784; -fx-border-width: 2; -fx-border-radius: 20;">
        <effect>
            <DropShadow color="#A5D6A7" offsetY="5" radius="12"/>
        </effect>

        <!-- Nom -->
        <VBox spacing="8">
            <Label text="NOM DU PRODUIT *" style="-fx-text-fill: #2E7D32; -fx-font-weight: bold; -fx-font-size: 12;"/>
            <TextField fx:id="txtNom" promptText="Ex: Pret Agricole Premium"
                       style="-fx-background-color: #F1F8E9; -fx-text-fill: #1B5E20;
                              -fx-border-color: #4CAF50; -fx-border-width: 2; -fx-border-radius: 12;
                              -fx-background-radius: 12; -fx-padding: 14; -fx-font-size: 14;"/>
        </VBox>

        <!-- Type -->
        <VBox spacing="8">
            <Label text="TYPE DE FINANCEMENT *" style="-fx-text-fill: #2E7D32; -fx-font-weight: bold; -fx-font-size: 12;"/>
            <ComboBox fx:id="cmbType" promptText="Selectionnez le type" maxWidth="Infinity"
                      style="-fx-background-color: #F1F8E9; -fx-border-color: #4CAF50;
                             -fx-border-width: 2; -fx-border-radius: 12; -fx-background-radius: 12;"/>
        </VBox>

        <!-- Taux -->
        <VBox spacing="8">
            <Label text="TAUX D INTERET (%) *" style="-fx-text-fill: #2E7D32; -fx-font-weight: bold; -fx-font-size: 12;"/>
            <TextField fx:id="txtTaux" promptText="Ex: 5.5"
                       style="-fx-background-color: #F1F8E9; -fx-text-fill: #1B5E20;
                              -fx-border-color: #66BB6A; -fx-border-width: 2; -fx-border-radius: 12;
                              -fx-background-radius: 12; -fx-padding: 14; -fx-font-size: 14;"/>
        </VBox>

        <!-- Montants -->
        <HBox spacing="20">
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="MONTANT MIN (DH) *" style="-fx-text-fill: #388E3C; -fx-font-weight: bold; -fx-font-size: 12;"/>
                <TextField fx:id="txtMontantMin" promptText="10000"
                           style="-fx-background-color: #F1F8E9; -fx-text-fill: #1B5E20;
                                  -fx-border-color: #81C784; -fx-border-width: 2; -fx-border-radius: 12;
                                  -fx-background-radius: 12; -fx-padding: 14;"/>
            </VBox>

            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="MONTANT MAX (DH) *" style="-fx-text-fill: #388E3C; -fx-font-weight: bold; -fx-font-size: 12;"/>
                <TextField fx:id="txtMontantMax" promptText="500000"
                           style="-fx-background-color: #F1F8E9; -fx-text-fill: #1B5E20;
                                  -fx-border-color: #81C784; -fx-border-width: 2; -fx-border-radius: 12;
                                  -fx-background-radius: 12; -fx-padding: 14;"/>
            </VBox>
        </HBox>

        <!-- Regles -->
        <VBox spacing="8">
            <Label text="REGLES FINANCIERES" style="-fx-text-fill: #388E3C; -fx-font-weight: bold; -fx-font-size: 12;"/>
            <TextArea fx:id="txtRegles" promptText="Decrivez les regles et conditions..."
                      prefRowCount="4" wrapText="true"
                      style="-fx-background-color: #F1F8E9; -fx-text-fill: #1B5E20;
                             -fx-border-color: #81C784; -fx-border-radius: 12;
                             -fx-background-radius: 12; -fx-border-width: 2;"/>
        </VBox>
    </VBox>

    <!-- BOUTONS -->
    <HBox spacing="20" alignment="CENTER">
        <Button fx:id="btnValider" text="ENREGISTRER" onAction="#handleValider" prefWidth="180" prefHeight="50"
                style="-fx-background-color: linear-gradient(to bottom, #4CAF50, #388E3C);
                       -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15;
                       -fx-background-radius: 25; -fx-cursor: hand;">
            <effect>
                <DropShadow color="#2E7D32" offsetY="5" radius="10"/>
            </effect>
        </Button>

        <Button text="ANNULER" onAction="#handleAnnuler" prefWidth="150" prefHeight="50"
                style="-fx-background-color: transparent; -fx-text-fill: #4CAF50;
                       -fx-font-weight: bold; -fx-font-size: 15;
                       -fx-border-color: #4CAF50; -fx-border-width: 2;
                       -fx-background-radius: 25; -fx-border-radius: 25; -fx-cursor: hand;">
        </Button>
    </HBox>

    <!-- Info -->
    <Label text="* Champs obligatoires" style="-fx-text-fill: #81C784; -fx-font-size: 11;"/>
</VBox>