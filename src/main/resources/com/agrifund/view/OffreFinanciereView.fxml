<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.*?>

<ScrollPane fitToWidth="true"
            style="-fx-background-color: linear-gradient(to bottom, #FFFFFF, #E8F5E9, #C8E6C9, #A5D6A7);"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.agrifund.view.OffreFinanciereViewController">

    <VBox spacing="30"
          style="-fx-padding: 40; -fx-background-color: linear-gradient(to bottom right, #FFFFFF, #E8F5E9, #C8E6C9, #A5D6A7, #81C784);">

        <!-- ==================== HEADER AVEC GLOW ==================== -->
        <HBox alignment="CENTER" spacing="20">
            <VBox alignment="CENTER" spacing="8"
                  style="-fx-background-color: linear-gradient(to right, #089647, #076A39, #089647);
                         -fx-padding: 30 100 30 100; -fx-background-radius: 50;">
                <effect>
                    <DropShadow color="#089647" offsetY="0" radius="40" spread="0.3"/>
                </effect>
                <Label text="OFFRES FINANCIERES"
                       style="-fx-text-fill: white; -fx-font-size: 34; -fx-font-weight: bold;"/>
                <Label text="Gestionnaire Intelligent des Opportunites Agricoles"
                       style="-fx-text-fill: #B2D944; -fx-font-size: 14; -fx-font-weight: bold;"/>
            </VBox>
        </HBox>

        <!-- ==================== STATS CARDS ==================== -->
        <HBox spacing="20" alignment="CENTER">
            <!-- Card 1 - Total -->
            <VBox alignment="CENTER" spacing="10" prefWidth="210"
                  style="-fx-background-color: linear-gradient(to bottom, #FFFFFF, #E8F5E9);
                         -fx-padding: 28; -fx-background-radius: 25;
                         -fx-border-color: #089647; -fx-border-width: 3; -fx-border-radius: 25;">
                <effect>
                    <DropShadow color="#089647" offsetY="5" radius="20" spread="0.1"/>
                </effect>
                <Label text="TOTAL" style="-fx-text-fill: #089647; -fx-font-size: 13; -fx-font-weight: bold;"/>
                <Label fx:id="lblTotalOffres" text="0"
                       style="-fx-text-fill: #133D03; -fx-font-size: 52; -fx-font-weight: bold;"/>
                <Label text="Offres Creees" style="-fx-text-fill: #476C1A; -fx-font-size: 11;"/>
            </VBox>

            <!-- Card 2 - Actives -->
            <VBox alignment="CENTER" spacing="10" prefWidth="210"
                  style="-fx-background-color: linear-gradient(to bottom, #E8F5E9, #C8E6C9);
                         -fx-padding: 28; -fx-background-radius: 25;
                         -fx-border-color: #4CAF50; -fx-border-width: 3; -fx-border-radius: 25;">
                <effect>
                    <DropShadow color="#4CAF50" offsetY="5" radius="20" spread="0.1"/>
                </effect>
                <Label text="ACTIVES" style="-fx-text-fill: #2E7D32; -fx-font-size: 13; -fx-font-weight: bold;"/>
                <Label fx:id="lblActives" text="0"
                       style="-fx-text-fill: #1B5E20; -fx-font-size: 52; -fx-font-weight: bold;"/>
                <Label text="En Cours" style="-fx-text-fill: #388E3C; -fx-font-size: 11;"/>
            </VBox>

            <!-- Card 3 - En Pause -->
            <VBox alignment="CENTER" spacing="10" prefWidth="210"
                  style="-fx-background-color: linear-gradient(to bottom, #FFFDE7, #FFF9C4);
                         -fx-padding: 28; -fx-background-radius: 25;
                         -fx-border-color: #E1B323; -fx-border-width: 3; -fx-border-radius: 25;">
                <effect>
                    <DropShadow color="#E1B323" offsetY="5" radius="20" spread="0.1"/>
                </effect>
                <Label text="EN PAUSE" style="-fx-text-fill: #F9A825; -fx-font-size: 13; -fx-font-weight: bold;"/>
                <Label fx:id="lblEnPause" text="0"
                       style="-fx-text-fill: #F57F17; -fx-font-size: 52; -fx-font-weight: bold;"/>
                <Label text="Suspendues" style="-fx-text-fill: #FBC02D; -fx-font-size: 11;"/>
            </VBox>

            <!-- Card 4 - Expirees -->
            <VBox alignment="CENTER" spacing="10" prefWidth="210"
                  style="-fx-background-color: linear-gradient(to bottom, #FFEBEE, #FFCDD2);
                         -fx-padding: 28; -fx-background-radius: 25;
                         -fx-border-color: #E57373; -fx-border-width: 3; -fx-border-radius: 25;">
                <effect>
                    <DropShadow color="#E57373" offsetY="5" radius="20" spread="0.1"/>
                </effect>
                <Label text="EXPIREES" style="-fx-text-fill: #D32F2F; -fx-font-size: 13; -fx-font-weight: bold;"/>
                <Label fx:id="lblExpirees" text="0"
                       style="-fx-text-fill: #C62828; -fx-font-size: 52; -fx-font-weight: bold;"/>
                <Label text="Terminees" style="-fx-text-fill: #E53935; -fx-font-size: 11;"/>
            </VBox>
        </HBox>

        <!-- ==================== BOUTONS D'ACTION PRINCIPAUX ==================== -->
        <HBox spacing="20" alignment="CENTER">
            <Button text="NOUVELLE OFFRE" onAction="#handleAjouter" prefWidth="190" prefHeight="60"
                    style="-fx-background-color: linear-gradient(to right, #089647, #076A39);
                           -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14;
                           -fx-background-radius: 30; -fx-cursor: hand;">
                <effect>
                    <DropShadow color="#089647" offsetY="8" radius="20"/>
                </effect>
            </Button>

            <Button text="MODIFIER OFFRE" onAction="#handleModifier" prefWidth="190" prefHeight="60"
                    style="-fx-background-color: linear-gradient(to right, #E1B323, #9A951F);
                           -fx-text-fill: #133D03; -fx-font-weight: bold; -fx-font-size: 14;
                           -fx-background-radius: 30; -fx-cursor: hand;">
                <effect>
                    <DropShadow color="#E1B323" offsetY="8" radius="20"/>
                </effect>
            </Button>

            <Button text="TELECHARGER PDF" onAction="#handleDownloadPDF" prefWidth="200" prefHeight="60"
                    style="-fx-background-color: linear-gradient(to right, #5C6BC0, #3F51B5);
                           -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14;
                           -fx-background-radius: 30; -fx-cursor: hand;">
                <effect>
                    <DropShadow color="#5C6BC0" offsetY="8" radius="20"/>
                </effect>
            </Button>

            <Button text="SUPPRIMER" onAction="#handleSupprimer" prefWidth="150" prefHeight="60"
                    style="-fx-background-color: linear-gradient(to right, #E53935, #C62828);
                           -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14;
                           -fx-background-radius: 30; -fx-cursor: hand;">
                <effect>
                    <DropShadow color="#E53935" offsetY="8" radius="20"/>
                </effect>
            </Button>
        </HBox>

        <!-- ==================== RECHERCHE ==================== -->
        <HBox spacing="18" alignment="CENTER"
              style="-fx-background-color: linear-gradient(to right, #FFFFFF, #E8F5E9, #FFFFFF);
                     -fx-padding: 22; -fx-background-radius: 35;
                     -fx-border-color: #089647; -fx-border-width: 2; -fx-border-radius: 35;">
            <effect>
                <DropShadow color="#089647" offsetY="5" radius="15" spread="0.05"/>
            </effect>

            <Label text="RECHERCHE" style="-fx-text-fill: #089647; -fx-font-size: 14; -fx-font-weight: bold;"/>

            <TextField fx:id="txtRecherche" promptText="Rechercher par nom, produit ou statut..." HBox.hgrow="ALWAYS"
                       style="-fx-background-color: #FFFFFF;
                              -fx-text-fill: #133D03; -fx-prompt-text-fill: #81C784;
                              -fx-background-radius: 22; -fx-padding: 15 25;
                              -fx-border-color: #4CAF50; -fx-border-radius: 22; -fx-border-width: 2;
                              -fx-font-size: 14;"/>

            <Button text="RECHERCHER" onAction="#handleRechercher" prefHeight="50"
                    style="-fx-background-color: linear-gradient(to right, #4CAF50, #388E3C);
                           -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13;
                           -fx-background-radius: 22; -fx-padding: 15 30; -fx-cursor: hand;">
                <effect>
                    <DropShadow color="#4CAF50" offsetY="4" radius="12"/>
                </effect>
            </Button>

            <Button text="ACTUALISER" onAction="#handleActualiser" prefHeight="50"
                    style="-fx-background-color: linear-gradient(to right, #089647, #076A39);
                           -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13;
                           -fx-background-radius: 22; -fx-padding: 15 30; -fx-cursor: hand;">
                <effect>
                    <DropShadow color="#089647" offsetY="4" radius="12"/>
                </effect>
            </Button>
        </HBox>

        <!-- ==================== TABLEAU ==================== -->
        <VBox spacing="18"
              style="-fx-background-color: linear-gradient(to bottom, #FFFFFF, #F1F8E9);
                     -fx-padding: 28; -fx-background-radius: 25;
                     -fx-border-color: #089647; -fx-border-width: 2; -fx-border-radius: 25;">
            <effect>
                <DropShadow color="#089647" offsetY="8" radius="20" spread="0.05"/>
            </effect>

            <HBox alignment="CENTER_LEFT" spacing="18">
                <VBox spacing="3">
                    <Label text="LISTE DES OFFRES"
                           style="-fx-text-fill: #133D03; -fx-font-size: 20; -fx-font-weight: bold;"/>
                    <Label text="Cliquez sur une offre pour la selectionner"
                           style="-fx-text-fill: #4CAF50; -fx-font-size: 12;"/>
                </VBox>
                <Separator HBox.hgrow="ALWAYS" style="-fx-background-color: #81C784;"/>
            </HBox>

            <TableView fx:id="tableOffres" prefHeight="450"
                       style="-fx-background-color: #FFFFFF;
                              -fx-border-color: #4CAF50; -fx-border-width: 2; -fx-border-radius: 15;">
                <effect>
                    <DropShadow color="#4CAF50" offsetY="3" radius="10" spread="0.03"/>
                </effect>
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="70" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colNom" text="NOM DE L OFFRE" prefWidth="280"/>
                    <TableColumn fx:id="colProduit" text="PRODUIT ASSOCIE" prefWidth="240"/>
                    <TableColumn fx:id="colConditions" text="CONDITIONS" prefWidth="300"/>
                    <TableColumn fx:id="colStatut" text="STATUT" prefWidth="140" style="-fx-alignment: CENTER;"/>
                </columns>
            </TableView>
        </VBox>

        <!-- ==================== BOUTON DETAILS ==================== -->
        <HBox alignment="CENTER">
            <Button text="VOIR LES DETAILS COMPLETS" onAction="#handleVoirDetails"
                    prefWidth="380" prefHeight="65"
                    style="-fx-background-color: linear-gradient(to right, #089647, #4CAF50, #089647);
                           -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 18;
                           -fx-background-radius: 35; -fx-cursor: hand;">
                <effect>
                    <DropShadow color="#089647" offsetY="10" radius="30" spread="0.2"/>
                </effect>
            </Button>
        </HBox>

        <!-- ==================== FOOTER ==================== -->
        <VBox alignment="CENTER" spacing="10"
              style="-fx-background-color: linear-gradient(to right, #E8F5E9, #C8E6C9, #E8F5E9);
                     -fx-padding: 25; -fx-background-radius: 20;
                     -fx-border-color: #81C784; -fx-border-width: 1; -fx-border-radius: 20;">
            <effect>
                <DropShadow color="#4CAF50" offsetY="3" radius="10" spread="0.03"/>
            </effect>
            <Label text="AgriFund - Plateforme de Financement Agricole"
                   style="-fx-text-fill: #2E7D32; -fx-font-size: 14; -fx-font-weight: bold;"/>
            <Label text="Edition 2025"
                   style="-fx-text-fill: #4CAF50; -fx-font-size: 12;"/>
        </VBox>

    </VBox>
</ScrollPane>