<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" 
            xmlns="http://javafx.com/javafx/17"
            fx:controller="com.agrifund.controller.AccueilUtilisateurController"
            style="-fx-background-color: #f5f5f5;">

    <!-- HEADER -->
    <top>
        <VBox spacing="0">
            <!-- Hero Section -->
            <HBox alignment="CENTER" style="-fx-background-color: linear-gradient(to right, #076A39, #089647, #0A9F51); -fx-padding: 40;">
                <VBox alignment="CENTER" spacing="15">
                    <Label text="Bienvenue sur AgriFund" style="-fx-text-fill: white; -fx-font-size: 32; -fx-font-weight: bold;"/>
                    <Label text="Votre partenaire en financement agricole" style="-fx-text-fill: #B2D944; -fx-font-size: 18;"/>
                    <HBox spacing="15" alignment="CENTER">
                        <Button fx:id="btnNouveauFinancement" text="Demander un Financement" 
                                style="-fx-background-color: #B2D944; -fx-text-fill: #076A39; -fx-font-size: 14; -fx-font-weight: bold; -fx-padding: 12 30; -fx-background-radius: 25; -fx-cursor: hand;"
                                onAction="#handleNouveauFinancement"/>
                    </HBox>
                </VBox>
            </HBox>
            
            <!-- Search and Filter Bar -->
            <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 20; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
                <Label text="Rechercher:" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #076A39;"/>
                <TextField fx:id="txtRecherche" promptText="Nom du produit, type de financement..." 
                          style="-fx-pref-width: 300; -fx-padding: 8; -fx-border-color: #B2D944; -fx-border-radius: 5; -fx-background-radius: 5;"/>
                
                <Label text="Type:" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #076A39;"/>
                <ComboBox fx:id="cmbTypeFinancement" promptText="Tous les types" 
                         style="-fx-pref-width: 200;"/>
                
                <Button text="🔍 Rechercher" 
                        style="-fx-background-color: #089647; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 5; -fx-cursor: hand;"
                        onAction="#handleRechercher"/>
                
                <Button text="🔄 Rafraîchir" 
                        style="-fx-background-color: #B2D944; -fx-text-fill: #076A39; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 5; -fx-cursor: hand;"
                        onAction="#handleRafraichir"/>
            </HBox>
        </VBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="20" style="-fx-padding: 30;">
            
            <!-- Section Produits Disponibles -->
            <VBox spacing="15">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="📦 Produits Financiers Disponibles" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #076A39;"/>
                    <Label fx:id="lblNombreProduits" text="(0 produits)" style="-fx-font-size: 14; -fx-text-fill: #666;"/>
                </HBox>
                
                <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-border-color: transparent;">
                    <VBox fx:id="containerProduits" spacing="15" style="-fx-padding: 10;"/>
                </ScrollPane>
            </VBox>
            
            <!-- Section Offres Spéciales -->
            <VBox spacing="15">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="🎁 Offres Spéciales" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #089647;"/>
                    <Label fx:id="lblNombreOffres" text="(0 offres)" style="-fx-font-size: 14; -fx-text-fill: #666;"/>
                </HBox>
                
                <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-border-color: transparent;">
                    <VBox fx:id="containerOffres" spacing="15" style="-fx-padding: 10;"/>
                </ScrollPane>
            </VBox>
            
        </VBox>
    </center>

    <!-- FOOTER -->
    <bottom>
        <HBox alignment="CENTER" spacing="30" style="-fx-background-color: #076A39; -fx-padding: 20;">
            <Label text="© 2026 AgriFund - Plateforme de Financement Agricole" style="-fx-text-fill: white; -fx-font-size: 12;"/>
            <Label text="📞 Contact: +212 5XX-XXXXXX" style="-fx-text-fill: #B2D944; -fx-font-size: 12;"/>

        </HBox>
    </bottom>

</BorderPane>
