<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.*?>

<ScrollPane fitToWidth="true"
            style="-fx-background-color: #095032;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.agrifund.view.DetailsProduitController">

    <VBox spacing="25" prefWidth="700"
          style="-fx-padding: 30; -fx-background-color: linear-gradient(to bottom, #095032, #133D03);">

        <!-- HEADER -->
        <VBox alignment="CENTER" spacing="10"
              style="-fx-background-color: linear-gradient(to right, #089647, #076A39);
                     -fx-padding: 25; -fx-background-radius: 15;">
            <effect>
                <DropShadow color="#060806" offsetY="5" radius="15"/>
            </effect>

            <Label text="📄 DÉTAILS DU PRODUIT FINANCIER"
                   style="-fx-text-fill: #FFFFFF; -fx-font-size: 26; -fx-font-weight: bold;"/>

            <Label fx:id="lblNomProduit" text="Nom du produit"
                   style="-fx-text-fill: #B2D944; -fx-font-size: 20; -fx-font-weight: bold;"/>
        </VBox>

        <!-- INFORMATIONS PRINCIPALES -->
        <VBox spacing="20" style="-fx-background-color: #FFFFFF; -fx-padding: 30; -fx-background-radius: 15;">
            <effect>
                <DropShadow color="#060806" offsetY="4" radius="12"/>
            </effect>

            <!-- ID et Type -->
            <HBox spacing="40">
                <VBox spacing="8" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #E8F5E9; -fx-padding: 15; -fx-background-radius: 10;">
                    <Label text="🆔 Identifiant"
                           style="-fx-text-fill: #476C1A; -fx-font-size: 13; -fx-font-weight: bold;"/>
                    <Label fx:id="lblId" text="0"
                           style="-fx-text-fill: #089647; -fx-font-size: 24; -fx-font-weight: bold;"/>
                </VBox>

                <VBox spacing="8" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #FFF3E0; -fx-padding: 15; -fx-background-radius: 10;">
                    <Label text="🏷️ Type de Financement"
                           style="-fx-text-fill: #9A951F; -fx-font-size: 13; -fx-font-weight: bold;"/>
                    <Label fx:id="lblType" text="Type"
                           style="-fx-text-fill: #E1B323; -fx-font-size: 20; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <Separator style="-fx-background-color: #B2D944; -fx-pref-height: 3;"/>

            <!-- TAUX D'INTÉRÊT -->
            <VBox spacing="10" alignment="CENTER"
                  style="-fx-background-color: linear-gradient(to right, #B2D944, #9A951F);
                         -fx-padding: 20; -fx-background-radius: 12;">
                <effect>
                    <DropShadow color="#060806" offsetY="3" radius="8"/>
                </effect>

                <Label text="💹 TAUX D'INTÉRÊT"
                       style="-fx-text-fill: #133D03; -fx-font-size: 14; -fx-font-weight: bold;"/>

                <Label fx:id="lblTaux" text="0.00"
                       style="-fx-text-fill: #060806; -fx-font-size: 42; -fx-font-weight: bold;"/>
            </VBox>

            <Separator style="-fx-background-color: #B2D944; -fx-pref-height: 3;"/>

            <!-- MONTANTS -->
            <HBox spacing="30">
                <VBox spacing="10" HBox.hgrow="ALWAYS" alignment="CENTER"
                      style="-fx-background-color: linear-gradient(to bottom, #089647, #076A39);
                             -fx-padding: 20; -fx-background-radius: 12;">
                    <effect>
                        <DropShadow color="#060806" offsetY="3" radius="8"/>
                    </effect>

                    <Label text="💰 Montant Minimum"
                           style="-fx-text-fill: #B2D944; -fx-font-size: 12; -fx-font-weight: bold;"/>

                    <Label fx:id="lblMontantMin" text="0.00 DH"
                           style="-fx-text-fill: #FFFFFF; -fx-font-size: 26; -fx-font-weight: bold;"/>
                </VBox>

                <VBox spacing="10" HBox.hgrow="ALWAYS" alignment="CENTER"
                      style="-fx-background-color: linear-gradient(to bottom, #E1B323, #9A951F);
                             -fx-padding: 20; -fx-background-radius: 12;">
                    <effect>
                        <DropShadow color="#060806" offsetY="3" radius="8"/>
                    </effect>

                    <Label text="💵 Montant Maximum"
                           style="-fx-text-fill: #133D03; -fx-font-size: 12; -fx-font-weight: bold;"/>

                    <Label fx:id="lblMontantMax" text="0.00 DH"
                           style="-fx-text-fill: #060806; -fx-font-size: 26; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <Separator style="-fx-background-color: #B2D944; -fx-pref-height: 3;"/>

            <!-- RÈGLES FINANCIÈRES -->
            <VBox spacing="10">
                <Label text="📜 Règles Financières"
                       style="-fx-text-fill: #076A39; -fx-font-size: 14; -fx-font-weight: bold;"/>

                <TextArea fx:id="txtRegles" wrapText="true" editable="false"
                          prefHeight="100"
                          style="-fx-background-color: #F5F5F5;
                                 -fx-border-color: #089647;
                                 -fx-border-width: 2;
                                 -fx-border-radius: 8;
                                 -fx-background-radius: 8;
                                 -fx-font-size: 13;
                                 -fx-text-fill: #060806;
                                 -fx-padding: 12;"/>
            </VBox>
        </VBox>

        <!-- STATISTIQUES -->
        <HBox spacing="20">
            <VBox spacing="10" HBox.hgrow="ALWAYS" alignment="CENTER"
                  style="-fx-background-color: linear-gradient(to bottom, #476C1A, #133D03);
                         -fx-padding: 20; -fx-background-radius: 12;">
                <effect>
                    <DropShadow color="#060806" offsetY="4" radius="10"/>
                </effect>

                <Label text="📊" style="-fx-font-size: 28;"/>

                <Label text="Montant Moyen"
                       style="-fx-text-fill: #B2D944; -fx-font-size: 12; -fx-font-weight: bold;"/>

                <Label fx:id="lblMontantMoyen" text="0 DH"
                       style="-fx-text-fill: #E1B323; -fx-font-size: 20; -fx-font-weight: bold;"/>
            </VBox>

            <VBox spacing="10" HBox.hgrow="ALWAYS" alignment="CENTER"
                  style="-fx-background-color: linear-gradient(to bottom, #089647, #095032);
                         -fx-padding: 20; -fx-background-radius: 12;">
                <effect>
                    <DropShadow color="#060806" offsetY="4" radius="10"/>
                </effect>

                <Label text="📈" style="-fx-font-size: 28;"/>

                <Label text="Écart"
                       style="-fx-text-fill: #B2D944; -fx-font-size: 12; -fx-font-weight: bold;"/>

                <Label fx:id="lblEcart" text="0 DH"
                       style="-fx-text-fill: #FFFFFF; -fx-font-size: 20; -fx-font-weight: bold;"/>
            </VBox>
        </HBox>

        <!-- BOUTONS -->
        <HBox spacing="20" alignment="CENTER">
            <padding>
                <Insets top="10"/>
            </padding>

            <Button text="📥 Télécharger PDF" onAction="#handleTelechargerProduit"
                    prefWidth="220" prefHeight="55"
                    style="-fx-background-color: linear-gradient(to bottom, #E1B323, #9A951F);
                           -fx-text-fill: #060806;
                           -fx-font-weight: bold;
                           -fx-font-size: 15;
                           -fx-background-radius: 28;
                           -fx-cursor: hand;">
                <effect>
                    <DropShadow color="#060806" offsetY="5" radius="12"/>
                </effect>
            </Button>

            <Button text="❌ Fermer" onAction="#handleFermer"
                    prefWidth="180" prefHeight="55"
                    style="-fx-background-color: linear-gradient(to bottom, #848A86, #476C1A);
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-font-size: 15;
                           -fx-background-radius: 28;
                           -fx-cursor: hand;">
                <effect>
                    <DropShadow color="#060806" offsetY="5" radius="12"/>
                </effect>
            </Button>
        </HBox>

        <!-- INFO BOX -->
        <VBox alignment="CENTER" spacing="10"
              style="-fx-background-color: linear-gradient(to right, #B2D944, #089647);
                     -fx-padding: 18; -fx-background-radius: 12;">
            <effect>
                <DropShadow color="#060806" offsetY="3" radius="8"/>
            </effect>

            <HBox spacing="10" alignment="CENTER">
                <Label text="💡" style="-fx-font-size: 20;"/>
                <Label text="Information"
                       style="-fx-text-fill: #060806; -fx-font-weight: bold; -fx-font-size: 15;"/>
            </HBox>

            <Label text="Le fichier PDF sera enregistré dans votre dossier Téléchargements"
                   style="-fx-text-fill: #133D03; -fx-font-size: 12; -fx-font-weight: bold;"
                   wrapText="true"/>
        </VBox>

    </VBox>
</ScrollPane>