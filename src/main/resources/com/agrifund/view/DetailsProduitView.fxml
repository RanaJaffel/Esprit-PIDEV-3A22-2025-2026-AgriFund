<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.*?>

<VBox spacing="0"
      style="-fx-background-color: #FFFFFF;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.agrifund.controller.DetailsProduitController">

    <!-- ========== CUSTOM TITLE BAR ========== -->
    <HBox fx:id="titleBar" alignment="CENTER_LEFT" spacing="10"
          style="-fx-background-color: linear-gradient(to right, #E8E8E8, #F5F5F5, #E8E8E8);
                 -fx-padding: 8 15; -fx-border-color: #CCCCCC; -fx-border-width: 0 0 1 0;"
          onMousePressed="#handleTitleBarPressed"
          onMouseDragged="#handleTitleBarDragged">

        <!-- App Icon and Title -->
        <Label text="🌿" style="-fx-font-size: 18;"/>
        <Label fx:id="lblWindowTitle" text="Details du Produit"
               style="-fx-text-fill: #333333; -fx-font-size: 14; -fx-font-weight: bold;"/>

        <Region HBox.hgrow="ALWAYS"/>

        <!-- Window Control Buttons -->
        <Button text="─" onAction="#handleMinimize"
                style="-fx-background-color: transparent; -fx-text-fill: #666666;
                       -fx-font-size: 12; -fx-font-weight: bold; -fx-padding: 5 12;
                       -fx-cursor: hand; -fx-background-radius: 3;"
                onMouseEntered="#onControlButtonHover" onMouseExited="#onControlButtonExit"/>

        <Button text="□" onAction="#handleMaximize"
                style="-fx-background-color: transparent; -fx-text-fill: #666666;
                       -fx-font-size: 12; -fx-font-weight: bold; -fx-padding: 5 12;
                       -fx-cursor: hand; -fx-background-radius: 3;"
                onMouseEntered="#onControlButtonHover" onMouseExited="#onControlButtonExit"/>

        <Button text="✕" onAction="#handleFermer"
                style="-fx-background-color: transparent; -fx-text-fill: #666666;
                       -fx-font-size: 12; -fx-font-weight: bold; -fx-padding: 5 12;
                       -fx-cursor: hand; -fx-background-radius: 3;"
                onMouseEntered="#onCloseButtonHover" onMouseExited="#onCloseButtonExit"/>
    </HBox>

    <!-- ========== MAIN CONTENT WITH SCROLL ========== -->
    <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent;">

        <VBox spacing="25"
              style="-fx-padding: 30; -fx-background-color: linear-gradient(to bottom, #FFFFFF, #E8F5E9, #C8E6C9);">

            <!-- HEADER -->
            <VBox alignment="CENTER" spacing="10"
                  style="-fx-background-color: linear-gradient(to right, #4CAF50, #388E3C, #4CAF50);
                         -fx-padding: 25; -fx-background-radius: 20;">
                <effect>
                    <DropShadow color="#2E7D32" offsetY="5" radius="15"/>
                </effect>

                <Label text="DETAILS DU PRODUIT FINANCIER"
                       style="-fx-text-fill: #FFFFFF; -fx-font-size: 24; -fx-font-weight: bold;"/>

                <Label fx:id="lblNomProduit" text="Nom du produit"
                       style="-fx-text-fill: #C8E6C9; -fx-font-size: 18; -fx-font-weight: bold;"/>
            </VBox>

            <!-- INFORMATIONS PRINCIPALES -->
            <VBox spacing="20" style="-fx-background-color: #FFFFFF; -fx-padding: 25; -fx-background-radius: 15;
                                      -fx-border-color: #4CAF50; -fx-border-width: 2; -fx-border-radius: 15;">
                <effect>
                    <DropShadow color="#81C784" offsetY="5" radius="12"/>
                </effect>

                <!-- ID et Type -->
                <HBox spacing="20">
                    <VBox spacing="8" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #E8F5E9; -fx-padding: 18; -fx-background-radius: 12;
                                 -fx-border-color: #81C784; -fx-border-width: 2; -fx-border-radius: 12;">
                        <Label text="🆔 Identifiant"
                               style="-fx-text-fill: #388E3C; -fx-font-size: 12; -fx-font-weight: bold;"/>
                        <Label fx:id="lblId" text="#0"
                               style="-fx-text-fill: #2E7D32; -fx-font-size: 26; -fx-font-weight: bold;"/>
                    </VBox>

                    <VBox spacing="8" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #FFFDE7; -fx-padding: 18; -fx-background-radius: 12;
                                 -fx-border-color: #FBC02D; -fx-border-width: 2; -fx-border-radius: 12;">
                        <Label text="🏷️ Type de Financement"
                               style="-fx-text-fill: #F9A825; -fx-font-size: 12; -fx-font-weight: bold;"/>
                        <Label fx:id="lblType" text="Type"
                               style="-fx-text-fill: #F57F17; -fx-font-size: 20; -fx-font-weight: bold;"/>
                    </VBox>
                </HBox>

                <Separator style="-fx-background-color: #81C784;"/>

                <!-- TAUX D'INTERET -->
                <VBox spacing="10" alignment="CENTER"
                      style="-fx-background-color: linear-gradient(to right, #4CAF50, #66BB6A, #4CAF50);
                             -fx-padding: 20; -fx-background-radius: 12;">
                    <effect>
                        <DropShadow color="#2E7D32" offsetY="4" radius="10"/>
                    </effect>

                    <Label text="💹 TAUX D'INTERET"
                           style="-fx-text-fill: #E8F5E9; -fx-font-size: 13; -fx-font-weight: bold;"/>

                    <Label fx:id="lblTaux" text="0.00 %"
                           style="-fx-text-fill: white; -fx-font-size: 42; -fx-font-weight: bold;"/>
                </VBox>

                <Separator style="-fx-background-color: #81C784;"/>

                <!-- MONTANTS -->
                <HBox spacing="20">
                    <VBox spacing="10" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color: linear-gradient(to bottom, #E8F5E9, #C8E6C9);
                                 -fx-padding: 20; -fx-background-radius: 12;
                                 -fx-border-color: #4CAF50; -fx-border-width: 2; -fx-border-radius: 12;">
                        <effect>
                            <DropShadow color="#81C784" offsetY="3" radius="8"/>
                        </effect>

                        <Label text="💰 Montant Minimum"
                               style="-fx-text-fill: #388E3C; -fx-font-size: 12; -fx-font-weight: bold;"/>

                        <Label fx:id="lblMontantMin" text="0.00 DH"
                               style="-fx-text-fill: #1B5E20; -fx-font-size: 22; -fx-font-weight: bold;"/>
                    </VBox>

                    <VBox spacing="10" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color: linear-gradient(to bottom, #FFFDE7, #FFF9C4);
                                 -fx-padding: 20; -fx-background-radius: 12;
                                 -fx-border-color: #FBC02D; -fx-border-width: 2; -fx-border-radius: 12;">
                        <effect>
                            <DropShadow color="#F9A825" offsetY="3" radius="8"/>
                        </effect>

                        <Label text="💵 Montant Maximum"
                               style="-fx-text-fill: #F9A825; -fx-font-size: 12; -fx-font-weight: bold;"/>

                        <Label fx:id="lblMontantMax" text="0.00 DH"
                               style="-fx-text-fill: #F57F17; -fx-font-size: 22; -fx-font-weight: bold;"/>
                    </VBox>
                </HBox>

                <Separator style="-fx-background-color: #81C784;"/>

                <!-- REGLES FINANCIERES -->
                <VBox spacing="10">
                    <Label text="📜 Regles Financieres"
                           style="-fx-text-fill: #2E7D32; -fx-font-size: 13; -fx-font-weight: bold;"/>

                    <TextArea fx:id="txtRegles" wrapText="true" editable="false"
                              prefHeight="80"
                              style="-fx-background-color: #F1F8E9;
                                     -fx-border-color: #4CAF50;
                                     -fx-border-width: 2;
                                     -fx-border-radius: 10;
                                     -fx-background-radius: 10;
                                     -fx-font-size: 13;
                                     -fx-text-fill: #1B5E20;
                                     -fx-padding: 10;"/>
                </VBox>
            </VBox>

            <!-- STATISTIQUES -->
            <HBox spacing="20">
                <VBox spacing="10" HBox.hgrow="ALWAYS" alignment="CENTER"
                      style="-fx-background-color: linear-gradient(to bottom, #FFFFFF, #E8F5E9);
                             -fx-padding: 20; -fx-background-radius: 12;
                             -fx-border-color: #4CAF50; -fx-border-width: 2; -fx-border-radius: 12;">
                    <effect>
                        <DropShadow color="#81C784" offsetY="4" radius="10"/>
                    </effect>

                    <Label text="📊" style="-fx-font-size: 28;"/>

                    <Label text="Montant Moyen"
                           style="-fx-text-fill: #388E3C; -fx-font-size: 12; -fx-font-weight: bold;"/>

                    <Label fx:id="lblMontantMoyen" text="0 DH"
                           style="-fx-text-fill: #2E7D32; -fx-font-size: 20; -fx-font-weight: bold;"/>
                </VBox>

                <VBox spacing="10" HBox.hgrow="ALWAYS" alignment="CENTER"
                      style="-fx-background-color: linear-gradient(to bottom, #E8F5E9, #C8E6C9);
                             -fx-padding: 20; -fx-background-radius: 12;
                             -fx-border-color: #66BB6A; -fx-border-width: 2; -fx-border-radius: 12;">
                    <effect>
                        <DropShadow color="#81C784" offsetY="4" radius="10"/>
                    </effect>

                    <Label text="📈" style="-fx-font-size: 28;"/>

                    <Label text="Ecart Min-Max"
                           style="-fx-text-fill: #388E3C; -fx-font-size: 12; -fx-font-weight: bold;"/>

                    <Label fx:id="lblEcart" text="0 DH"
                           style="-fx-text-fill: #1B5E20; -fx-font-size: 20; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <!-- BOUTONS (SAME STYLE AS OFFRE) -->
            <HBox spacing="20" alignment="CENTER">
                <Button text="TELECHARGER PDF" onAction="#handleTelechargerProduit"
                        prefWidth="200" prefHeight="50"
                        style="-fx-background-color: linear-gradient(to right, #7E57C2, #5E35B1);
                               -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14;
                               -fx-background-radius: 25; -fx-cursor: hand;">
                    <effect>
                        <DropShadow color="#4527A0" offsetY="5" radius="12"/>
                    </effect>
                </Button>

                <Button text="FERMER" onAction="#handleFermer"
                        prefWidth="150" prefHeight="50"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #4CAF50; -fx-font-weight: bold; -fx-font-size: 14;
                               -fx-border-color: #4CAF50; -fx-border-width: 2;
                               -fx-background-radius: 25; -fx-border-radius: 25; -fx-cursor: hand;">
                </Button>
            </HBox>

            <!-- INFO BOX -->
            <VBox alignment="CENTER" spacing="8"
                  style="-fx-background-color: linear-gradient(to right, #E8F5E9, #C8E6C9, #E8F5E9);
                         -fx-padding: 15; -fx-background-radius: 12;
                         -fx-border-color: #81C784; -fx-border-width: 1; -fx-border-radius: 12;">
                <effect>
                    <DropShadow color="#81C784" offsetY="3" radius="6"/>
                </effect>

                <HBox spacing="8" alignment="CENTER">
                    <Label text="💡" style="-fx-font-size: 18;"/>
                    <Label text="Information"
                           style="-fx-text-fill: #2E7D32; -fx-font-weight: bold; -fx-font-size: 14;"/>
                </HBox>

                <Label text="Le fichier PDF sera enregistre dans votre dossier Telechargements"
                       style="-fx-text-fill: #388E3C; -fx-font-size: 11; -fx-font-weight: bold;"
                       wrapText="true"/>
            </VBox>

        </VBox>
    </ScrollPane>
</VBox>