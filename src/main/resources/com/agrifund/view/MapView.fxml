<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.*?>

<HBox xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/17"
      fx:controller="com.agrifund.controller.MapController"
      stylesheets="@../css/styles.css"
      style="-fx-background-color: #f8faf8;">

    <!-- SIDEBAR - Prend toute la hauteur -->
    <fx:include source="/com/agrifund/fxml/admin/admin-sidebar.fxml"/>

    <!-- MAIN CONTENT -->
    <VBox HBox.hgrow="ALWAYS" spacing="0" style="-fx-background-color: #f8faf8;">

        <!-- ========== HEADER ========== -->
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-background-color: linear-gradient(to right, #089647, #076A39, #095032); -fx-padding: 18 25;">
            <effect>
                <DropShadow color="rgba(8, 150, 71, 0.3)" offsetY="3" radius="10"/>
            </effect>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="🗺️" style="-fx-font-size: 32px;"/>
                <VBox spacing="3">
                    <Label text="Carte AgriFund"
                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;">
                        <effect>
                            <DropShadow color="rgba(0,0,0,0.2)" offsetY="1" radius="3"/>
                        </effect>
                    </Label>
                    <Label text="Propulsé par Google Maps — Visualisation géographique"
                           style="-fx-text-fill: #B2D944; -fx-font-size: 12px;"/>
                </VBox>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Search Bar -->
            <VBox spacing="0">
                <HBox spacing="10" alignment="CENTER_LEFT"
                      style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 25; -fx-padding: 8 18;">
                    <Label text="🔍" style="-fx-font-size: 16px;"/>
                    <TextField fx:id="txtSearchAddress" promptText="Rechercher une adresse via Google Maps..."
                               prefWidth="380"
                               style="-fx-background-color: transparent; -fx-border-width: 0; -fx-text-fill: white;
                                      -fx-prompt-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px;"
                               onAction="#handleSearchAddress"/>
                    <Button text="Rechercher" onAction="#handleSearchAddress"
                            style="-fx-background-color: #B2D944; -fx-text-fill: #133D03; -fx-font-weight: bold;
                                   -fx-padding: 8 20; -fx-background-radius: 20; -fx-cursor: hand;">
                        <effect>
                            <DropShadow color="rgba(178, 217, 68, 0.4)" offsetY="2" radius="5"/>
                        </effect>
                    </Button>
                </HBox>
                <ListView fx:id="listSuggestions" prefHeight="0" maxHeight="180" visible="false" managed="false"
                          style="-fx-background-color: white; -fx-border-color: #089647; -fx-border-radius: 0 0 8 8;
                                 -fx-pref-width: 450; -fx-font-size: 12;"/>
            </VBox>
        </HBox>

        <!-- ========== CENTER: MAP + CUSTOMIZATION PANEL ========== -->
        <HBox HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">

            <!-- MAP Container -->
            <StackPane fx:id="mapContainer" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS"
                       maxWidth="1.7976931348623157E308" maxHeight="1.7976931348623157E308"
                       style="-fx-background-color: #e8f5e9;">
                <!-- GoogleMapView is added programmatically -->
            </StackPane>

            <!-- CUSTOMIZATION SIDEBAR -->
            <ScrollPane fitToWidth="true" prefWidth="280" minWidth="280"
                        style="-fx-background: linear-gradient(to bottom, #095032, #076A39);
                               -fx-background-color: linear-gradient(to bottom, #095032, #076A39);
                               -fx-border-width: 0;">
                <VBox spacing="15" style="-fx-background-color: transparent; -fx-padding: 20 15;">

                    <!-- Section: Couche de carte -->
                    <VBox spacing="10">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="🗺️" style="-fx-font-size: 18px;"/>
                            <Label text="Google Maps - Couches"
                                   style="-fx-text-fill: #B2D944; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                        </HBox>

                        <fx:define>
                            <ToggleGroup fx:id="tileGroup"/>
                        </fx:define>

                        <VBox spacing="8" style="-fx-background-color: rgba(255,255,255,0.1);
                                                 -fx-background-radius: 12; -fx-padding: 12;">
                            <RadioButton fx:id="rbOSM" text="Google Maps (Plan)" toggleGroup="$tileGroup" selected="true"
                                         style="-fx-text-fill: white; -fx-font-size: 12px;" onAction="#handleTileChange"/>
                            <RadioButton fx:id="rbSatellite" text="Google Satellite" toggleGroup="$tileGroup"
                                         style="-fx-text-fill: white; -fx-font-size: 12px;" onAction="#handleTileChange"/>
                            <RadioButton fx:id="rbTerrain" text="Google Relief" toggleGroup="$tileGroup"
                                         style="-fx-text-fill: white; -fx-font-size: 12px;" onAction="#handleTileChange"/>
                            <RadioButton fx:id="rbDark" text="Google Hybride" toggleGroup="$tileGroup"
                                         style="-fx-text-fill: white; -fx-font-size: 12px;" onAction="#handleTileChange"/>
                        </VBox>
                    </VBox>

                    <Separator style="-fx-background-color: rgba(178, 217, 68, 0.3);"/>

                    <!-- Section: Marqueurs -->
                    <VBox spacing="10">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="📍" style="-fx-font-size: 18px;"/>
                            <Label text="Marqueurs"
                                   style="-fx-text-fill: #B2D944; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                        </HBox>

                        <VBox spacing="8" style="-fx-background-color: rgba(255,255,255,0.1);
                                                 -fx-background-radius: 12; -fx-padding: 12;">
                            <CheckBox fx:id="cbShowFarms" text="🌾 Exploitations agricoles" selected="false"
                                      style="-fx-text-fill: white; -fx-font-size: 12px;" onAction="#handleMarkerToggle"/>
                            <CheckBox fx:id="cbShowOffices" text="🏢 Bureaux AgriFund" selected="false"
                                      style="-fx-text-fill: white; -fx-font-size: 12px;" onAction="#handleMarkerToggle"/>
                            <CheckBox fx:id="cbShowCustom" text="📌 Mes marqueurs personnalisés" selected="true"
                                      style="-fx-text-fill: white; -fx-font-size: 12px;" onAction="#handleMarkerToggle"/>
                        </VBox>
                    </VBox>

                    <Separator style="-fx-background-color: rgba(178, 217, 68, 0.3);"/>

                    <!-- Section: Ajouter un marqueur -->
                    <VBox spacing="10">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="➕" style="-fx-font-size: 18px;"/>
                            <Label text="Ajouter un marqueur"
                                   style="-fx-text-fill: #B2D944; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                        </HBox>

                        <VBox spacing="8" style="-fx-background-color: rgba(255,255,255,0.1);
                                                 -fx-background-radius: 12; -fx-padding: 12;">
                            <TextField fx:id="txtMarkerTitle" promptText="Titre du marqueur"
                                       style="-fx-font-size: 12px; -fx-background-radius: 8; -fx-padding: 10;
                                              -fx-background-color: rgba(255,255,255,0.9);"/>
                            <TextField fx:id="txtMarkerDesc" promptText="Description"
                                       style="-fx-font-size: 12px; -fx-background-radius: 8; -fx-padding: 10;
                                              -fx-background-color: rgba(255,255,255,0.9);"/>
                            <HBox spacing="8">
                                <TextField fx:id="txtMarkerLat" promptText="Latitude" HBox.hgrow="ALWAYS"
                                           style="-fx-font-size: 11px; -fx-background-radius: 8; -fx-padding: 10;
                                                  -fx-background-color: rgba(255,255,255,0.9);"/>
                                <TextField fx:id="txtMarkerLng" promptText="Longitude" HBox.hgrow="ALWAYS"
                                           style="-fx-font-size: 11px; -fx-background-radius: 8; -fx-padding: 10;
                                                  -fx-background-color: rgba(255,255,255,0.9);"/>
                            </HBox>
                            <ComboBox fx:id="cbMarkerColor" promptText="Couleur du marqueur"
                                      prefWidth="1000" maxWidth="1.7976931348623157E308"
                                      style="-fx-font-size: 12px; -fx-background-radius: 8;"/>

                            <Button text="📌 Ajouter marqueur" prefWidth="1000" maxWidth="1.7976931348623157E308"
                                    style="-fx-background-color: #B2D944; -fx-text-fill: #133D03; -fx-font-weight: bold;
                                           -fx-font-size: 12px; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 10;">
                                <effect>
                                    <DropShadow color="rgba(178, 217, 68, 0.4)" offsetY="2" radius="5"/>
                                </effect>
                            </Button>

                            <Button fx:id="btnClickMode" text="🖱️ Mode clic sur carte"
                                    prefWidth="1000" maxWidth="1.7976931348623157E308"
                                    onAction="#handleToggleClickMode"
                                    style="-fx-background-color: transparent; -fx-text-fill: #B2D944;
                                           -fx-font-size: 12px; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 10;
                                           -fx-border-color: #B2D944; -fx-border-radius: 10; -fx-border-width: 1;"/>
                        </VBox>
                    </VBox>

                    <Separator style="-fx-background-color: rgba(178, 217, 68, 0.3);"/>

                    <!-- Section: Cercle de zone -->
                    <VBox spacing="10">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="⭕" style="-fx-font-size: 18px;"/>
                            <Label text="Zone circulaire"
                                   style="-fx-text-fill: #B2D944; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                        </HBox>

                        <VBox spacing="8" style="-fx-background-color: rgba(255,255,255,0.1);
                                                 -fx-background-radius: 12; -fx-padding: 12;">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="Rayon:" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
                                <Slider fx:id="sliderRadius" min="1" max="100" value="20" showTickLabels="true"
                                        HBox.hgrow="ALWAYS"/>
                            </HBox>
                            <Label fx:id="lblRadiusValue" text="20 km"
                                   style="-fx-text-fill: #B2D944; -fx-font-size: 13px; -fx-font-weight: bold;"/>

                            <ComboBox fx:id="cbCircleColor" promptText="Couleur du cercle"
                                      prefWidth="1000" maxWidth="1.7976931348623157E308"
                                      style="-fx-font-size: 12px; -fx-background-radius: 8;"/>

                            <Button text="⭕ Tracer autour position" prefWidth="1000" maxWidth="1.7976931348623157E308"
                                    onAction="#handleDrawCircle"
                                    style="-fx-background-color: transparent; -fx-text-fill: #B2D944;
                                           -fx-font-size: 12px; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 10;
                                           -fx-border-color: #B2D944; -fx-border-radius: 10; -fx-border-width: 1;"/>
                        </VBox>
                    </VBox>

                    <Separator style="-fx-background-color: rgba(178, 217, 68, 0.3);"/>

                    <!-- Section: Affichage -->
                    <VBox spacing="10">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="⚙️" style="-fx-font-size: 18px;"/>
                            <Label text="Paramètres d'affichage"
                                   style="-fx-text-fill: #B2D944; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                        </HBox>

                        <VBox spacing="10" style="-fx-background-color: rgba(255,255,255,0.1);
                                                  -fx-background-radius: 12; -fx-padding: 12;">
                            <VBox spacing="5">
                                <Label text="Niveau de zoom:" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
                                <Slider fx:id="sliderZoom" min="3" max="18" value="7" showTickLabels="true"/>
                            </VBox>
                            <VBox spacing="5">
                                <Label text="Opacité de la carte:" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
                                <Slider fx:id="sliderOpacity" min="0.3" max="1.0" value="1.0"/>
                            </VBox>
                        </VBox>
                    </VBox>

                    <Separator style="-fx-background-color: rgba(178, 217, 68, 0.3);"/>

                    <!-- Actions -->
                    <VBox spacing="10">
                        <Button text="🗑️ Effacer tous les marqueurs" prefWidth="1000" maxWidth="1.7976931348623157E308"
                                onAction="#handleClearAll"
                                style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold;
                                       -fx-font-size: 12px; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 12;">
                            <effect>
                                <DropShadow color="rgba(220, 53, 69, 0.4)" offsetY="2" radius="5"/>
                            </effect>
                        </Button>

                        <Button text="🔄 Recentrer sur la Tunisie" prefWidth="1000" maxWidth="1.7976931348623157E308"
                                onAction="#handleRecenter"
                                style="-fx-background-color: #089647; -fx-text-fill: white; -fx-font-weight: bold;
                                       -fx-font-size: 12px; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 12;">
                            <effect>
                                <DropShadow color="rgba(8, 150, 71, 0.4)" offsetY="2" radius="5"/>
                            </effect>
                        </Button>
                    </VBox>

                </VBox>
            </ScrollPane>
        </HBox>

        <!-- ========== FOOTER STATUS BAR ========== -->
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-background-color: linear-gradient(to right, #095032, #076A39, #095032); -fx-padding: 12 25;">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="●" style="-fx-text-fill: #B2D944; -fx-font-size: 10px;"/>
                <Label fx:id="lblMapStatus" text="Carte prête"
                       style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox spacing="20" alignment="CENTER_RIGHT">
                <Label fx:id="lblCoordinates" text="Coordonnées: --"
                       style="-fx-text-fill: #B2D944; -fx-font-size: 11px;"/>
                <Separator orientation="VERTICAL" style="-fx-background-color: rgba(255,255,255,0.3);"/>
                <Label text="🗺️ AgriFund Maps"
                       style="-fx-text-fill: #B2D944; -fx-font-size: 11px; -fx-font-weight: bold;"/>
            </HBox>
        </HBox>
    </VBox>
</HBox>
