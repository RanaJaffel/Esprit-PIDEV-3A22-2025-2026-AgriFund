<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/17"
            fx:controller="com.agrifund.controller.ChatbotController"
            style="-fx-background-color: #095032;">

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15"
              style="-fx-background-color: linear-gradient(to right, #076A39, #089647); -fx-padding: 15 20;">
            <VBox spacing="3">
                <Label text="🤖 Assistant AgriFund" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;"/>
                <Label fx:id="lblStatus" text="En ligne - Propulse par Gemini AI" style="-fx-text-fill: #B2D944; -fx-font-size: 12;"/>
            </VBox>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnClearChat" text="🗑️ Effacer"
                    style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-size: 12; -fx-background-radius: 15; -fx-padding: 6 15; -fx-cursor: hand;"
                    onAction="#handleClearChat"/>
        </HBox>
    </top>

    <!-- CHAT AREA -->
    <center>
        <VBox spacing="0" VBox.vgrow="ALWAYS">
            <!-- Quick Suggestion Chips -->
            <HBox fx:id="suggestionsBox" alignment="CENTER" spacing="8"
                  style="-fx-background-color: #0a5d3a; -fx-padding: 10 15;">
                <Button text="💰 Produits financiers"
                        style="-fx-background-color: rgba(178,217,68,0.2); -fx-text-fill: #B2D944; -fx-font-size: 11; -fx-background-radius: 15; -fx-padding: 5 12; -fx-cursor: hand; -fx-border-color: #B2D944; -fx-border-radius: 15;"
                        onAction="#handleSuggestionProduits"/>
                <Button text="📊 Offres disponibles"
                        style="-fx-background-color: rgba(178,217,68,0.2); -fx-text-fill: #B2D944; -fx-font-size: 11; -fx-background-radius: 15; -fx-padding: 5 12; -fx-cursor: hand; -fx-border-color: #B2D944; -fx-border-radius: 15;"
                        onAction="#handleSuggestionOffres"/>
                <Button text="🚜 Conseils agricoles"
                        style="-fx-background-color: rgba(178,217,68,0.2); -fx-text-fill: #B2D944; -fx-font-size: 11; -fx-background-radius: 15; -fx-padding: 5 12; -fx-cursor: hand; -fx-border-color: #B2D944; -fx-border-radius: 15;"
                        onAction="#handleSuggestionConseils"/>
                <Button text="🗺️ Bureaux AgriFund"
                        style="-fx-background-color: rgba(178,217,68,0.2); -fx-text-fill: #B2D944; -fx-font-size: 11; -fx-background-radius: 15; -fx-padding: 5 12; -fx-cursor: hand; -fx-border-color: #B2D944; -fx-border-radius: 15;"
                        onAction="#handleSuggestionBureaux"/>
            </HBox>

            <!-- Messages ScrollPane -->
            <ScrollPane fx:id="scrollPane" fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background: #095032; -fx-background-color: #095032; -fx-border-color: transparent;">
                <VBox fx:id="chatContainer" spacing="10"
                      style="-fx-background-color: #095032; -fx-padding: 15;">
                    <!-- Messages will be added dynamically -->
                </VBox>
            </ScrollPane>
        </VBox>
    </center>

    <!-- INPUT AREA -->
    <bottom>
        <VBox spacing="0">
            <!-- Typing indicator -->
            <HBox fx:id="typingIndicator" alignment="CENTER_LEFT" spacing="8" visible="false" managed="false"
                  style="-fx-padding: 5 20; -fx-background-color: #0a5d3a;">
                <Label text="🤖 L'assistant ecrit..." style="-fx-text-fill: #B2D944; -fx-font-size: 11; -fx-font-style: italic;"/>
            </HBox>

            <HBox alignment="CENTER" spacing="10"
                  style="-fx-background-color: linear-gradient(to right, #076A39, #089647); -fx-padding: 12 20;">
                <TextField fx:id="txtMessage" promptText="Posez votre question sur le financement agricole..."
                           HBox.hgrow="ALWAYS"
                           style="-fx-pref-height: 40; -fx-padding: 10 15; -fx-background-radius: 20; -fx-border-radius: 20; -fx-font-size: 13; -fx-background-color: white; -fx-border-color: #B2D944;"
                           onAction="#handleSendMessage"/>
                <Button fx:id="btnSend" text="Envoyer ➤"
                        style="-fx-background-color: #B2D944; -fx-text-fill: #076A39; -fx-font-weight: bold; -fx-font-size: 13; -fx-padding: 10 25; -fx-background-radius: 20; -fx-cursor: hand;"
                        onAction="#handleSendMessage"/>
            </HBox>

            <!-- Footer -->
            <HBox alignment="CENTER"
                  style="-fx-background-color: #064d2e; -fx-padding: 5 15;">
                <Label text="Limite au contexte AgriFund - Financement Agricole en Tunisie"
                       style="-fx-text-fill: #6a9a7a; -fx-font-size: 10;"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
