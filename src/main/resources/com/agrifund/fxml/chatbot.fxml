<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.agrifund.controller.ChatController"
      styleClass="chat-root"
      stylesheets="@chatbot.css"
      prefWidth="370"
      prefHeight="500"
      spacing="0">

    <HBox styleClass="chat-header" alignment="CENTER_LEFT" spacing="10">
        <padding><Insets top="13" right="14" bottom="13" left="14"/></padding>
        <Label text="🌿" style="-fx-font-size: 20px;"/>
        <VBox spacing="1">
            <Label text="Assistant Agricole" styleClass="chat-header-title"/>
            <Label fx:id="lblStatusChat" text="● En ligne" styleClass="chat-header-status"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnCloseChat" text="✕" styleClass="chat-close-btn"/>
    </HBox>

    <ScrollPane fx:id="scrollPane"
                VBox.vgrow="ALWAYS"
                fitToWidth="true"
                hbarPolicy="NEVER"
                styleClass="chat-scroll">

        <VBox fx:id="messagesContainer" spacing="10" styleClass="messages-container">
            <padding><Insets top="14" right="12" bottom="14" left="12"/></padding>
        </VBox>

    </ScrollPane>

    <HBox styleClass="chat-input-area" alignment="CENTER" spacing="8">
        <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>

        <TextField fx:id="tfChatMessage"
                   promptText="Posez votre question..."
                   styleClass="chat-input"
                   HBox.hgrow="ALWAYS"/>

        <Button fx:id="btnChatSend"
                text="➤"
                styleClass="chat-send-btn"/>
    </HBox>

</VBox>
