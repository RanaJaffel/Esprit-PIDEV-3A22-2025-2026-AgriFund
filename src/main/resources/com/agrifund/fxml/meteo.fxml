<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.agrifund.controller.MeteoController"
            prefWidth="1450"
            prefHeight="800"
            stylesheets="@stylerane.css">

    <!-- ========== SIDEBAR GAUCHE ========== -->
    <left>
        <fx:include source="/com/agrifund/fxml/admin/admin-sidebar.fxml"/>
    </left>

    <!-- ========== CONTENU PRINCIPAL ========== -->
    <center>
        <VBox spacing="0">

            <!-- Header -->
            <VBox alignment="CENTER" spacing="5" styleClass="weather-header">
                <Label fx:id="lblVille" styleClass="weather-city"/>
                <Label fx:id="lblDate" styleClass="weather-date"/>
            </VBox>

            <!-- Main -->
            <VBox alignment="CENTER" spacing="15" styleClass="weather-main" VBox.vgrow="ALWAYS">

                <ImageView fx:id="imgIcon"
                           fitHeight="140"
                           fitWidth="140"/>

                <Label fx:id="lblTemp"
                       styleClass="weather-temp"/>

                <Label fx:id="lblDescription"
                       styleClass="weather-description"/>

            </VBox>

            <!-- Details -->
            <HBox alignment="CENTER"
                  spacing="30"
                  styleClass="weather-details">

                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <VBox alignment="CENTER" styleClass="weather-card">
                    <Label text="🌡 Ressenti"/>
                    <Label fx:id="lblRessenti" styleClass="weather-value"/>
                </VBox>

                <VBox alignment="CENTER" styleClass="weather-card">
                    <Label text="💧 Humidité"/>
                    <Label fx:id="lblHumidite" styleClass="weather-value"/>
                </VBox>

                <VBox alignment="CENTER" styleClass="weather-card">
                    <Label text="🌬 Vent"/>
                    <Label fx:id="lblVent" styleClass="weather-value"/>
                </VBox>

            </HBox>

        </VBox>
    </center>

</BorderPane>
