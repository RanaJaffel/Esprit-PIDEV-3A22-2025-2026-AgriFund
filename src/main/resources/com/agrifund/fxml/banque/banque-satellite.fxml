<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.agrifund.controller.banque.BanqueSatelliteController"
            stylesheets="@../../css/styles.css">
    <left>
        <fx:include source="banque-sidebar.fxml"/>
    </left>
    <center>
        <VBox styleClass="content-area" spacing="0">

            <!-- Header -->
            <HBox alignment="CENTER" style="-fx-padding: 0 0 20 0;">
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="🛰️ Analyse Satellitaire" styleClass="page-title"/>
                    <Label text="Cliquez sur la carte pour sélectionner une position" styleClass="page-subtitle"/>
                </VBox>
                <HBox spacing="10">
                    <Button text="🔄" styleClass="btn, btn-secondary" onAction="#refreshHistory"/>
                    <Button fx:id="exportButton" text="📄 Export PDF" styleClass="btn, btn-accent" onAction="#exportReport"/>
                    <Button text="← Retour" styleClass="btn, btn-primary" onAction="#goToDashboard"/>
                </HBox>
            </HBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                <VBox spacing="20">

                    <!-- Carte et paramètres -->
                    <HBox spacing="20">

                        <!-- Carte interactive -->
                        <VBox styleClass="card" spacing="15" prefWidth="550">
                            <Label text="🗺️ Carte Interactive" styleClass="card-header"/>

                            <!-- Barre de recherche -->
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <TextField fx:id="searchField" promptText="Rechercher une adresse..."
                                           HBox.hgrow="ALWAYS" onAction="#searchAddress"/>
                                <Button text="🔍" styleClass="btn, btn-primary" onAction="#searchAddress"/>
                            </HBox>

                            <!-- Carte -->
                            <StackPane fx:id="mapContainer" prefHeight="400"
                                       style="-fx-background-color: #e8f5e9; -fx-background-radius: 10;">
                            </StackPane>

                            <!-- Infos sélection -->
                            <VBox spacing="5" style="-fx-padding: 12; -fx-background-color: #f8f9fa; -fx-background-radius: 8;">
                                <Label fx:id="selectedLocationLabel" text="📍 Cliquez sur la carte"
                                       style="-fx-font-size: 14px; -fx-font-weight: bold;" wrapText="true"/>
                                <Label fx:id="coordinatesLabel" text="Lat: -- | Lon: --"
                                       style="-fx-text-fill: #6c757d; -fx-font-family: monospace;"/>
                            </VBox>
                        </VBox>

                        <!-- Paramètres -->
                        <VBox styleClass="card" spacing="20" HBox.hgrow="ALWAYS">
                            <Label text="⚙️ Paramètres" styleClass="card-header"/>

                            <VBox spacing="15">
                                <!-- UN SEUL CHAMP DATE -->
                                <VBox spacing="5">
                                    <Label text="📅 Date d'analyse" style="-fx-font-weight: bold;"/>
                                    <DatePicker fx:id="analysisDatePicker" maxWidth="Infinity" promptText="Sélectionner une date"/>
                                </VBox>

                                <!-- Bouton analyser -->
                                <Button fx:id="analyzeButton" text="🔍 Analyser cette position"
                                        styleClass="btn, btn-primary" style="-fx-font-size: 14px; -fx-padding: 12 20;"
                                        onAction="#analyzeRegion" maxWidth="Infinity"/>

                                <HBox alignment="CENTER">
                                    <ProgressIndicator fx:id="loadingIndicator" visible="false"
                                                       prefWidth="40" prefHeight="40"/>
                                </HBox>
                            </VBox>

                            <Separator/>

                            <!-- Historique -->
                            <VBox spacing="10" VBox.vgrow="ALWAYS">
                                <Label text="📜 Historique" style="-fx-font-weight: bold; -fx-font-size: 14px;-fx-text-fill: #0a371d;"/>
                                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                                    <VBox fx:id="historyContainer" spacing="8">
                                        <Label text="Aucune analyse" style="-fx-text-fill: #6c757d;"/>
                                    </VBox>
                                </ScrollPane>
                            </VBox>
                        </VBox>
                    </HBox>

                    <!-- Résultats -->
                    <VBox fx:id="resultsContainer" spacing="20" visible="false">

                        <!-- Score et graphique -->
                        <HBox spacing="20">
                            <VBox styleClass="card" alignment="CENTER" spacing="15" prefWidth="250">
                                <Label text="⚠️ Score de Risque" styleClass="card-header"/>
                                <StackPane fx:id="scoreContainer" prefWidth="140" prefHeight="140"/>
                                <Label fx:id="scoreNiveauLabel" text="--" style="-fx-font-size: 18px;"/>
                            </VBox>

                            <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="10">
                                <Label text="📊 Indicateurs" styleClass="card-header"/>
                                <StackPane fx:id="chartContainer" prefHeight="250"/>
                            </VBox>
                        </HBox>

                        <!-- Stats -->
                        <HBox spacing="15">
                            <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="5"
                                  style="-fx-background-color: #0a371d; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
                                <Label text="🌡️" style="-fx-font-size: 24px;"/>
                                <Label fx:id="tempValue" text="--" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                                <Label text="Température" style="-fx-text-fill: #6c757d; -fx-font-size: 11px;"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="5"
                                  style="-fx-background-color: #876c00; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
                                <Label text="🌧️" style="-fx-font-size: 24px;"/>
                                <Label fx:id="precipValue" text="--" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                                <Label text="Précipitations" style="-fx-text-fill: #6c757d; -fx-font-size: 11px;"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="5"
                                  style="-fx-background-color: #0a371d; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
                                <Label text="💧" style="-fx-font-size: 24px;"/>
                                <Label fx:id="humidValue" text="--" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                                <Label text="Humidité" style="-fx-text-fill: #6c757d; -fx-font-size: 11px;"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="5"
                                  style="-fx-background-color: #876c00; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
                                <Label text="🌿" style="-fx-font-size: 24px;"/>
                                <Label fx:id="ndviValue" text="--" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                                <Label text="NDVI" style="-fx-text-fill: #6c757d; -fx-font-size: 11px;"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="5"
                                  style="-fx-background-color: #0a371d; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
                                <Label text="☀️" style="-fx-font-size: 24px;"/>
                                <Label fx:id="droughtValue" text="--" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                                <Label text="Sécheresse" style="-fx-text-fill: #6c757d; -fx-font-size: 11px;"/>
                            </VBox>
                        </HBox>

                        <!-- Analyse -->
                        <HBox spacing="20">
                            <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="10"
                                  style="-fx-background-color: #fff3cd;">
                                <Label text="⚠️ Facteurs de risque" style="-fx-font-weight: bold; -fx-text-fill: #856404;"/>
                                <Label fx:id="factorsLabel" text="--" wrapText="true" style="-fx-text-fill: #856404;"/>
                            </VBox>

                            <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="10"
                                  style="-fx-background-color: #d4edda;">
                                <Label text="💡 Recommandations" style="-fx-font-weight: bold; -fx-text-fill: #155724;"/>
                                <Label fx:id="recoLabel" text="--" wrapText="true" style="-fx-text-fill: #155724;"/>
                            </VBox>
                        </HBox>
                    </VBox>

                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>