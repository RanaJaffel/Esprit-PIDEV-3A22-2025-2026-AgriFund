<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane prefHeight="750" prefWidth="1300"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.agrifund.controller.banque.BanqueProduitController"
            style="-fx-background-color: #F5F7F5;">

    <!-- ========== SIDEBAR ========== -->
    <left>
        <fx:include source="banque-sidebar.fxml"/>
    </left>

    <!-- ========== MAIN CONTENT ========== -->
    <center>
        <VBox spacing="0" style="-fx-background-color: transparent;">

            <!-- ========== TOP HEADER ========== -->
            <HBox alignment="CENTER_LEFT" prefHeight="85" spacing="20"
                  style="-fx-background-color: linear-gradient(to right, #FFFFFF, #F0F5E8);
                         -fx-padding: 0 30; -fx-border-color: #B2D944; -fx-border-width: 0 0 2 0;">

                <VBox spacing="3">
                    <Label text="Mes Produits Financiers"
                           style="-fx-text-fill: #133D03; -fx-font-size: 24; -fx-font-weight: bold;"/>
                    <Label fx:id="lblBanqueName" text="Produits de: [Nom Banque]"
                           style="-fx-text-fill: #476C1A; -fx-font-size: 12;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Search -->
                <HBox spacing="10" alignment="CENTER">
                    <TextField fx:id="txtRecherche" promptText="🔍 Rechercher un produit..." prefWidth="280" prefHeight="40"
                               style="-fx-background-color: #F5F8F0; -fx-background-radius: 20;
                                      -fx-border-color: #B2D944; -fx-border-radius: 20; -fx-border-width: 2;
                                      -fx-padding: 0 18; -fx-font-size: 12;"/>
                    <Button text="Rechercher" onAction="#handleRechercher" prefHeight="40"
                            style="-fx-background-color: linear-gradient(to right, #089647, #076A39);
                                   -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11;
                                   -fx-background-radius: 20; -fx-padding: 0 22; -fx-cursor: hand;"/>
                </HBox>

                <Separator orientation="VERTICAL" style="-fx-background-color: #B2D944;"/>

                <Button text="↻ Actualiser" onAction="#handleActualiser" prefHeight="40"
                        style="-fx-background-color: #E8F5E0; -fx-text-fill: #089647;
                               -fx-font-weight: bold; -fx-font-size: 11;
                               -fx-background-radius: 20; -fx-padding: 0 18; -fx-cursor: hand;
                               -fx-border-color: #B2D944; -fx-border-radius: 20; -fx-border-width: 1;"/>

                <HBox spacing="6" alignment="CENTER">
                    <Circle radius="5" fill="#089647"/>
                    <Label fx:id="lblStatus" text="Connecté"
                           style="-fx-text-fill: #089647; -fx-font-weight: bold; -fx-font-size: 11;"/>
                </HBox>
            </HBox>

            <!-- ========== CONTENT ========== -->
            <VBox VBox.vgrow="ALWAYS" style="-fx-padding: 25; -fx-background-color: linear-gradient(to bottom, #FFFFFF, #F0F5E8);">

                <!-- Stats Cards -->
                <HBox spacing="20" alignment="CENTER">
                    <!-- Total -->
                    <VBox alignment="CENTER" spacing="5" prefWidth="180" prefHeight="115"
                          style="-fx-background-color: linear-gradient(to bottom right, #FFFFFF, #E8F5E0);
                                 -fx-padding: 20; -fx-background-radius: 18;
                                 -fx-border-color: #089647; -fx-border-width: 2; -fx-border-radius: 18;
                                 -fx-effect: dropshadow(gaussian, rgba(8,150,71,0.15), 12, 0, 0, 4);">
                        <HBox alignment="CENTER" spacing="12">
                            <VBox alignment="CENTER" prefWidth="44" prefHeight="44"
                                  style="-fx-background-color: linear-gradient(to bottom, #089647, #076A39);
                                         -fx-background-radius: 11;">
                                <Label text="📦" style="-fx-font-size: 18;"/>
                            </VBox>
                            <VBox>
                                <Label fx:id="lblTotalProduits" text="0"
                                       style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #133D03;"/>
                                <Label text="Total" style="-fx-text-fill: #089647; -fx-font-size: 11;"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Prêts -->
                    <VBox alignment="CENTER" spacing="5" prefWidth="180" prefHeight="115"
                          style="-fx-background-color: linear-gradient(to bottom right, #FFFFFF, #D4ED9E);
                                 -fx-padding: 20; -fx-background-radius: 18;
                                 -fx-border-color: #B2D944; -fx-border-width: 2; -fx-border-radius: 18;
                                 -fx-effect: dropshadow(gaussian, rgba(178,217,68,0.15), 12, 0, 0, 4);">
                        <HBox alignment="CENTER" spacing="12">
                            <VBox alignment="CENTER" prefWidth="44" prefHeight="44"
                                  style="-fx-background-color: linear-gradient(to bottom, #B2D944, #9A951F);
                                         -fx-background-radius: 11;">
                                <Label text="💰" style="-fx-font-size: 18;"/>
                            </VBox>
                            <VBox>
                                <Label fx:id="lblPrets" text="0"
                                       style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #476C1A;"/>
                                <Label text="Prêts" style="-fx-text-fill: #9A951F; -fx-font-size: 11;"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Crédits -->
                    <VBox alignment="CENTER" spacing="5" prefWidth="180" prefHeight="115"
                          style="-fx-background-color: linear-gradient(to bottom right, #FFFFFF, #FDF5DC);
                                 -fx-padding: 20; -fx-background-radius: 18;
                                 -fx-border-color: #E1B323; -fx-border-width: 2; -fx-border-radius: 18;
                                 -fx-effect: dropshadow(gaussian, rgba(225,179,35,0.15), 12, 0, 0, 4);">
                        <HBox alignment="CENTER" spacing="12">
                            <VBox alignment="CENTER" prefWidth="44" prefHeight="44"
                                  style="-fx-background-color: linear-gradient(to bottom, #E1B323, #9A951F);
                                         -fx-background-radius: 11;">
                                <Label text="💳" style="-fx-font-size: 18;"/>
                            </VBox>
                            <VBox>
                                <Label fx:id="lblCredits" text="0"
                                       style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #9A951F;"/>
                                <Label text="Crédits" style="-fx-text-fill: #E1B323; -fx-font-size: 11;"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Autres -->
                    <VBox alignment="CENTER" spacing="5" prefWidth="180" prefHeight="115"
                          style="-fx-background-color: linear-gradient(to bottom right, #FFFFFF, #E8E8E8);
                                 -fx-padding: 20; -fx-background-radius: 18;
                                 -fx-border-color: #848A86; -fx-border-width: 2; -fx-border-radius: 18;
                                 -fx-effect: dropshadow(gaussian, rgba(132,138,134,0.15), 12, 0, 0, 4);">
                        <HBox alignment="CENTER" spacing="12">
                            <VBox alignment="CENTER" prefWidth="44" prefHeight="44"
                                  style="-fx-background-color: linear-gradient(to bottom, #848A86, #5A5E5B);
                                         -fx-background-radius: 11;">
                                <Label text="📁" style="-fx-font-size: 18;"/>
                            </VBox>
                            <VBox>
                                <Label fx:id="lblAutres" text="0"
                                       style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #5A5E5B;"/>
                                <Label text="Autres" style="-fx-text-fill: #848A86; -fx-font-size: 11;"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Action Buttons -->
                <HBox spacing="15" alignment="CENTER" style="-fx-padding: 22 0;">
                    <Button text="+ Nouveau Produit" onAction="#handleNouveau" prefHeight="45"
                            style="-fx-background-color: linear-gradient(to right, #089647, #076A39);
                                   -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12;
                                   -fx-padding: 0 25; -fx-background-radius: 22; -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, rgba(8,150,71,0.3), 10, 0, 0, 3);"
                            onMousePressed="#onButtonPressed" onMouseReleased="#onButtonReleased"/>

                    <Button text="✏ Modifier" onAction="#handleModifier" prefHeight="45"
                            style="-fx-background-color: linear-gradient(to right, #B2D944, #9A951F);
                                   -fx-text-fill: #133D03; -fx-font-weight: bold; -fx-font-size: 12;
                                   -fx-padding: 0 25; -fx-background-radius: 22; -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, rgba(178,217,68,0.3), 10, 0, 0, 3);"
                            onMousePressed="#onButtonPressed" onMouseReleased="#onButtonReleased"/>

                    <Button text="👁 Détails" onAction="#handleDetails" prefHeight="45"
                            style="-fx-background-color: linear-gradient(to right, #095032, #076A39);
                                   -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12;
                                   -fx-padding: 0 25; -fx-background-radius: 22; -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, rgba(9,80,50,0.3), 10, 0, 0, 3);"
                            onMousePressed="#onButtonPressed" onMouseReleased="#onButtonReleased"/>

                    <Button text="📥 PDF" onAction="#handleDownloadPDF" prefHeight="45"
                            style="-fx-background-color: linear-gradient(to right, #476C1A, #133D03);
                                   -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12;
                                   -fx-padding: 0 25; -fx-background-radius: 22; -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, rgba(71,108,26,0.3), 10, 0, 0, 3);"
                            onMousePressed="#onButtonPressed" onMouseReleased="#onButtonReleased"/>

                    <Button text="🗑 Supprimer" onAction="#handleSupprimer" prefHeight="45"
                            style="-fx-background-color: linear-gradient(to right, #E1B323, #9A951F);
                                   -fx-text-fill: #133D03; -fx-font-weight: bold; -fx-font-size: 12;
                                   -fx-padding: 0 25; -fx-background-radius: 22; -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, rgba(225,179,35,0.3), 10, 0, 0, 3);"
                            onMousePressed="#onButtonPressed" onMouseReleased="#onButtonReleased"/>
                </HBox>

                <!-- Table -->
                <VBox VBox.vgrow="ALWAYS" spacing="15"
                      style="-fx-background-color: #FFFFFF;
                             -fx-padding: 22; -fx-background-radius: 18;
                             -fx-border-color: #089647; -fx-border-width: 2; -fx-border-radius: 18;
                             -fx-effect: dropshadow(gaussian, rgba(8,150,71,0.1), 15, 0, 0, 5);">

                    <HBox alignment="CENTER_LEFT">
                        <Label text="📋 Liste des Produits"
                               style="-fx-text-fill: #133D03; -fx-font-size: 17; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblCount" text="0 produits"
                               style="-fx-text-fill: #089647; -fx-font-size: 11; -fx-font-weight: bold;
                                      -fx-background-color: #E8F5E0; -fx-padding: 6 15; -fx-background-radius: 12;"/>
                    </HBox>

                    <TableView fx:id="tableView" VBox.vgrow="ALWAYS"
                               style="-fx-background-color: transparent;
                                      -fx-border-color: #B2D944; -fx-border-width: 1; -fx-border-radius: 12;">
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="55" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colNom" text="Nom du Produit" prefWidth="230"/>
                            <TableColumn fx:id="colType" text="Type" prefWidth="110" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colTaux" text="Taux %" prefWidth="80" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colPrixFixe" text="Prix Fixe (DT)" prefWidth="140" style="-fx-alignment: CENTER-RIGHT;"/>
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="15" style="-fx-padding: 45;">
                                <Label text="📭" style="-fx-font-size: 45;"/>
                                <Label text="Aucun produit disponible"
                                       style="-fx-text-fill: #089647; -fx-font-size: 16; -fx-font-weight: bold;"/>
                                <Label text="Cliquez sur '+ Nouveau Produit' pour commencer"
                                       style="-fx-text-fill: #848A86; -fx-font-size: 12;"/>
                            </VBox>
                        </placeholder>
                    </TableView>
                </VBox>
            </VBox>

            <!-- ========== FOOTER ========== -->
            <HBox alignment="CENTER" spacing="15" prefHeight="50"
                  style="-fx-background-color: linear-gradient(to right, #E8F5E0, #D4ED9E, #E8F5E0);
                         -fx-border-color: #B2D944; -fx-border-width: 2 0 0 0;">
                <Circle radius="5" fill="#089647"/>
                <Label text="AgriFund 2025" style="-fx-text-fill: #133D03; -fx-font-size: 11; -fx-font-weight: bold;"/>
                <Label text="•" style="-fx-text-fill: #B2D944;"/>
                <Label text="Espace Banque - Financement Agricole" style="-fx-text-fill: #476C1A; -fx-font-size: 11;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
