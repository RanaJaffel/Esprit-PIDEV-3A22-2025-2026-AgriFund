<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@../stylerayen.css" style="-fx-background-color: #F8F9FA;"
            prefWidth="1400" prefHeight="850"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.agrifund.controller.banque.BanqueRessourceController">

    <left>
        <fx:include source="banque-sidebar.fxml"/>
    </left>

    <top>
        <VBox spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="page-header"
                  style="-fx-background-color: linear-gradient(to right, #1565C0, #0D47A1);">
                <padding><Insets top="18" right="30" bottom="18" left="30"/></padding>

                <HBox alignment="CENTER" spacing="12">
                    <Label text="🏦" style="-fx-font-size: 32px;"/>
                    <VBox spacing="0">
                        <Label text="Consultation des Ressources" styleClass="header-title" style="-fx-font-size: 26px;"/>
                        <Label text="Vue bancaire - Analyse des investissements agricoles"
                               style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 13px;"/>
                    </VBox>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="🔄 Actualiser" styleClass="btn-info" onAction="#handleRefresh"
                        prefHeight="38" prefWidth="130"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="15" styleClass="toolbar">
                <padding><Insets top="15" right="30" bottom="15" left="30"/></padding>

                <HBox alignment="CENTER_LEFT" spacing="8"
                      style="-fx-background-color: #F8F9FA; -fx-background-radius: 20; -fx-padding: 8 16;">
                    <Label text="🔍" style="-fx-font-size: 16px;"/>
                    <TextField fx:id="tfSearch" promptText="Rechercher..."
                               prefWidth="280" style="-fx-background-color: transparent; -fx-border-width: 0;"/>
                </HBox>

                <ComboBox fx:id="cbFilterType" promptText="Type ressource" prefWidth="150"/>
                <ComboBox fx:id="cbFilterStatutProjet" promptText="Statut projet" prefWidth="150"/>
                <ComboBox fx:id="cbFilterStatutRessource" promptText="Statut ressource" prefWidth="140"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="0" VBox.vgrow="ALWAYS">
            <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>

            <HBox spacing="20" alignment="CENTER_LEFT">
                <padding><Insets bottom="20"/></padding>

                <HBox spacing="15" alignment="CENTER_LEFT" styleClass="stat-card" HBox.hgrow="ALWAYS"
                      style="-fx-border-color: #1565C0; -fx-border-width: 0 0 3 0;">
                    <StackPane style="-fx-min-width: 50; -fx-min-height: 50; -fx-background-color: #E3F2FD; -fx-background-radius: 10;">
                        <Label text="📦" style="-fx-font-size: 24px;"/>
                    </StackPane>
                    <VBox spacing="4">
                        <Label text="Ressources" style="-fx-text-fill: #666; -fx-font-size: 12px;"/>
                        <Label fx:id="lblTotalRessources" text="--" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>
                    </VBox>
                </HBox>

                <HBox spacing="15" alignment="CENTER_LEFT" styleClass="stat-card" HBox.hgrow="ALWAYS"
                      style="-fx-border-color: #388E3C; -fx-border-width: 0 0 3 0;">
                    <StackPane style="-fx-min-width: 50; -fx-min-height: 50; -fx-background-color: #E8F5E9; -fx-background-radius: 10;">
                        <Label text="👨‍🌾" style="-fx-font-size: 24px;"/>
                    </StackPane>
                    <VBox spacing="4">
                        <Label text="Agriculteurs" style="-fx-text-fill: #666; -fx-font-size: 12px;"/>
                        <Label fx:id="lblTotalAgriculteurs" text="--" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #388E3C;"/>
                    </VBox>
                </HBox>

                <HBox spacing="15" alignment="CENTER_LEFT" styleClass="stat-card" HBox.hgrow="ALWAYS"
                      style="-fx-border-color: #7B1FA2; -fx-border-width: 0 0 3 0;">
                    <StackPane style="-fx-min-width: 50; -fx-min-height: 50; -fx-background-color: #F3E5F5; -fx-background-radius: 10;">
                        <Label text="📁" style="-fx-font-size: 24px;"/>
                    </StackPane>
                    <VBox spacing="4">
                        <Label text="Projets" style="-fx-text-fill: #666; -fx-font-size: 12px;"/>
                        <Label fx:id="lblTotalProjets" text="--" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #7B1FA2;"/>
                    </VBox>
                </HBox>

                <HBox spacing="15" alignment="CENTER_LEFT" styleClass="stat-card" HBox.hgrow="ALWAYS"
                      style="-fx-border-color: #E65100; -fx-border-width: 0 0 3 0;">
                    <StackPane style="-fx-min-width: 50; -fx-min-height: 50; -fx-background-color: #FFF3E0; -fx-background-radius: 10;">
                        <Label text="💰" style="-fx-font-size: 24px;"/>
                    </StackPane>
                    <VBox spacing="4">
                        <Label text="Investissement Total" style="-fx-text-fill: #666; -fx-font-size: 12px;"/>
                        <Label fx:id="lblCoutTotal" text="-- DT" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #E65100;"/>
                    </VBox>
                </HBox>
            </HBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-border-width: 0;">
                <FlowPane fx:id="ressourcesContainer" hgap="20" vgap="20"
                          style="-fx-padding: 5; -fx-background-color: transparent;"/>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>