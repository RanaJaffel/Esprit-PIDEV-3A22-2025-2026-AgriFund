<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.agrifund.controller.banque.BanqueRessourceController"
      stylesheets="@banque-styles.css" style="-fx-background-color: #F8FAF8;">

    <!-- SIDEBAR (Full Height) -->
    <fx:include source="banque-sidebar.fxml"/>

    <!-- MAIN CONTENT -->
    <BorderPane HBox.hgrow="ALWAYS">

        <top>
            <VBox spacing="0">
                <!-- Header -->
                <HBox alignment="CENTER_LEFT" spacing="20" styleClass="header">
                    <padding><Insets top="18" right="30" bottom="18" left="30"/></padding>

                    <HBox alignment="CENTER" spacing="12">
                        <StackPane styleClass="icon-container" style="-fx-min-width: 52; -fx-min-height: 52;">
                            <Label text="📦" style="-fx-font-size: 30px;"/>
                        </StackPane>
                        <VBox spacing="2">
                            <Label text="Consultation des Ressources" styleClass="title"/>
                            <Label text="Vue bancaire - Analyse des investissements agricoles"
                                   styleClass="subtitle"/>
                        </VBox>
                    </HBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="🔄 Actualiser" styleClass="button-secondary" onAction="#handleRefresh" prefHeight="40"/>
                </HBox>

                <!-- Toolbar -->
                <HBox alignment="CENTER_LEFT" spacing="15" styleClass="toolbar">
                    <padding><Insets top="15" right="30" bottom="15" left="30"/></padding>

                    <HBox alignment="CENTER_LEFT" spacing="8"
                          style="-fx-background-color: #F8FAF8; -fx-background-radius: 20; -fx-padding: 8 16;
                                 -fx-border-color: #B2D944; -fx-border-radius: 20; -fx-border-width: 1;">
                        <Label text="🔍" style="-fx-font-size: 16px;"/>
                        <TextField fx:id="tfSearch" promptText="Rechercher..."
                                   prefWidth="280" style="-fx-background-color: transparent; -fx-border-width: 0;"/>
                    </HBox>

                    <ComboBox fx:id="cbFilterType" promptText="Type ressource" prefWidth="150"/>
                    <ComboBox fx:id="cbFilterStatutProjet" promptText="Statut projet" prefWidth="150"/>
                    <ComboBox fx:id="cbFilterStatutRessource" promptText="Statut ressource" prefWidth="140"/>
                </HBox>
            </VBox>
        </top>

        <center>
            <VBox spacing="0" VBox.vgrow="ALWAYS">
                <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>

                <!-- Statistics Cards -->
                <HBox spacing="20" alignment="CENTER_LEFT">
                    <padding><Insets bottom="20"/></padding>

                    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <StackPane style="-fx-min-width: 50; -fx-min-height: 50; -fx-background-color: rgba(178,217,68,0.2); -fx-background-radius: 12;">
                            <Label text="📦" style="-fx-font-size: 24px;"/>
                        </StackPane>
                        <VBox spacing="4">
                            <Label text="Ressources" styleClass="stats-label"/>
                            <Label fx:id="lblTotalRessources" text="--" styleClass="stats-value"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="stat-card" HBox.hgrow="ALWAYS"
                          style="-fx-border-color: #089647; -fx-border-width: 0 0 3 0;">
                        <StackPane style="-fx-min-width: 50; -fx-min-height: 50; -fx-background-color: rgba(8,150,71,0.12); -fx-background-radius: 12;">
                            <Label text="👨‍🌾" style="-fx-font-size: 24px;"/>
                        </StackPane>
                        <VBox spacing="4">
                            <Label text="Agriculteurs" styleClass="stats-label"/>
                            <Label fx:id="lblTotalAgriculteurs" text="--" styleClass="stats-value-green"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="stat-card" HBox.hgrow="ALWAYS"
                          style="-fx-border-color: #476C1A; -fx-border-width: 0 0 3 0;">
                        <StackPane style="-fx-min-width: 50; -fx-min-height: 50; -fx-background-color: rgba(71,108,26,0.12); -fx-background-radius: 12;">
                            <Label text="📁" style="-fx-font-size: 24px;"/>
                        </StackPane>
                        <VBox spacing="4">
                            <Label text="Projets" styleClass="stats-label"/>
                            <Label fx:id="lblTotalProjets" text="--" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #476C1A;"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="stat-card" HBox.hgrow="ALWAYS"
                          style="-fx-border-color: #E1B323; -fx-border-width: 0 0 3 0;">
                        <StackPane style="-fx-min-width: 50; -fx-min-height: 50; -fx-background-color: rgba(225,179,35,0.15); -fx-background-radius: 12;">
                            <Label text="💰" style="-fx-font-size: 24px;"/>
                        </StackPane>
                        <VBox spacing="4">
                            <Label text="Investissement Total" styleClass="stats-label"/>
                            <Label fx:id="lblCoutTotal" text="-- DT" styleClass="stats-value-yellow"/>
                        </VBox>
                    </HBox>
                </HBox>

                <!-- Resources Grid -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
                    <FlowPane fx:id="ressourcesContainer" hgap="20" vgap="20" style="-fx-padding: 5;"/>
                </ScrollPane>
            </VBox>
        </center>

    </BorderPane>

</HBox>
