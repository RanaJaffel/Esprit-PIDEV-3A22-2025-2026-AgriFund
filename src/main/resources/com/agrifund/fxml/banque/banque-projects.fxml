<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.agrifund.controller.banque.BanqueProjectController"
      stylesheets="@banque-styles.css" style="-fx-background-color: #F8FAF8;">

    <!-- SIDEBAR (Full Height) -->
    <fx:include source="banque-sidebar.fxml"/>

    <!-- MAIN CONTENT -->
    <BorderPane HBox.hgrow="ALWAYS">

        <top>
            <VBox spacing="0">
                <!-- Header -->
                <HBox alignment="CENTER" spacing="20" styleClass="header">
                    <padding><Insets top="20" right="30" bottom="20" left="30"/></padding>
                    <HBox alignment="CENTER_LEFT" spacing="15" HBox.hgrow="ALWAYS">
                        <StackPane styleClass="icon-container" style="-fx-min-width: 55; -fx-min-height: 55;">
                            <Label text="🏦" style="-fx-font-size: 32px;"/>
                        </StackPane>
                        <VBox spacing="2">
                            <Label text="Demandes de Financement" styleClass="title"/>
                            <Label text="Évaluation et gestion des demandes de crédit agricole"
                                   styleClass="subtitle"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="10">
                        <Button text="🔄 Actualiser" onAction="#handleRefresh" styleClass="button-secondary"/>
                        <Button text="📊 Rapport PDF" onAction="#exportToPDF" styleClass="button-primary"/>
                    </HBox>
                </HBox>

                <!-- Toolbar avec stats -->
                <HBox alignment="CENTER_LEFT" spacing="20" styleClass="toolbar">
                    <padding><Insets top="18" right="30" bottom="18" left="30"/></padding>

                    <!-- Search et filtres -->
                    <HBox alignment="CENTER_LEFT" spacing="8"
                          style="-fx-background-color: #F8FAF8; -fx-background-radius: 25; -fx-padding: 10 18;
                                 -fx-border-color: #B2D944; -fx-border-radius: 25; -fx-border-width: 1;">
                        <Label text="🔍" style="-fx-font-size: 16px;"/>
                        <TextField fx:id="tfSearchProject" promptText="Rechercher par projet ou demandeur..."
                                   prefWidth="300" style="-fx-background-color: transparent; -fx-border-width: 0;"/>
                    </HBox>

                    <ComboBox fx:id="cbFilterStatut" promptText="Filtrer par statut" prefWidth="180"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- Stats Dashboard -->
                    <HBox spacing="20">
                        <VBox alignment="CENTER" styleClass="stat-card" style="-fx-min-width: 120;">
                            <Label text="📋 Total" styleClass="stats-label"/>
                            <Label fx:id="lblTotalProjects" text="--" styleClass="stats-value"/>
                        </VBox>

                        <VBox alignment="CENTER" styleClass="stat-card" style="-fx-min-width: 120; -fx-border-color: #E1B323; -fx-border-width: 0 0 3 0;">
                            <Label text="⏳ En Attente" styleClass="stats-label"/>
                            <Label fx:id="lblPendingProjects" text="--" styleClass="stats-value-yellow"/>
                        </VBox>

                        <VBox alignment="CENTER" styleClass="stat-card" style="-fx-min-width: 140; -fx-border-color: #089647; -fx-border-width: 0 0 3 0;">
                            <Label text="💰 Budget Total" styleClass="stats-label"/>
                            <Label fx:id="lblTotalBudget" text="-- DT" styleClass="stats-value-green"/>
                        </VBox>

                        <VBox alignment="CENTER" styleClass="stat-card" style="-fx-min-width: 160; -fx-border-color: #9A951F; -fx-border-width: 0 0 3 0;">
                            <Label text="⚠️ Montant en Attente" styleClass="stats-label"/>
                            <Label fx:id="lblPendingBudget" text="-- DT" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #9A951F;"/>
                        </VBox>
                    </HBox>
                </HBox>
            </VBox>
        </top>

        <center>
            <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
                <FlowPane fx:id="projectsContainer" hgap="20" vgap="20" style="-fx-padding: 25;"/>
            </ScrollPane>
        </center>

    </BorderPane>

</HBox>