<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.agrifund.controller.agriculteur.AgriculteurSidebarController"
      styleClass="sidebar"
      style="-fx-background-color: linear-gradient(to bottom, #095032, #133D03);">

    <!-- Logo -->
    <VBox styleClass="sidebar-header" spacing="5">
        <ImageView fitWidth="220"
                   preserveRatio="true"
                   smooth="true"
                   cache="true">
            <image>
                <Image url="@/com/agrifund/images/logo.png"/>
            </image>
        </ImageView>
        <Label text="Espace Agriculteur" style="-fx-text-fill: #B2D944; -fx-font-size: 12px;"/>
    </VBox>

    <!-- User Profile Widget -->
    <VBox styleClass="user-profile-widget" spacing="10" alignment="CENTER">
        <ImageView fx:id="userAvatar" styleClass="user-avatar, user-avatar-medium"
                   fitWidth="60" fitHeight="60" preserveRatio="true"/>
        <Label fx:id="userName" text="Agriculteur" styleClass="user-name"/>
        <HBox fx:id="verificationBadge" alignment="CENTER" spacing="5">
            <!-- Rempli dynamiquement -->
        </HBox>
    </VBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
        <VBox spacing="5" style="-fx-padding: 10 0;">

            <!-- PRINCIPAL -->
            <Label text="PRINCIPAL" styleClass="sidebar-section-title"/>
            <Button fx:id="btnDashboard" text="📊  Tableau de bord" styleClass="sidebar-menu-item"
                    onAction="#goToDashboard" maxWidth="Infinity"/>
            <Button fx:id="btnProfile" text="👤  Mon profil" styleClass="sidebar-menu-item"
                    onAction="#goToProfile" maxWidth="Infinity"/>
            <Button fx:id="btnDocuments" text="📄  Mes documents" styleClass="sidebar-menu-item"
                    onAction="#goToDocuments" maxWidth="Infinity"/>

            <!-- FINANCE -->
            <Label text="FINANCE" styleClass="sidebar-section-title"/>
            <Button fx:id="btnProduitsFinanciers" text="💰  Produits Financiers" styleClass="sidebar-menu-item"
                    onAction="#goToProduitsFinanciers" maxWidth="Infinity"/>
            <Button fx:id="btnOffresFinancieres" text="📋  Offres Financières" styleClass="sidebar-menu-item"
                    onAction="#goToOffresFinancieres" maxWidth="Infinity"/>
            <Button fx:id="btnDemandeFinancement" text="💳  Demande Financement" styleClass="sidebar-menu-item"
                    onAction="#goToDemandeFinancement" maxWidth="Infinity"/>
            <Button fx:id="btnAccueilProduits" text="🏪  Accueil Produits" styleClass="sidebar-menu-item"
                    onAction="#goToAccueilProduits" maxWidth="Infinity"/>

            <!-- AGRICULTURE -->
            <Label text="AGRICULTURE" styleClass="sidebar-section-title"/>
            <Button fx:id="btnProjetsAgricoles" text="🌾  Projets Agricoles" styleClass="sidebar-menu-item"
                    onAction="#goToProjetsAgricoles" maxWidth="Infinity"/>
            <Button fx:id="btnRessources" text="🌿  Ressources" styleClass="sidebar-menu-item"
                    onAction="#goToRessources" maxWidth="Infinity"/>


            <!-- IoT & RAPPORTS -->
            <Label text="IoT &amp; RAPPORTS" styleClass="sidebar-section-title"/>
            <Button fx:id="btnCapteurs" text="📡  Capteurs" styleClass="sidebar-menu-item"
                    onAction="#goToCapteurs" maxWidth="Infinity"/>
            <Button fx:id="btnMeteo" text="📈  Meteo" styleClass="sidebar-menu-item"
                    onAction="#goToMeteo" maxWidth="Infinity"/>
            <!-- COMMUNICATION -->
            <Label text="COMMUNICATION" styleClass="sidebar-section-title"/>
            <Button fx:id="btnMessagerie" text="💬  Messagerie" styleClass="sidebar-menu-item"
                    onAction="#goToMessagerie" maxWidth="Infinity"/>

            <!-- OUTILS -->
            <Label text="OUTILS" styleClass="sidebar-section-title"/>
            <Button fx:id="btnCarte" text="🗺  Carte" styleClass="sidebar-menu-item"
                    onAction="#goToCarte" maxWidth="Infinity"/>
            <Button fx:id="btnChatbot" text="🤖  Chatbot" styleClass="sidebar-menu-item"
                    onAction="#goToChatbot" maxWidth="Infinity"/>

            <!-- COMPTE -->
            <Label text="COMPTE" styleClass="sidebar-section-title"/>
            <Button fx:id="btnSecurity" text="🔐  Sécurité" styleClass="sidebar-menu-item"
                    onAction="#goToSecurity" maxWidth="Infinity"/>
            <Button fx:id="btnLogout" text="🚪  Déconnexion" styleClass="sidebar-menu-item"
                    onAction="#handleLogout" maxWidth="Infinity" style="-fx-text-fill: #dc3545;"/>
        </VBox>
    </ScrollPane>

    <!-- Quick Info -->
    <VBox style="-fx-padding: 15; -fx-background-color: rgba(0,0,0,0.2);" spacing="10">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="🌱" style="-fx-font-size: 16px;"/>
            <VBox>
                <Label fx:id="typeCultureLabel" text="Culture" style="-fx-text-fill: white; -fx-font-size: 11px;"/>
                <Label fx:id="superficieLabel" text="0 ha" style="-fx-text-fill: #B2D944; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            </VBox>
        </HBox>
    </VBox>
</VBox>