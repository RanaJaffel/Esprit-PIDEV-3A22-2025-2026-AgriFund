<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.agrifund.controller.agriculteur.AgriculteurSidebarController"
      styleClass="sidebar"
      fx:id="sidebar"
      stylesheets="@/com/agrifund/fxml/agriculteur/agriculteur-sidebar.css">

    <!-- ═══════════════════════════════════════════════════════════════════
         HEADER - LOGO & BRANDING
    ═══════════════════════════════════════════════════════════════════ -->
    <VBox styleClass="sidebar-header" spacing="10" alignment="CENTER">
        <ImageView fitWidth="160" preserveRatio="true" smooth="true" cache="true">
            <image>
                <Image url="@/com/agrifund/images/logo.png"/>
            </image>
        </ImageView>
        <HBox alignment="CENTER" spacing="8">
            <Label text="🌾" style="-fx-font-size: 14px;"/>
            <Label text="ESPACE AGRICULTEUR" styleClass="space-badge"/>
        </HBox>
    </VBox>

    <!-- ═══════════════════════════════════════════════════════════════════
         PROFIL UTILISATEUR AVEC STATUT
    ═══════════════════════════════════════════════════════════════════ -->
    <VBox styleClass="user-profile-card" spacing="15" alignment="CENTER">
        <padding>
            <Insets top="20" right="15" bottom="20" left="15"/>
        </padding>

        <!-- Avatar avec indicateur de statut -->
        <StackPane>
            <Circle radius="42" styleClass="avatar-glow"/>
            <Circle radius="38" styleClass="avatar-border"/>
            <ImageView fx:id="userAvatar" fitWidth="70" fitHeight="70" preserveRatio="true"/>
            <Circle radius="10" styleClass="status-indicator" translateX="28" translateY="28"/>
        </StackPane>

        <!-- Nom et badge de vérification -->
        <VBox spacing="8" alignment="CENTER">
            <Label fx:id="userName" text="Agriculteur" styleClass="user-name"/>
            <HBox fx:id="verificationBadge" alignment="CENTER" spacing="5">
                <!-- Badge dynamique -->
            </HBox>
        </VBox>

        <!-- Stats rapides -->
        <HBox styleClass="quick-stats" spacing="15" alignment="CENTER">
            <VBox alignment="CENTER" spacing="2">
                <Label text="🌱" style="-fx-font-size: 18px;"/>
                <Label fx:id="typeCultureLabel" text="Culture" styleClass="stat-value"/>
            </VBox>
            <Separator orientation="VERTICAL" styleClass="stat-separator"/>
            <VBox alignment="CENTER" spacing="2">
                <Label text="📐" style="-fx-font-size: 18px;"/>
                <Label fx:id="superficieLabel" text="0 ha" styleClass="stat-value-highlight"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- ═══════════════════════════════════════════════════════════════════
         MENU DE NAVIGATION SCROLLABLE
    ═══════════════════════════════════════════════════════════════════ -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="menu-scroll">
        <VBox spacing="2" styleClass="menu-container">

            <!-- ══════════════════════════════════════════════════════════
                 SECTION: PRINCIPAL
            ══════════════════════════════════════════════════════════ -->
            <Label text="PRINCIPAL" styleClass="section-title"/>

            <Button fx:id="btnDashboard" styleClass="sidebar-menu-item"
                    onAction="#goToDashboard" maxWidth="Infinity">
                <graphic>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="📊" styleClass="menu-icon"/>
                        <Label text="Tableau de bord" styleClass="menu-text"/>
                    </HBox>
                </graphic>
            </Button>

            <Button fx:id="btnProfile" styleClass="sidebar-menu-item"
                    onAction="#goToProfile" maxWidth="Infinity">
                <graphic>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="👤" styleClass="menu-icon"/>
                        <Label text="Mon profil" styleClass="menu-text"/>
                    </HBox>
                </graphic>
            </Button>

            <Button fx:id="btnDocuments" styleClass="sidebar-menu-item"
                    onAction="#goToDocuments" maxWidth="Infinity">
                <graphic>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="📄" styleClass="menu-icon"/>
                        <Label text="Mes documents" styleClass="menu-text"/>
                    </HBox>
                </graphic>
            </Button>

            <!-- ══════════════════════════════════════════════════════════
                 SECTION: FINANCE
            ══════════════════════════════════════════════════════════ -->
            <Region styleClass="menu-divider"/>
            <Label text="FINANCE" styleClass="section-title"/>

            <Button fx:id="btnProduitsFinanciers" styleClass="sidebar-menu-item"
                    onAction="#goToProduitsFinanciers" maxWidth="Infinity">
                <graphic>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="💰" styleClass="menu-icon"/>
                        <Label text="Produits Financiers" styleClass="menu-text"/>
                    </HBox>
                </graphic>
            </Button>

            <Button fx:id="btnOffresFinancieres" styleClass="sidebar-menu-item"
                    onAction="#goToOffresFinancieres" maxWidth="Infinity">
                <graphic>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="📋" styleClass="menu-icon"/>
                        <Label text="Offres Financières" styleClass="menu-text"/>
                    </HBox>
                </graphic>
            </Button>

            <Button fx:id="btnDemandeFinancement" styleClass="sidebar-menu-item"
                    onAction="#goToDemandeFinancement" maxWidth="Infinity">
                <graphic>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="💳" styleClass="menu-icon"/>
                        <Label text="Demande Financement" styleClass="menu-text"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="NOUVEAU" styleClass="new-badge"/>
                    </HBox>
                </graphic>
            </Button>

            <Button fx:id="btnAccueilProduits" styleClass="sidebar-menu-item"
                    onAction="#goToAccueilProduits" maxWidth="Infinity">
                <graphic>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="🏪" styleClass="menu-icon"/>
                        <Label text="Accueil Produits" styleClass="menu-text"/>
                    </HBox>
                </graphic>
            </Button>

            <!-- ══════════════════════════════════════════════════════════
                 SECTION: AGRICULTURE
            ══════════════════════════════════════════════════════════ -->
            <Region styleClass="menu-divider"/>
            <Label text="AGRICULTURE" styleClass="section-title"/>

            <Button fx:id="btnProjetsAgricoles" styleClass="sidebar-menu-item"
                    onAction="#goToProjetsAgricoles" maxWidth="Infinity">
                <graphic>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="🌾" styleClass="menu-icon"/>
                        <Label text="Mes Projets" styleClass="menu-text"/>
                    </HBox>
                </graphic>
            </Button>

            <Button fx:id="btnRessources" styleClass="sidebar-menu-item"
                    onAction="#goToRessources" maxWidth="Infinity">
                <graphic>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="🌿" styleClass="menu-icon"/>
                        <Label text="Ressources" styleClass="menu-text"/>
                    </HBox>
                </graphic>
            </Button>

            <!-- ══════════════════════════════════════════════════════════
                 SECTION: IoT & SURVEILLANCE
            ══════════════════════════════════════════════════════════ -->
            <Region styleClass="menu-divider"/>
            <Label text="IoT &amp; SURVEILLANCE" styleClass="section-title"/>

            <Button fx:id="btnCapteurs" styleClass="sidebar-menu-item"
                    onAction="#goToCapteurs" maxWidth="Infinity">
                <graphic>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="📡" styleClass="menu-icon"/>
                        <Label text="Mes Capteurs" styleClass="menu-text"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Circle radius="5" styleClass="live-indicator"/>
                    </HBox>
                </graphic>
            </Button>

            <Button fx:id="btnMeteo" styleClass="sidebar-menu-item"
                    onAction="#goToMeteo" maxWidth="Infinity">
                <graphic>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="🌤️" styleClass="menu-icon"/>
                        <Label text="Météo" styleClass="menu-text"/>
                    </HBox>
                </graphic>
            </Button>

            <Button fx:id="btnRapports" styleClass="sidebar-menu-item"
                    onAction="#goToRapports" maxWidth="Infinity">
                <graphic>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="📝" styleClass="menu-icon"/>
                        <Label text="Rapports" styleClass="menu-text"/>
                    </HBox>
                </graphic>
            </Button>

            <!-- ══════════════════════════════════════════════════════════
                 SECTION: COMMUNICATION
            ══════════════════════════════════════════════════════════ -->
            <Region styleClass="menu-divider"/>
            <Label text="COMMUNICATION" styleClass="section-title"/>

            <Button fx:id="btnMessagerie" styleClass="sidebar-menu-item"
                    onAction="#goToMessagerie" maxWidth="Infinity">
                <graphic>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="💬" styleClass="menu-icon"/>
                        <Label text="Messagerie" styleClass="menu-text"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="2" styleClass="notification-badge"/>
                    </HBox>
                </graphic>
            </Button>

            <!-- ══════════════════════════════════════════════════════════
                 SECTION: OUTILS
            ══════════════════════════════════════════════════════════ -->
            <Region styleClass="menu-divider"/>
            <Label text="OUTILS" styleClass="section-title"/>
            <Button fx:id="btnChatbot" styleClass="sidebar-menu-item"
                    onAction="#goToChatbot" maxWidth="Infinity">
                <graphic>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="🤖" styleClass="menu-icon"/>
                        <Label text="Assistant IA" styleClass="menu-text"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="BETA" styleClass="beta-badge"/>
                    </HBox>
                </graphic>
            </Button>

            <!-- ══════════════════════════════════════════════════════════
                 SECTION: COMPTE
            ══════════════════════════════════════════════════════════ -->
            <Region styleClass="menu-divider"/>
            <Label text="COMPTE" styleClass="section-title"/>

            <Button fx:id="btnSecurity" styleClass="sidebar-menu-item"
                    onAction="#goToSecurity" maxWidth="Infinity">
                <graphic>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="🔐" styleClass="menu-icon"/>
                        <Label text="Sécurité" styleClass="menu-text"/>
                    </HBox>
                </graphic>
            </Button>

            <Button fx:id="btnLogout" styleClass="sidebar-logout"
                    onAction="#handleLogout" maxWidth="Infinity">
                <graphic>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="🚪" styleClass="menu-icon"/>
                        <Label text="Déconnexion" styleClass="menu-text"/>
                    </HBox>
                </graphic>
            </Button>

        </VBox>
    </ScrollPane>

    <!-- ═══════════════════════════════════════════════════════════════════
         FOOTER - VERSION & STATUS
    ═══════════════════════════════════════════════════════════════════ -->
    <HBox styleClass="sidebar-footer" alignment="CENTER" spacing="8">
        <Label text="🌱" style="-fx-font-size: 12px;"/>
        <Label text="AgriFund v2.0" styleClass="footer-text"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Circle radius="4" styleClass="connection-dot"/>
        <Label text="Connecté" styleClass="footer-text"/>
    </HBox>

</VBox>