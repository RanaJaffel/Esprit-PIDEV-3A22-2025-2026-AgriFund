<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.*?>

<VBox prefHeight="720.0" prefWidth="520.0" spacing="0" stylesheets="@../stylerayen.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.agrifund.controller.agriculteur.projectagriculteurcontroller"
      style="-fx-background-color: #F8FAF8;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: linear-gradient(to right, #9A951F, #E1B323, #B2D944); -fx-padding: 22 28;">
        <effect>
            <DropShadow color="rgba(154,149,31,0.3)" offsetY="3" radius="8"/>
        </effect>
        <StackPane style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 12; -fx-min-width: 52; -fx-min-height: 52;">
            <Label text="✏️" style="-fx-font-size: 28px;"/>
        </StackPane>
        <VBox spacing="3">
            <Label text="Modifier le Projet" style="-fx-text-fill: #133D03; -fx-font-size: 22px; -fx-font-weight: bold;"/>
            <Label text="Mettre à jour les informations" style="-fx-text-fill: rgba(19,61,3,0.8); -fx-font-size: 13px;"/>
        </VBox>
    </HBox>

    <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
        <VBox spacing="28" styleClass="form-container">
            <padding>
                <Insets top="30" right="35" bottom="30" left="35"/>
            </padding>

            <!-- Informations de Base -->
            <VBox spacing="18" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;
                                      -fx-border-color: rgba(178,217,68,0.3); -fx-border-radius: 12; -fx-border-width: 1;
                                      -fx-effect: dropshadow(three-pass-box, rgba(7,106,57,0.08), 8, 0, 0, 2);">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="📋" style="-fx-font-size: 20px;"/>
                    <Label text="Informations de Base" styleClass="section-header"/>
                </HBox>
                <Separator/>

                <GridPane hgap="15" vgap="18">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="32"/>
                        <ColumnConstraints percentWidth="68"/>
                    </columnConstraints>

                    <Label text="Nom du Projet *" style="-fx-font-weight: bold; -fx-text-fill: #076A39;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="tfNomProjectDialog" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Surface (Ha) *" style="-fx-font-weight: bold; -fx-text-fill: #076A39;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <HBox spacing="10" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <TextField fx:id="tfSurfaceDialog" HBox.hgrow="ALWAYS"/>
                        <Label text="Ha" style="-fx-font-weight: bold; -fx-text-fill: #089647; -fx-font-size: 14px;"/>
                    </HBox>
                </GridPane>
            </VBox>

            <!-- Informations Financières -->
            <VBox spacing="18" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;
                                      -fx-border-color: rgba(225,179,35,0.3); -fx-border-radius: 12; -fx-border-width: 1;
                                      -fx-effect: dropshadow(three-pass-box, rgba(225,179,35,0.08), 8, 0, 0, 2);">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="💰" style="-fx-font-size: 20px;"/>
                    <Label text="Informations Financières" styleClass="section-header" style="-fx-text-fill: #9A951F;"/>
                </HBox>
                <Separator/>

                <GridPane hgap="15" vgap="18">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="32"/>
                        <ColumnConstraints percentWidth="68"/>
                    </columnConstraints>

                    <Label text="Budget Demandé *" style="-fx-font-weight: bold; -fx-text-fill: #9A951F;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <HBox spacing="10" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <TextField fx:id="tfBudgetDialog" HBox.hgrow="ALWAYS"/>
                        <Label text="DT" style="-fx-font-weight: bold; -fx-text-fill: #E1B323; -fx-font-size: 14px;"/>
                    </HBox>
                </GridPane>
            </VBox>

            <!-- Statut et Calendrier -->
            <VBox spacing="18" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;
                                      -fx-border-color: rgba(178,217,68,0.3); -fx-border-radius: 12; -fx-border-width: 1;
                                      -fx-effect: dropshadow(three-pass-box, rgba(7,106,57,0.08), 8, 0, 0, 2);">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="📊" style="-fx-font-size: 20px;"/>
                    <Label text="Statut et Calendrier" styleClass="section-header"/>
                </HBox>
                <Separator/>

                <GridPane hgap="15" vgap="18">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="32"/>
                        <ColumnConstraints percentWidth="68"/>
                    </columnConstraints>

                    <Label text="Statut Actuel" style="-fx-font-weight: bold; -fx-text-fill: #076A39;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label fx:id="lblStatusBadge" text="⏳ En cours"/>
                        <Label text="(Modifié automatiquement par les décisions financières)"
                               style="-fx-font-size: 10px; -fx-text-fill: #848A86; -fx-font-style: italic;"/>
                    </VBox>

                    <Label text="Date de Soumission *" style="-fx-font-weight: bold; -fx-text-fill: #076A39;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <DatePicker fx:id="dpDateSoumissionDialog" maxWidth="Infinity"
                                GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                </GridPane>
            </VBox>

            <!-- Localisation -->
            <VBox spacing="18" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;
                                      -fx-border-color: rgba(71,108,26,0.3); -fx-border-radius: 12; -fx-border-width: 1;
                                      -fx-effect: dropshadow(three-pass-box, rgba(71,108,26,0.08), 8, 0, 0, 2);">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="📍" style="-fx-font-size: 20px;"/>
                    <Label text="Localisation du Projet" styleClass="section-header" style="-fx-text-fill: #476C1A;"/>
                </HBox>
                <Separator/>

                <GridPane hgap="15" vgap="14">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="32"/>
                        <ColumnConstraints percentWidth="68"/>
                    </columnConstraints>

                    <Label text="Latitude" style="-fx-font-weight: bold; -fx-text-fill: #476C1A;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="tfLatitudeDialog" editable="false"
                               GridPane.columnIndex="1" GridPane.rowIndex="0"
                               style="-fx-background-color: rgba(178,217,68,0.1); -fx-text-fill: #076A39; -fx-font-weight: bold;"/>

                    <Label text="Longitude" style="-fx-font-weight: bold; -fx-text-fill: #476C1A;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="tfLongitudeDialog" editable="false"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"
                               style="-fx-background-color: rgba(178,217,68,0.1); -fx-text-fill: #076A39; -fx-font-weight: bold;"/>

                    <Label text="" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <Button fx:id="btnOpenMap" text="🗺  Modifier sur la carte"
                                onAction="#handleOpenMap" prefHeight="42" maxWidth="Infinity"
                                style="-fx-background-color: linear-gradient(to right, #476C1A, #095032);
                                       -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-font-size: 13px;"/>
                        <Label fx:id="lblLocationStatus" text="⚠ Localisation non définie"
                               style="-fx-text-fill: #848A86; -fx-font-size: 11px;"/>
                    </VBox>
                </GridPane>
            </VBox>

            <!-- Buttons -->
            <HBox spacing="15" alignment="CENTER_RIGHT">
                <padding>
                    <Insets top="15"/>
                </padding>
                <Button text="✖ Annuler" onAction="#handleCancel" prefWidth="140" prefHeight="44" styleClass="btn-danger"/>
                <Button fx:id="btnSave" text="💾 Sauvegarder" onAction="#handleSave" prefWidth="180" prefHeight="44" styleClass="btn-secondary"/>
            </HBox>
        </VBox>
    </ScrollPane>
</VBox>
