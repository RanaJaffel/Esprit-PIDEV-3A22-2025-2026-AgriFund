<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.*?>

<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.agrifund.controller.agriculteur.projectagriculteurcontroller"
      stylesheets="@../stylerayen.css" style="-fx-background-color: #F8FAF8;">

    <!-- SIDEBAR (Full Height) -->
    <fx:include source="agriculteur-sidebar.fxml"/>

    <!-- MAIN CONTENT -->
    <BorderPane HBox.hgrow="ALWAYS">

        <top>
            <VBox spacing="0">
                <!-- Header -->
                <HBox alignment="CENTER" spacing="20" styleClass="page-header">
                    <padding>
                        <Insets top="20" right="30" bottom="20" left="30"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="15" HBox.hgrow="ALWAYS">
                        <StackPane styleClass="icon-container" style="-fx-min-width: 55; -fx-min-height: 55;">
                            <Label text="🌿" style="-fx-font-size: 32px;"/>
                        </StackPane>
                        <VBox spacing="2">
                            <Label text="Mes Projets Agricoles" styleClass="header-title"/>
                            <Label fx:id="lblUserName" text="Gérez vos projets et financements"
                                   style="-fx-text-fill: #B2D944; -fx-font-size: 13px;"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="10">
                        <Button text="📄 Exporter PDF" styleClass="btn-secondary"
                                onAction="#exportToPDF" prefHeight="40" prefWidth="150"/>
                    </HBox>
                </HBox>

                <!-- Toolbar -->
                <HBox alignment="CENTER_LEFT" spacing="15" styleClass="toolbar">
                    <padding>
                        <Insets top="15" right="30" bottom="15" left="30"/>
                    </padding>

                    <VBox spacing="3">
                        <Label text="🌾 Mes Projets" styleClass="subtitle-label"/>
                        <Label text="Gérez vos projets agricoles" style="-fx-text-fill: #848A86; -fx-font-size: 12px;"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <HBox alignment="CENTER_LEFT" spacing="8"
                          style="-fx-background-color: #F8FAF8; -fx-background-radius: 20; -fx-padding: 8 16;
                                 -fx-border-color: #B2D944; -fx-border-radius: 20; -fx-border-width: 1;">
                        <Label text="🔍" style="-fx-font-size: 16px;"/>
                        <TextField fx:id="tfSearchProject" promptText="Rechercher..."
                                   prefWidth="200" style="-fx-background-color: transparent; -fx-border-width: 0;"/>
                    </HBox>

                    <ComboBox fx:id="cbFilterStatutList" promptText="Filtrer par statut" prefWidth="160"
                              style="-fx-background-radius: 20; -fx-border-radius: 20;"/>

                    <Button text="+ Nouveau Projet" styleClass="btn-primary"
                            onAction="#openAddProjectForm" prefHeight="40" prefWidth="180"/>

                    <Button text="🗺 Carte" styleClass="btn-info"
                            onAction="#handleShowAllProjectsMap" prefHeight="40" prefWidth="100"/>

                    <Button text="📰 Actualités" styleClass="btn-info"
                            onAction="#openNewsDialog" prefHeight="40" prefWidth="110"/>
                </HBox>
            </VBox>
        </top>

        <center>
            <VBox spacing="0" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="25" right="30" bottom="25" left="30"/>
                </padding>

                <!-- Statistics -->
                <VBox spacing="15">
                    <padding>
                        <Insets bottom="20"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📊" style="-fx-font-size: 20px;"/>
                        <Label text="Mes Statistiques" styleClass="section-header"/>
                    </HBox>

                    <HBox spacing="20">
                        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <StackPane style="-fx-min-width: 50; -fx-min-height: 50; -fx-background-color: rgba(178,217,68,0.2); -fx-background-radius: 12;">
                                <Label text="📁" style="-fx-font-size: 24px;"/>
                            </StackPane>
                            <VBox spacing="4">
                                <Label text="Total Projets" styleClass="stat-label"/>
                                <Label fx:id="lblTotalProjects" text="--" styleClass="stat-value"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <StackPane style="-fx-min-width: 50; -fx-min-height: 50; -fx-background-color: rgba(8,150,71,0.15); -fx-background-radius: 12;">
                                <Label text="✓" style="-fx-font-size: 28px; -fx-text-fill: #089647; -fx-font-weight: bold;"/>
                            </StackPane>
                            <VBox spacing="4">
                                <Label text="Acceptés" styleClass="stat-label"/>
                                <Label fx:id="lblAcceptedProjects" text="--" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #089647;"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <StackPane style="-fx-min-width: 50; -fx-min-height: 50; -fx-background-color: rgba(225,179,35,0.2); -fx-background-radius: 12;">
                                <Label text="⏳" style="-fx-font-size: 24px;"/>
                            </StackPane>
                            <VBox spacing="4">
                                <Label text="En Cours" styleClass="stat-label"/>
                                <Label fx:id="lblInProgressProjects" text="--" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #E1B323;"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <StackPane style="-fx-min-width: 50; -fx-min-height: 50; -fx-background-color: rgba(198,40,40,0.1); -fx-background-radius: 12;">
                                <Label text="✗" style="-fx-font-size: 28px; -fx-text-fill: #C62828; -fx-font-weight: bold;"/>
                            </StackPane>
                            <VBox spacing="4">
                                <Label text="Refusés" styleClass="stat-label"/>
                                <Label fx:id="lblRefusedProjects" text="--" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #C62828;"/>
                            </VBox>
                        </HBox>
                    </HBox>
                </VBox>

                <Separator style="-fx-padding: 10 0;"/>

                <!-- Projects List -->
                <VBox spacing="15" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📋" style="-fx-font-size: 18px;"/>
                        <Label text="Liste des Projets" styleClass="section-header"/>
                    </HBox>

                    <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
                        <FlowPane fx:id="projectsContainer" hgap="20" vgap="20"
                                  style="-fx-padding: 5;"/>
                    </ScrollPane>
                </VBox>
            </VBox>
        </center>

        <bottom>
            <HBox alignment="CENTER" spacing="40"
                  style="-fx-background-color: white; -fx-padding: 15 30;
                         -fx-border-color: #B2D944; -fx-border-width: 2 0 0 0;">
                <HBox spacing="10" alignment="CENTER">
                    <Label text="💰" style="-fx-font-size: 18px;"/>
                    <VBox spacing="0">
                        <Label text="Budget Total" style="-fx-font-size: 11px; -fx-text-fill: #848A86;"/>
                        <Label fx:id="lblTotalBudget" text="-- DT" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #076A39;"/>
                    </VBox>
                </HBox>

                <Separator orientation="VERTICAL"/>

                <HBox spacing="10" alignment="CENTER">
                    <Label text="🌍" style="-fx-font-size: 18px;"/>
                    <VBox spacing="0">
                        <Label text="Surface Totale" style="-fx-font-size: 11px; -fx-text-fill: #848A86;"/>
                        <Label fx:id="lblTotalSurface" text="-- Ha" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #076A39;"/>
                    </VBox>
                </HBox>

                <Separator orientation="VERTICAL"/>

                <HBox spacing="10" alignment="CENTER">
                    <Label text="📅" style="-fx-font-size: 18px;"/>
                    <VBox spacing="0">
                        <Label text="Dernière Mise à Jour" style="-fx-font-size: 11px; -fx-text-fill: #848A86;"/>
                        <Label fx:id="lblLastUpdate" text="Aujourd'hui" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #076A39;"/>
                    </VBox>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
        </bottom>

    </BorderPane>
</HBox>
