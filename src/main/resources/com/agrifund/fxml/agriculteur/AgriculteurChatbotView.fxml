<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/17"
            fx:controller="com.agrifund.controller.agriculteur.AgriculteurChatbotController"
            style="-fx-background-color: #095032;">

    <!-- ========== HEADER ========== -->
    <top>
        <VBox spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="15"
                  style="-fx-background-color: linear-gradient(to right, #076A39, #089647); -fx-padding: 15 20;">
                <Button text="← Retour" onAction="#handleRetour"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-padding: 8 18; -fx-background-radius: 15; -fx-cursor: hand; -fx-font-size: 12;"/>
                <VBox spacing="3">
                    <Label text="🤖 Assistant AgriFund"
                           style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;"/>
                    <Label fx:id="lblStatus" text="En ligne - Propulsé par Gemini AI"
                           style="-fx-text-fill: #B2D944; -fx-font-size: 12;"/>
                </VBox>
                <HBox HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnClearChat" text="🗑️ Effacer"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 12; -fx-background-radius: 15; -fx-padding: 6 15; -fx-cursor: hand;"
                        onAction="#handleClearChat"/>
            </HBox>
        </VBox>
    </top>

    <!-- ========== CHAT AREA ========== -->
    <center>
        <VBox spacing="0" VBox.vgrow="ALWAYS">
            <!-- Suggestions -->
            <ScrollPane fitToHeight="true" hbarPolicy="NEVER"
                        style="-fx-background: #0a5d3a; -fx-background-color: #0a5d3a;">
                <HBox fx:id="suggestionsBox" alignment="CENTER" spacing="8"
                      style="-fx-background-color: #0a5d3a; -fx-padding: 12 15;">
                    <Button text="💰 Produits financiers" onAction="#handleSuggestionProduits"
                            style="-fx-background-color: rgba(178,217,68,0.2); -fx-text-fill: #B2D944;
                                   -fx-font-size: 11; -fx-background-radius: 15; -fx-padding: 6 12;
                                   -fx-cursor: hand; -fx-border-color: #B2D944; -fx-border-radius: 15;"/>
                    <Button text="📊 Offres disponibles" onAction="#handleSuggestionOffres"
                            style="-fx-background-color: rgba(178,217,68,0.2); -fx-text-fill: #B2D944;
                                   -fx-font-size: 11; -fx-background-radius: 15; -fx-padding: 6 12;
                                   -fx-cursor: hand; -fx-border-color: #B2D944; -fx-border-radius: 15;"/>
                    <Button text="🚜 Conseils agricoles" onAction="#handleSuggestionConseils"
                            style="-fx-background-color: rgba(178,217,68,0.2); -fx-text-fill: #B2D944;
                                   -fx-font-size: 11; -fx-background-radius: 15; -fx-padding: 6 12;
                                   -fx-cursor: hand; -fx-border-color: #B2D944; -fx-border-radius: 15;"/>
                    <Button text="📝 Comment demander" onAction="#handleSuggestionDemande"
                            style="-fx-background-color: rgba(178,217,68,0.2); -fx-text-fill: #B2D944;
                                   -fx-font-size: 11; -fx-background-radius: 15; -fx-padding: 6 12;
                                   -fx-cursor: hand; -fx-border-color: #B2D944; -fx-border-radius: 15;"/>
                    <Button text="📈 Meilleurs taux" onAction="#handleSuggestionTaux"
                            style="-fx-background-color: rgba(178,217,68,0.2); -fx-text-fill: #B2D944;
                                   -fx-font-size: 11; -fx-background-radius: 15; -fx-padding: 6 12;
                                   -fx-cursor: hand; -fx-border-color: #B2D944; -fx-border-radius: 15;"/>
                    <Button text="📋 Conditions prêt" onAction="#handleSuggestionConditions"
                            style="-fx-background-color: rgba(178,217,68,0.2); -fx-text-fill: #B2D944;
                                   -fx-font-size: 11; -fx-background-radius: 15; -fx-padding: 6 12;
                                   -fx-cursor: hand; -fx-border-color: #B2D944; -fx-border-radius: 15;"/>
                </HBox>
            </ScrollPane>

            <!-- Messages -->
            <ScrollPane fx:id="scrollPane" fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background: #095032; -fx-background-color: #095032; -fx-border-color: transparent;">
                <VBox fx:id="chatContainer" spacing="10"
                      style="-fx-background-color: #095032; -fx-padding: 15;"/>
            </ScrollPane>
        </VBox>
    </center>

    <!-- ========== INPUT AREA ========== -->
    <bottom>
        <VBox spacing="0">
            <!-- Typing indicator -->
            <HBox fx:id="typingIndicator" alignment="CENTER_LEFT" spacing="8" visible="false" managed="false"
                  style="-fx-padding: 8 20; -fx-background-color: #0a5d3a;">
                <Label text="🤖 L'assistant écrit..."
                       style="-fx-text-fill: #B2D944; -fx-font-size: 11; -fx-font-style: italic;"/>
            </HBox>

            <!-- Input -->
            <HBox alignment="CENTER" spacing="12"
                  style="-fx-background-color: linear-gradient(to right, #076A39, #089647); -fx-padding: 15 20;">
                <TextField fx:id="txtMessage" promptText="Posez votre question sur le financement agricole..."
                           HBox.hgrow="ALWAYS"
                           style="-fx-pref-height: 45; -fx-padding: 12 18; -fx-background-radius: 22;
                                  -fx-border-radius: 22; -fx-font-size: 13; -fx-background-color: white;
                                  -fx-border-color: #B2D944; -fx-border-width: 2;"/>
                <Button fx:id="btnSend" text="Envoyer ➤" onAction="#handleSendMessage"
                        style="-fx-background-color: #B2D944; -fx-text-fill: #076A39; -fx-font-weight: bold;
                               -fx-font-size: 13; -fx-padding: 12 28; -fx-background-radius: 22; -fx-cursor: hand;"/>
            </HBox>

            <!-- Quick navigation -->
            <HBox alignment="CENTER" spacing="20"
                  style="-fx-background-color: #064d2e; -fx-padding: 10 15;">
                <Button text="📦 Produits" onAction="#goToProduits"
                        style="-fx-background-color: transparent; -fx-text-fill: #6a9a7a;
                               -fx-font-size: 11; -fx-cursor: hand;"/>
                <Label text="•" style="-fx-text-fill: #3d6b4a;"/>
                <Button text="🎁 Offres" onAction="#goToOffres"
                        style="-fx-background-color: transparent; -fx-text-fill: #6a9a7a;
                               -fx-font-size: 11; -fx-cursor: hand;"/>
                <Label text="•" style="-fx-text-fill: #3d6b4a;"/>
                <Label text="Limité au contexte AgriFund - Financement Agricole"
                       style="-fx-text-fill: #4d7a5a; -fx-font-size: 10;"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>