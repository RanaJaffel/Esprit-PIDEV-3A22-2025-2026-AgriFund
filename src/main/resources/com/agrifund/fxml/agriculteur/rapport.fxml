<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.agrifund.controller.RapportJournalierController"
            prefWidth="1450"
            prefHeight="800"
            stylesheets="/com/agrifund/fxml/stylerane.css">

    <!-- ========== SIDEBAR GAUCHE ========== -->
    <left>
        <fx:include source="/com/agrifund/fxml/agriculteur/agriculteur-sidebar.fxml"/>
    </left>

    <!-- ========== CONTENU PRINCIPAL ========== -->
    <center>
        <VBox spacing="20">

            <Label text="Rapports Journaliers" styleClass="title"/>

            <TableView fx:id="tableRapport" prefHeight="400" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colDate" text="Date"/>
                    <TableColumn fx:id="colType" text="Type"/>
                    <TableColumn fx:id="colMoy" text="Moyenne"/>
                    <TableColumn fx:id="colMin" text="Min"/>
                    <TableColumn fx:id="colMax" text="Max"/>
                    <TableColumn fx:id="colCapteur" text="Capteur"/>
                </columns>
            </TableView>

        </VBox>
    </center>

</BorderPane>
