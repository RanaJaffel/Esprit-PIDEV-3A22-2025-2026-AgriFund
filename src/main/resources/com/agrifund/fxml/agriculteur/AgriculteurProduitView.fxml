<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.*?>

<HBox xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/17"
      fx:controller="com.agrifund.controller.agriculteur.AgriculteurProduitController"
      style="-fx-background-color: #f5f7f5;">

    <!-- ========== SIDEBAR (Full Height) ========== -->
    <fx:include source="agriculteur-sidebar.fxml"/>

    <!-- ========== MAIN CONTENT AREA ========== -->
    <BorderPane HBox.hgrow="ALWAYS">

        <!-- ========== HEADER ========== -->
        <top>
            <VBox spacing="0">
                <HBox alignment="CENTER_LEFT" spacing="20"
                      style="-fx-background-color: linear-gradient(to right, #133D03, #095032, #076A39); -fx-padding: 20 30;">
                    <VBox spacing="3">
                        <Label text="📦 Produits Financiers"
                               style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;">
                            <effect>
                                <DropShadow color="#133D03" offsetY="2" radius="4"/>
                            </effect>
                        </Label>
                        <Label text="Explorez tous les produits de financement disponibles"
                               style="-fx-text-fill: #B2D944; -fx-font-size: 13;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblStatus" text="Chargement..."
                           style="-fx-text-fill: #B2D944; -fx-font-size: 12; -fx-font-weight: bold;"/>
                </HBox>

                <!-- Stats Bar -->
                <HBox alignment="CENTER" spacing="30"
                      style="-fx-background-color: white; -fx-padding: 15;
                             -fx-border-color: #B2D944; -fx-border-width: 0 0 2 0;">
                    <HBox spacing="8" alignment="CENTER">
                        <Label text="📦" style="-fx-font-size: 18;"/>
                        <Label fx:id="lblTotalProduits" text="0" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #076A39;"/>
                        <Label text="Total" style="-fx-text-fill: #848A86; -fx-font-size: 11;"/>
                    </HBox>
                    <Separator orientation="VERTICAL"/>
                    <HBox spacing="8" alignment="CENTER">
                        <Label text="🏦" style="-fx-font-size: 18;"/>
                        <Label fx:id="lblPrets" text="0" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #089647;"/>
                        <Label text="Prêts" style="-fx-text-fill: #848A86; -fx-font-size: 11;"/>
                    </HBox>
                    <Separator orientation="VERTICAL"/>
                    <HBox spacing="8" alignment="CENTER">
                        <Label text="💳" style="-fx-font-size: 18;"/>
                        <Label fx:id="lblCredits" text="0" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #E1B323;"/>
                        <Label text="Crédits" style="-fx-text-fill: #848A86; -fx-font-size: 11;"/>
                    </HBox>
                    <Separator orientation="VERTICAL"/>
                    <HBox spacing="8" alignment="CENTER">
                        <Label text="📋" style="-fx-font-size: 18;"/>
                        <Label fx:id="lblAutres" text="0" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #476C1A;"/>
                        <Label text="Autres" style="-fx-text-fill: #848A86; -fx-font-size: 11;"/>
                    </HBox>
                </HBox>
            </VBox>
        </top>

        <!-- ========== MAIN CONTENT ========== -->
        <center>
            <VBox spacing="20" style="-fx-padding: 20;">
                <!-- Search Bar -->
                <HBox spacing="15" alignment="CENTER"
                      style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 15;
                             -fx-border-color: #089647; -fx-border-width: 2; -fx-border-radius: 15;">
                    <effect>
                        <DropShadow color="#089647" offsetY="3" radius="8" spread="0.1"/>
                    </effect>

                    <Label text="🔍" style="-fx-font-size: 18;"/>
                    <TextField fx:id="txtRecherche" promptText="Rechercher un produit, type, banque..."
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color: #f5f7f5; -fx-background-radius: 10; -fx-padding: 12;
                                      -fx-border-color: transparent; -fx-font-size: 13;"/>
                    <ComboBox fx:id="cmbTypeFinancement" promptText="Type"
                              style="-fx-pref-width: 180; -fx-font-size: 12;"/>
                    <Button text="Rechercher" onAction="#handleRechercher"
                            style="-fx-background-color: linear-gradient(to right, #076A39, #089647);
                                   -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 25;
                                   -fx-background-radius: 10; -fx-cursor: hand;"/>
                    <Button text="↻" onAction="#handleRafraichir"
                            style="-fx-background-color: #E8F5E9; -fx-text-fill: #076A39; -fx-font-weight: bold;
                                   -fx-padding: 12 15; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-size: 14;"/>
                </HBox>

                <!-- Products Header -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="📦 Produits Disponibles"
                           style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #076A39;"/>
                    <Label fx:id="lblNombreProduits" text="(0)"
                           style="-fx-text-fill: #089647; -fx-font-size: 14; -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="💡 Cliquez sur un produit pour voir les détails"
                           style="-fx-text-fill: #848A86; -fx-font-size: 11;"/>
                </HBox>

                <!-- Products Grid -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background: transparent; -fx-background-color: transparent;">
                    <FlowPane fx:id="containerProduits" hgap="20" vgap="20"
                              style="-fx-padding: 10 0;"/>
                </ScrollPane>
            </VBox>
        </center>

    </BorderPane>

</HBox>
