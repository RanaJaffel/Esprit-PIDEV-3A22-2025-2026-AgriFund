<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.agrifund.controller.agriculteur.AgriculteurRessourceController"
      stylesheets="@../stylerayen.css" style="-fx-background-color: #F8F9FA;">

    <!-- SIDEBAR (Full Height) -->
    <fx:include source="agriculteur-sidebar.fxml"/>

    <!-- MAIN CONTENT -->
    <BorderPane HBox.hgrow="ALWAYS">

        <top>
            <VBox spacing="0">
                <!-- Header -->
                <HBox alignment="CENTER_LEFT" spacing="20" styleClass="page-header">
                    <padding><Insets top="18" right="30" bottom="18" left="30"/></padding>

                    <HBox alignment="CENTER" spacing="12">
                        <Label text="📦" style="-fx-font-size: 32px;"/>
                        <VBox spacing="0">
                            <Label text="Mes Ressources" styleClass="header-title" style="-fx-font-size: 26px;"/>
                            <Label text="Gérez les ressources de vos projets agricoles"
                                   style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 13px;"/>
                        </VBox>
                    </HBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="+ Nouvelle Ressource" styleClass="btn-primary"
                            onAction="#openAddResourceForm" prefHeight="40" prefWidth="180"/>
                </HBox>

                <!-- Toolbar -->
                <HBox alignment="CENTER_LEFT" spacing="15" styleClass="toolbar">
                    <padding><Insets top="15" right="30" bottom="15" left="30"/></padding>

                    <HBox alignment="CENTER_LEFT" spacing="8"
                          style="-fx-background-color: #F8F9FA; -fx-background-radius: 20; -fx-padding: 8 16;">
                        <Label text="🔍" style="-fx-font-size: 16px;"/>
                        <TextField fx:id="tfSearchRessource" promptText="Rechercher..." prefWidth="200"
                                   style="-fx-background-color: transparent; -fx-border-width: 0;"/>
                    </HBox>

                    <ComboBox fx:id="cbFilterType" promptText="Type" prefWidth="150"/>
                    <ComboBox fx:id="cbFilterProjet" promptText="Projet" prefWidth="200"/>
                </HBox>
            </VBox>
        </top>

        <center>
            <VBox spacing="0" VBox.vgrow="ALWAYS">
                <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>

                <!-- Statistics Cards -->
                <HBox spacing="20" alignment="CENTER_LEFT">
                    <padding><Insets bottom="20"/></padding>

                    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <StackPane style="-fx-min-width: 50; -fx-min-height: 50; -fx-background-color: #D8F3DC; -fx-background-radius: 10;">
                            <Label text="📊" style="-fx-font-size: 24px;"/>
                        </StackPane>
                        <VBox spacing="4">
                            <Label text="Total" style="-fx-text-fill: #666; -fx-font-size: 12px;"/>
                            <Label fx:id="lblTotalRessources" text="--" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <StackPane style="-fx-min-width: 50; -fx-min-height: 50; -fx-background-color: #FFE5CC; -fx-background-radius: 10;">
                            <Label text="🚜" style="-fx-font-size: 24px;"/>
                        </StackPane>
                        <VBox spacing="4">
                            <Label text="Équipements" style="-fx-text-fill: #666; -fx-font-size: 12px;"/>
                            <Label fx:id="lblEquipments" text="--" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #876c00;"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <StackPane style="-fx-min-width: 50; -fx-min-height: 50; -fx-background-color: #E5F4FF; -fx-background-radius: 10;">
                            <Label text="⚙" style="-fx-font-size: 24px;"/>
                        </StackPane>
                        <VBox spacing="4">
                            <Label text="Matériaux" style="-fx-text-fill: #666; -fx-font-size: 12px;"/>
                            <Label fx:id="lblMaterials" text="--" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0a371d;"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <StackPane style="-fx-min-width: 50; -fx-min-height: 50; -fx-background-color: #E8F5E9; -fx-background-radius: 10;">
                            <Label text="💰" style="-fx-font-size: 24px;"/>
                        </StackPane>
                        <VBox spacing="4">
                            <Label text="Coût Total" style="-fx-text-fill: #666; -fx-font-size: 12px;"/>
                            <Label fx:id="lblCoutTotal" text="-- DT" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2D6A4F;"/>
                        </VBox>
                    </HBox>
                </HBox>

                <!-- Resources Grid -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background-color: transparent; -fx-border-width: 0;">
                    <FlowPane fx:id="ressourcesContainer" hgap="20" vgap="20"
                              style="-fx-padding: 5; -fx-background-color: transparent;"/>
                </ScrollPane>
            </VBox>
        </center>

    </BorderPane>

</HBox>