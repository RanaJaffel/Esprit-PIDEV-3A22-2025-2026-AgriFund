<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.agrifund.controller.ForgotPasswordController"
           stylesheets="@../css/forgot-password.css"
           prefWidth="900" prefHeight="750">

    <!-- Background avec gradient agricole -->
    <Pane styleClass="gradient-background"/>

    <!-- Formes décoratives -->
    <Pane mouseTransparent="true">
        <Circle layoutX="100" layoutY="120" radius="100" styleClass="floating-shape, shape-1"/>
        <Circle layoutX="800" layoutY="600" radius="120" styleClass="floating-shape, shape-2"/>
        <Rectangle layoutX="750" layoutY="100" width="80" height="80" arcWidth="20" arcHeight="20"
                   styleClass="floating-shape, shape-3" rotate="45"/>
        <Circle layoutX="150" layoutY="550" radius="70" styleClass="floating-shape, shape-4"/>
        <Rectangle layoutX="80" layoutY="350" width="50" height="50" arcWidth="15" arcHeight="15"
                   styleClass="floating-shape, shape-2" rotate="30"/>
        <Circle layoutX="850" layoutY="300" radius="50" styleClass="floating-shape, shape-1"/>
    </Pane>

    <!-- ScrollPane -->
    <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="transparent-scroll"
                hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">

        <VBox alignment="CENTER" spacing="0">
            <padding>
                <Insets top="50" right="50" bottom="50" left="50"/>
            </padding>

            <!-- Main Card -->
            <VBox fx:id="mainCard" styleClass="forgot-card" prefWidth="520" spacing="25" alignment="CENTER">
                <padding>
                    <Insets top="45" right="50" bottom="45" left="50"/>
                </padding>

                <!-- Header -->
                <VBox spacing="15" alignment="CENTER">
                    <StackPane styleClass="header-icon-container">
                        <Label fx:id="headerIcon" text="🔐" styleClass="header-icon"/>
                    </StackPane>
                    <Label fx:id="headerTitle" text="Mot de passe oublié ?" styleClass="header-title"/>
                    <Label fx:id="headerSubtitle" text="Pas de panique ! Nous allons vous aider." styleClass="header-subtitle"/>
                </VBox>

                <!-- Progress Steps -->
                <HBox alignment="CENTER" spacing="0" styleClass="progress-container">
                    <!-- Step 1 -->
                    <StackPane fx:id="step1Indicator" styleClass="step-indicator, step-indicator-active" prefWidth="45" prefHeight="45">
                        <Label fx:id="step1Number" text="1" styleClass="step-number, step-number-active"/>
                    </StackPane>
                    <Pane fx:id="connector1" styleClass="step-connector" prefWidth="60"/>

                    <!-- Step 2 -->
                    <StackPane fx:id="step2Indicator" styleClass="step-indicator" prefWidth="45" prefHeight="45">
                        <Label fx:id="step2Number" text="2" styleClass="step-number"/>
                    </StackPane>
                    <Pane fx:id="connector2" styleClass="step-connector" prefWidth="60"/>

                    <!-- Step 3 -->
                    <StackPane fx:id="step3Indicator" styleClass="step-indicator" prefWidth="45" prefHeight="45">
                        <Label fx:id="step3Number" text="3" styleClass="step-number"/>
                    </StackPane>
                </HBox>

                <!-- Accent Line -->
                <HBox alignment="CENTER">
                    <HBox styleClass="accent-line" prefWidth="200"/>
                </HBox>

                <!-- Alert Box -->
                <HBox fx:id="alertBox" styleClass="alert-modern, alert-error" visible="false" managed="false"
                      spacing="12" alignment="CENTER_LEFT">
                    <Label text="⚠️" style="-fx-font-size: 18px;"/>
                    <Label fx:id="alertMessage" styleClass="alert-text" wrapText="true"/>
                </HBox>

                <!-- Success Box -->
                <HBox fx:id="successBox" styleClass="alert-modern, alert-success" visible="false" managed="false"
                      spacing="12" alignment="CENTER_LEFT">
                    <Label text="✅" style="-fx-font-size: 18px;"/>
                    <Label fx:id="successMessage" styleClass="alert-text" wrapText="true"/>
                </HBox>

                <!-- ==================== STEP 1: Email ==================== -->
                <VBox fx:id="step1Content" spacing="25" styleClass="step-content" alignment="CENTER">

                    <Label text="Entrez votre adresse email et nous vous enverrons un code de réinitialisation."
                           styleClass="step-description" wrapText="true" maxWidth="380"/>

                    <!-- Email Field -->
                    <VBox styleClass="input-group" spacing="10" maxWidth="400">
                        <Label text="Adresse email" styleClass="input-label"/>
                        <HBox fx:id="emailContainer" styleClass="input-container">
                            <Label text="📧" styleClass="input-icon"/>
                            <TextField fx:id="emailField" styleClass="input-field"
                                       promptText="votre@email.com" HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <Label fx:id="emailHint" text="" styleClass="field-hint" visible="false" managed="false"/>
                    </VBox>

                    <!-- Send Button -->
                    <Button fx:id="sendCodeBtn" text="📨 Envoyer le code" styleClass="btn-primary"
                            onAction="#handleSendCode" maxWidth="400"/>

                    <!-- Security Info -->
                    <HBox styleClass="security-info" spacing="10" alignment="CENTER" maxWidth="400">
                        <Label text="🔒" style="-fx-font-size: 16px;"/>
                        <Label text="Le code est valable pendant 15 minutes" styleClass="security-info-text"/>
                    </HBox>
                </VBox>

                <!-- ==================== STEP 2: Token + New Password ==================== -->
                <VBox fx:id="step2Content" spacing="20" styleClass="step-content" alignment="CENTER"
                      visible="false" managed="false">

                    <Label fx:id="step2Description"
                           text="Un code a été envoyé à votre email. Entrez-le avec votre nouveau mot de passe."
                           styleClass="step-description" wrapText="true" maxWidth="400"/>

                    <!-- Timer -->
                    <HBox alignment="CENTER">
                        <HBox styleClass="timer-container" spacing="8" alignment="CENTER">
                            <Label text="⏱️" style="-fx-font-size: 14px;"/>
                            <Label fx:id="timerLabel" text="Code expire dans: 15:00" styleClass="timer-text"/>
                        </HBox>
                    </HBox>

                    <!-- Token Field -->
                    <VBox styleClass="input-group" spacing="10" maxWidth="400">
                        <Label text="Code de réinitialisation" styleClass="input-label"/>
                        <HBox fx:id="tokenContainer" styleClass="token-input-container">
                            <Label text="🔑" styleClass="input-icon"/>
                            <TextField fx:id="tokenField" styleClass="token-input"
                                       promptText="Collez le code reçu" HBox.hgrow="ALWAYS"/>
                        </HBox>
                    </VBox>

                    <!-- New Password Field -->
                    <VBox styleClass="input-group" spacing="10" maxWidth="400">
                        <Label text="Nouveau mot de passe" styleClass="input-label"/>
                        <HBox fx:id="newPasswordContainer" styleClass="input-container">
                            <Label text="🔐" styleClass="input-icon"/>
                            <PasswordField fx:id="newPasswordField" styleClass="input-field"
                                           promptText="••••••••" HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <ProgressBar fx:id="passwordStrength" progress="0"
                                         styleClass="password-strength-bar"/>
                            <Label fx:id="passwordStrengthLabel" text="" styleClass="password-strength-label"/>
                        </HBox>
                    </VBox>

                    <!-- Confirm Password Field -->
                    <VBox styleClass="input-group" spacing="10" maxWidth="400">
                        <Label text="Confirmer le mot de passe" styleClass="input-label"/>
                        <HBox fx:id="confirmPasswordContainer" styleClass="input-container">
                            <Label text="🔐" styleClass="input-icon"/>
                            <PasswordField fx:id="confirmPasswordField" styleClass="input-field"
                                           promptText="••••••••" HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <Label fx:id="confirmHint" text="" styleClass="field-hint" visible="false" managed="false"/>
                    </VBox>

                    <!-- Reset Button -->
                    <Button fx:id="resetBtn" text="🔄 Réinitialiser le mot de passe" styleClass="btn-primary"
                            onAction="#handleResetPassword" maxWidth="400"/>

                    <!-- Resend Link -->
                    <HBox spacing="15" alignment="CENTER">
                        <Hyperlink text="🔁 Renvoyer le code" onAction="#handleResendCode" styleClass="link-primary"/>
                        <Label text="|" style="-fx-text-fill: #c8e6c9;"/>
                        <Hyperlink text="← Changer d'email" onAction="#goBackToStep1" styleClass="link-secondary"/>
                    </HBox>
                </VBox>

                <!-- ==================== STEP 3: Success ==================== -->
                <VBox fx:id="step3Content" spacing="25" styleClass="step-content" alignment="CENTER"
                      visible="false" managed="false">

                    <StackPane styleClass="success-icon-container">
                        <Label text="✅" styleClass="success-icon"/>
                    </StackPane>

                    <VBox spacing="10" alignment="CENTER">
                        <Label text="Mot de passe réinitialisé !" styleClass="success-title"/>
                        <Label text="Vous pouvez maintenant vous connecter avec votre nouveau mot de passe."
                               styleClass="success-subtitle" wrapText="true" maxWidth="350"/>
                    </VBox>

                    <!-- Confetti animation placeholder -->
                    <HBox spacing="10" alignment="CENTER">
                        <Label text="🎉" style="-fx-font-size: 30px;"/>
                        <Label text="🎊" style="-fx-font-size: 30px;"/>
                        <Label text="🎉" style="-fx-font-size: 30px;"/>
                    </HBox>

                    <Button text="🚀 Se connecter" styleClass="btn-success"
                            onAction="#goToLogin" maxWidth="400"/>
                </VBox>

                <!-- Back Link -->
                <HBox alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                    <Hyperlink text="← Retour à la connexion" onAction="#goToLogin" styleClass="link-secondary"/>
                </HBox>
            </VBox>
        </VBox>
    </ScrollPane>
</StackPane>