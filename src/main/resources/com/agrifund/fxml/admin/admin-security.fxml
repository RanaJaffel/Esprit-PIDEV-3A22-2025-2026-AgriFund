<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.agrifund.controller.admin.AdminSecurityController"
            stylesheets="@../../css/styles.css">

    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox styleClass="content-area" spacing="30">
                <!-- Header -->
                <HBox alignment="CENTER">
                    <VBox HBox.hgrow="ALWAYS">
                        <Label text="🔐 Paramètres de Sécurité" styleClass="page-title"/>
                        <Label text="Gérer l'authentification à deux facteurs et la sécurité de votre compte" styleClass="page-subtitle"/>
                    </VBox>
                </HBox>

                <!-- 2FA Card -->
                <VBox styleClass="card" spacing="20">
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Authentification à Deux Facteurs (2FA)" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                            <Label text="Ajoutez une couche de sécurité supplémentaire à votre compte" style="-fx-text-fill: #848A86;"/>
                        </VBox>

                        <HBox fx:id="statusBadge" alignment="CENTER" spacing="10">
                            <!-- Rempli dynamiquement -->
                        </HBox>
                    </HBox>

                    <Separator/>

                    <!-- 2FA Status -->
                    <VBox fx:id="twoFAStatus" spacing="15">
                        <!-- Rempli dynamiquement -->
                    </VBox>

                    <!-- 2FA Actions -->
                    <HBox spacing="15">
                        <Button fx:id="toggle2FAButton" text="Activer la 2FA" styleClass="btn, btn-primary" onAction="#toggle2FA"/>
                        <Button fx:id="test2FAButton" text="🧪 Tester" styleClass="btn, btn-secondary" onAction="#test2FA"/>
                    </HBox>
                </VBox>

                <!-- 2FA Method Card -->
                <VBox fx:id="methodCard" styleClass="card" spacing="20" visible="false" managed="false">
                    <Label text="Méthode de vérification" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                    <VBox spacing="15">
                        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 15; -fx-background-color: rgba(8, 150, 71, 0.1); -fx-background-radius: 8;">
                            <RadioButton fx:id="emailMethod" text="📧 Email" toggleGroup="$methodGroup" selected="true"/>
                            <Label text="Recevoir les codes par email" style="-fx-text-fill: #848A86;"/>
                        </HBox>

                        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 15; -fx-background-color: #f8f9fa; -fx-background-radius: 8;">
                            <RadioButton fx:id="smsMethod" text="📱 SMS" toggleGroup="$methodGroup"/>
                            <Label text="Recevoir les codes par SMS (bientôt disponible)" style="-fx-text-fill: #848A86;"/>
                        </HBox>
                    </VBox>

                    <fx:define>
                        <ToggleGroup fx:id="methodGroup"/>
                    </fx:define>
                </VBox>

                <!-- Login History Card -->
                <VBox styleClass="card" spacing="20">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="📊 Historique des connexions" style="-fx-font-size: 18px; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
                        <Button text="🔄 Actualiser" styleClass="btn, btn-secondary, btn-small" onAction="#refreshHistory"/>
                    </HBox>

                    <TableView fx:id="historyTable" prefHeight="250">
                        <columns>
                            <TableColumn fx:id="colDate" text="Date" prefWidth="180"/>
                            <TableColumn fx:id="colStatus" text="Statut" prefWidth="120"/>
                            <TableColumn fx:id="colMethod" text="Méthode" prefWidth="150"/>
                        </columns>
                        <placeholder>
                            <Label text="Aucun historique disponible"/>
                        </placeholder>
                    </TableView>
                </VBox>

                <!-- Security Tips -->
                <VBox styleClass="card" spacing="15" style="-fx-background-color: rgba(8, 150, 71, 0.05);">
                    <Label text="💡 Conseils de sécurité" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #089647;"/>

                    <VBox spacing="10">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="✓" style="-fx-text-fill: #089647; -fx-font-weight: bold;"/>
                            <Label text="Utilisez un mot de passe unique et complexe"  style="-fx-text-fill: #ecc500"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="✓" style="-fx-text-fill: #089647; -fx-font-weight: bold;"/>
                            <Label text="Activez l'authentification à deux facteurs"  style="-fx-text-fill: #ecc500"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="✓" style="-fx-text-fill: #089647; -fx-font-weight: bold;"/>
                            <Label text="Ne partagez jamais vos codes de vérification"  style="-fx-text-fill: #ecc500"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="✓" style="-fx-text-fill: #089647; -fx-font-weight: bold;"/>
                            <Label text="Déconnectez-vous des appareils non utilisés" style="-fx-text-fill: #ecc500"/>
                        </HBox>
                    </VBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>