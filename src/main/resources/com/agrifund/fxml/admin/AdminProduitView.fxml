<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.agrifund.controller.admin.AdminProduitController"
            stylesheets="@../../css/styles.css">

    <!-- SIDEBAR -->
    <left>
        <fx:include source="admin-sidebar.fxml"/>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="0" style="-fx-background-color: #f8faf8;">

            <!-- ========== HEADER ========== -->
            <HBox alignment="CENTER_LEFT" spacing="20"
                  style="-fx-background-color: linear-gradient(to right, #089647, #076A39, #095032); -fx-padding: 25;">
                <VBox spacing="3">
                    <Label text="📦 Gestion des Produits"
                           style="-fx-text-fill: white; -fx-font-size: 26; -fx-font-weight: bold;">
                        <effect>
                            <DropShadow color="rgba(0,0,0,0.3)" offsetY="2" radius="5"/>
                        </effect>
                    </Label>
                    <Label text="Tous les produits financiers de la plateforme"
                           style="-fx-text-fill: #B2D944; -fx-font-size: 13;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="10" alignment="CENTER">
                    <Circle radius="8" fill="#B2D944"/>
                    <Label fx:id="lblCount" text="0 produits"
                           style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;
                                  -fx-background-color: rgba(255,255,255,0.15); -fx-padding: 8 18;
                                  -fx-background-radius: 20;"/>
                </HBox>
            </HBox>

            <!-- ========== BARRE D'OUTILS ========== -->
            <HBox alignment="CENTER_LEFT" spacing="15"
                  style="-fx-background-color: white; -fx-padding: 18;
                         -fx-border-color: #e0e5e0; -fx-border-width: 0 0 1 0;">

                <Label text="🔍" style="-fx-font-size: 18;"/>
                <TextField fx:id="txtRecherche" promptText="Rechercher un produit, type ou banque..." prefWidth="380"
                           style="-fx-background-color: #f5f7f5; -fx-background-radius: 25; -fx-padding: 12 22;
                                  -fx-border-color: #089647; -fx-border-radius: 25; -fx-border-width: 2; -fx-font-size: 13;"/>

                <Button text="Rechercher" onAction="#handleRechercher"
                        style="-fx-background-color: linear-gradient(to bottom, #089647, #076A39);
                               -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-padding: 12 28; -fx-background-radius: 25; -fx-cursor: hand;">
                    <effect>
                        <DropShadow color="rgba(8, 150, 71, 0.4)" offsetY="3" radius="8"/>
                    </effect>
                </Button>

                <Button text="↻ Actualiser" onAction="#handleActualiser"
                        style="-fx-background-color: white; -fx-text-fill: #089647; -fx-font-weight: bold;
                               -fx-padding: 12 22; -fx-background-radius: 25; -fx-cursor: hand;
                               -fx-border-color: #089647; -fx-border-radius: 25; -fx-border-width: 2;"/>

                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- ========== STATS ========== -->
            <HBox alignment="CENTER" spacing="25" style="-fx-padding: 25;">
                <!-- Total Produits -->
                <VBox alignment="CENTER" prefWidth="220"
                      style="-fx-background-color: linear-gradient(to bottom right, #089647, #076A39);
                             -fx-padding: 25; -fx-background-radius: 18;">
                    <effect>
                        <DropShadow color="rgba(8, 150, 71, 0.35)" offsetY="5" radius="12"/>
                    </effect>
                    <Label text="📦" style="-fx-font-size: 28;"/>
                    <Label fx:id="lblTotalProduits" text="0"
                           style="-fx-text-fill: white; -fx-font-size: 42; -fx-font-weight: bold;"/>
                    <Label text="Total Produits"
                           style="-fx-text-fill: #B2D944; -fx-font-size: 13; -fx-font-weight: bold;"/>
                </VBox>

                <!-- Info Box -->
                <VBox alignment="CENTER" prefWidth="650" spacing="8"
                      style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 18;
                             -fx-border-color: #e0e5e0; -fx-border-width: 1; -fx-border-radius: 18;">
                    <effect>
                        <DropShadow color="rgba(0,0,0,0.08)" offsetY="3" radius="10"/>
                    </effect>
                    <HBox spacing="10" alignment="CENTER">
                        <Label text="🌾" style="-fx-font-size: 24;"/>
                        <Label text="Vue Admin : Vous voyez TOUS les produits de TOUTES les banques"
                               style="-fx-text-fill: #133D03; -fx-font-size: 14; -fx-font-weight: bold;"/>
                    </HBox>
                    <Label text="Cliquez sur 'Voir Banque' pour afficher les détails de la banque propriétaire"
                           style="-fx-text-fill: #848A86; -fx-font-size: 12;"/>
                </VBox>
            </HBox>

            <!-- ========== TABLEAU ========== -->
            <VBox VBox.vgrow="ALWAYS" style="-fx-padding: 0 25 25 25;">
                <TableView fx:id="tableView" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: white; -fx-border-color: #089647;
                                  -fx-border-width: 2; -fx-border-radius: 15; -fx-background-radius: 15;">
                    <effect>
                        <DropShadow color="rgba(8, 150, 71, 0.15)" offsetY="4" radius="12"/>
                    </effect>
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="60" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colNom" text="Nom du Produit" prefWidth="220"/>
                        <TableColumn fx:id="colType" text="Type" prefWidth="130"/>
                        <TableColumn fx:id="colTaux" text="Taux %" prefWidth="90" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colPrixFixe" text="Min (DT)" prefWidth="110"/>
                        <TableColumn fx:id="colPrixFixe" text="Max (DT)" prefWidth="110"/>
                        <TableColumn fx:id="colBanque" text="🏦 Banque" prefWidth="180"/>
                    </columns>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="15" style="-fx-padding: 50;">
                            <Label text="📦" style="-fx-font-size: 48; -fx-opacity: 0.5;"/>
                            <Label text="Aucun produit dans la base de données"
                                   style="-fx-text-fill: #848A86; -fx-font-size: 16; -fx-font-weight: bold;"/>
                            <Label text="Les produits créés par les banques apparaîtront ici"
                                   style="-fx-text-fill: #a0a5a0; -fx-font-size: 13;"/>
                        </VBox>
                    </placeholder>
                </TableView>
            </VBox>

            <!-- ========== BOUTONS D'ACTION ========== -->
            <HBox alignment="CENTER" spacing="20" style="-fx-padding: 0 25 25 25;">
                <Button text="📋 VOIR DÉTAILS" onAction="#handleVoirDetails" prefWidth="180" prefHeight="50"
                        style="-fx-background-color: linear-gradient(to right, #089647, #076A39);
                               -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13;
                               -fx-background-radius: 25; -fx-cursor: hand;">
                    <effect>
                        <DropShadow color="rgba(8, 150, 71, 0.4)" offsetY="4" radius="10"/>
                    </effect>
                </Button>

                <Button text="🏦 VOIR BANQUE" onAction="#handleVoirBanque" prefWidth="180" prefHeight="50"
                        style="-fx-background-color: linear-gradient(to right, #476C1A, #133D03);
                               -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13;
                               -fx-background-radius: 25; -fx-cursor: hand;">
                    <effect>
                        <DropShadow color="rgba(71, 108, 26, 0.4)" offsetY="4" radius="10"/>
                    </effect>
                </Button>

                <Button text="📥 TÉLÉCHARGER PDF" onAction="#handleDownloadPDF" prefWidth="200" prefHeight="50"
                        style="-fx-background-color: linear-gradient(to right, #E1B323, #9A951F);
                               -fx-text-fill: #133D03; -fx-font-weight: bold; -fx-font-size: 13;
                               -fx-background-radius: 25; -fx-cursor: hand;">
                    <effect>
                        <DropShadow color="rgba(225, 179, 35, 0.4)" offsetY="4" radius="10"/>
                    </effect>
                </Button>
            </HBox>

            <!-- ========== FOOTER ========== -->
            <HBox alignment="CENTER" spacing="20"
                  style="-fx-background-color: linear-gradient(to right, #095032, #076A39, #095032); -fx-padding: 15;">
                <Label text="🛡️ Panel Admin - Gestion des Produits"
                       style="-fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: bold;"/>
                <Label text="•" style="-fx-text-fill: #B2D944;"/>
                <Label text="AgriFund 2025"
                       style="-fx-text-fill: #B2D944; -fx-font-size: 11;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
