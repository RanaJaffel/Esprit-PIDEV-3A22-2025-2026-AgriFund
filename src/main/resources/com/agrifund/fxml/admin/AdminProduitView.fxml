<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.shape.*?>

<VBox prefHeight="750" prefWidth="1300" spacing="0"
      style="-fx-background-color: linear-gradient(to bottom, #f5f5f5, #e8eaf6);"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.agrifund.controller.admin.AdminProduitController">

    <!-- ========== HEADER ========== -->
    <HBox alignment="CENTER_LEFT" spacing="20"
          style="-fx-background-color: linear-gradient(to right, #1a237e, #283593, #1a237e); -fx-padding: 25;">
        <Button text="← Retour" onAction="#handleRetour"
                style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 20; -fx-cursor: hand;"/>
        <VBox spacing="3">
            <Label text="📦 Gestion des Produits"
                   style="-fx-text-fill: white; -fx-font-size: 26; -fx-font-weight: bold;">
                <effect>
                    <DropShadow color="#000" offsetY="2" radius="5"/>
                </effect>
            </Label>
            <Label text="Tous les produits financiers de la plateforme"
                   style="-fx-text-fill: #9fa8da; -fx-font-size: 13;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Admin" style="-fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: bold;
               -fx-background-color: rgba(255,255,255,0.15); -fx-padding: 6 15; -fx-background-radius: 15;"/>
    </HBox>

    <!-- ========== BARRE D'OUTILS ========== -->
    <HBox alignment="CENTER_LEFT" spacing="15"
          style="-fx-background-color: white; -fx-padding: 15;
                 -fx-border-color: #c5cae9; -fx-border-width: 0 0 2 0;">

        <Label text="🔍" style="-fx-font-size: 18;"/>
        <TextField fx:id="txtRecherche" promptText="Rechercher un produit, type ou banque..." prefWidth="350"
                   style="-fx-background-color: #f5f5f5; -fx-background-radius: 20; -fx-padding: 12 20;
                          -fx-border-color: #1a237e; -fx-border-radius: 20; -fx-border-width: 2; -fx-font-size: 13;"/>

        <Button text="Rechercher" onAction="#handleRechercher"
                style="-fx-background-color: linear-gradient(to bottom, #1a237e, #283593);
                       -fx-text-fill: white; -fx-font-weight: bold;
                       -fx-padding: 12 25; -fx-background-radius: 20; -fx-cursor: hand;">
            <effect>
                <DropShadow color="#1a237e" offsetY="2" radius="5"/>
            </effect>
        </Button>

        <Button text="↻ Actualiser" onAction="#handleActualiser"
                style="-fx-background-color: #e8eaf6; -fx-text-fill: #1a237e; -fx-font-weight: bold;
                       -fx-padding: 12 20; -fx-background-radius: 20; -fx-cursor: hand;
                       -fx-border-color: #1a237e; -fx-border-radius: 20; -fx-border-width: 2;"/>

        <Region HBox.hgrow="ALWAYS"/>

        <HBox spacing="8" alignment="CENTER">
            <Circle radius="6" fill="#4CAF50"/>
            <Label fx:id="lblCount" text="0 produits"
                   style="-fx-text-fill: #1a237e; -fx-font-weight: bold; -fx-font-size: 12;"/>
        </HBox>
    </HBox>

    <!-- ========== STATS ========== -->
    <HBox alignment="CENTER" spacing="20" style="-fx-padding: 20;">
        <VBox alignment="CENTER" prefWidth="200"
              style="-fx-background-color: linear-gradient(to bottom, #1565C0, #0D47A1);
                     -fx-padding: 20; -fx-background-radius: 15;">
            <effect>
                <DropShadow color="#0D47A1" offsetY="4" radius="10"/>
            </effect>
            <Label fx:id="lblTotalProduits" text="0"
                   style="-fx-text-fill: white; -fx-font-size: 36; -fx-font-weight: bold;"/>
            <Label text="Total Produits"
                   style="-fx-text-fill: #90CAF9; -fx-font-size: 12; -fx-font-weight: bold;"/>
        </VBox>

        <VBox alignment="CENTER" prefWidth="600"
              style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 15;
                     -fx-border-color: #c5cae9; -fx-border-width: 2; -fx-border-radius: 15;">
            <Label text="💡 Vue Admin : Vous voyez TOUS les produits de TOUTES les banques"
                   style="-fx-text-fill: #1a237e; -fx-font-size: 13; -fx-font-weight: bold;"/>
            <Label text="Cliquez sur 'Voir Banque' pour afficher les détails de la banque propriétaire"
                   style="-fx-text-fill: #666; -fx-font-size: 11;"/>
        </VBox>
    </HBox>

    <!-- ========== TABLEAU ========== -->
    <VBox VBox.vgrow="ALWAYS" style="-fx-padding: 0 20 20 20;">
        <TableView fx:id="tableView" VBox.vgrow="ALWAYS"
                   style="-fx-background-color: white; -fx-border-color: #1a237e;
                          -fx-border-width: 2; -fx-border-radius: 15; -fx-background-radius: 15;">
            <effect>
                <DropShadow color="#1a237e" offsetY="4" radius="10"/>
            </effect>
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="60" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colNom" text="Nom du Produit" prefWidth="220"/>
                <TableColumn fx:id="colType" text="Type" prefWidth="120"/>
                <TableColumn fx:id="colTaux" text="Taux %" prefWidth="80" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colMontantMin" text="Min (DT)" prefWidth="110"/>
                <TableColumn fx:id="colMontantMax" text="Max (DT)" prefWidth="110"/>
                <TableColumn fx:id="colBanque" text="🏦 Banque" prefWidth="180"/>
            </columns>
            <placeholder>
                <VBox alignment="CENTER" spacing="15" style="-fx-padding: 40;">
                    <Label text="Aucun produit dans la base de données"
                           style="-fx-text-fill: #1a237e; -fx-font-size: 16; -fx-font-weight: bold;"/>
                </VBox>
            </placeholder>
        </TableView>
    </VBox>

    <!-- ========== BOUTONS D'ACTION ========== -->
    <HBox alignment="CENTER" spacing="20" style="-fx-padding: 0 20 20 20;">
        <Button text="📋 VOIR DÉTAILS" onAction="#handleVoirDetails" prefWidth="180" prefHeight="50"
                style="-fx-background-color: linear-gradient(to right, #1a237e, #283593);
                       -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14;
                       -fx-background-radius: 25; -fx-cursor: hand;">
            <effect>
                <DropShadow color="#1a237e" offsetY="5" radius="12"/>
            </effect>
        </Button>

        <Button text="🏦 VOIR BANQUE" onAction="#handleVoirBanque" prefWidth="180" prefHeight="50"
                style="-fx-background-color: linear-gradient(to right, #7B1FA2, #8E24AA);
                       -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14;
                       -fx-background-radius: 25; -fx-cursor: hand;">
            <effect>
                <DropShadow color="#4A148C" offsetY="5" radius="12"/>
            </effect>
        </Button>

        <Button text="📥 TÉLÉCHARGER PDF" onAction="#handleDownloadPDF" prefWidth="200" prefHeight="50"
                style="-fx-background-color: linear-gradient(to right, #00796B, #00897B);
                       -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14;
                       -fx-background-radius: 25; -fx-cursor: hand;">
            <effect>
                <DropShadow color="#004D40" offsetY="5" radius="12"/>
            </effect>
        </Button>
    </HBox>

    <!-- ========== FOOTER ========== -->
    <HBox alignment="CENTER" spacing="20"
          style="-fx-background-color: linear-gradient(to right, #1a237e, #283593, #1a237e); -fx-padding: 15;">
        <Label text="🛡️ Panel Admin - Gestion des Produits"
               style="-fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: bold;"/>
        <Label text="AgriFund 2025"
               style="-fx-text-fill: #9fa8da; -fx-font-size: 11;"/>
    </HBox>
</VBox>