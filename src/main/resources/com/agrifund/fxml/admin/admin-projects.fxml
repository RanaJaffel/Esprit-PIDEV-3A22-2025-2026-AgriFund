<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.*?>

<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.agrifund.controller.admin.AdminProjectController"
      stylesheets="@../../css/styles.css"
      style="-fx-background-color: #f8faf8;">

    <!-- SIDEBAR - Prend toute la hauteur -->
    <fx:include source="admin-sidebar.fxml"/>

    <!-- MAIN CONTENT -->
    <VBox HBox.hgrow="ALWAYS" spacing="0" style="-fx-background-color: #f8faf8;">

        <!-- ========== HEADER ========== -->
        <HBox alignment="CENTER" spacing="20"
              style="-fx-background-color: linear-gradient(to right, #089647, #076A39, #095032); -fx-padding: 22 30;">
            <effect>
                <DropShadow color="rgba(8, 150, 71, 0.3)" offsetY="3" radius="10"/>
            </effect>

            <HBox alignment="CENTER_LEFT" spacing="15" HBox.hgrow="ALWAYS">
                <Label text="📋" style="-fx-font-size: 36px;"/>
                <VBox spacing="3">
                    <Label text="Gestion des Projets"
                           style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;">
                        <effect>
                            <DropShadow color="rgba(0,0,0,0.2)" offsetY="1" radius="3"/>
                        </effect>
                    </Label>
                    <Label text="Administration — Vue globale de tous les projets agricoles"
                           style="-fx-text-fill: #B2D944; -fx-font-size: 13px;"/>
                </VBox>
            </HBox>

            <HBox spacing="12">
                <Button text="🔄 Actualiser" onAction="#handleRefresh"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-padding: 10 22; -fx-background-radius: 10; -fx-cursor: hand;
                               -fx-border-color: rgba(255,255,255,0.3); -fx-border-radius: 10;"/>
                <Button text="📄 Exporter PDF" onAction="#exportToPDF"
                        style="-fx-background-color: #E1B323; -fx-text-fill: #133D03;
                               -fx-padding: 10 22; -fx-background-radius: 10; -fx-font-weight: bold; -fx-cursor: hand;">
                    <effect>
                        <DropShadow color="rgba(225, 179, 35, 0.4)" offsetY="2" radius="6"/>
                    </effect>
                </Button>
                <Button text="🗺 Carte" onAction="#handleShowAllProjectsMap"
                        style="-fx-background-color: #476C1A; -fx-text-fill: white;
                               -fx-padding: 10 22; -fx-background-radius: 10; -fx-cursor: hand;">
                    <effect>
                        <DropShadow color="rgba(71, 108, 26, 0.4)" offsetY="2" radius="6"/>
                    </effect>
                </Button>
            </HBox>
        </HBox>

        <!-- ========== TOOLBAR ========== -->
        <HBox alignment="CENTER_LEFT" spacing="15"
              style="-fx-background-color: white; -fx-padding: 18 30;
                     -fx-border-color: #e0e5e0; -fx-border-width: 0 0 1 0;">

            <HBox alignment="CENTER_LEFT" spacing="8"
                  style="-fx-background-color: #f5f7f5; -fx-background-radius: 25; -fx-padding: 10 18;
                         -fx-border-color: #089647; -fx-border-radius: 25; -fx-border-width: 2;">
                <Label text="🔍" style="-fx-font-size: 16px;"/>
                <TextField fx:id="tfSearchProject" promptText="Rechercher projet ou agriculteur..."
                           prefWidth="300" style="-fx-background-color: transparent; -fx-border-width: 0; -fx-font-size: 13px;"/>
            </HBox>

            <ComboBox fx:id="cbFilterStatut" promptText="Statut" prefWidth="160"
                      style="-fx-background-color: #f5f7f5; -fx-background-radius: 10;"/>
            <ComboBox fx:id="cbFilterAgriculteur" promptText="Agriculteur" prefWidth="200"
                      style="-fx-background-color: #f5f7f5; -fx-background-radius: 10;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Stats Cards -->
            <HBox spacing="15">
                <VBox alignment="CENTER"
                      style="-fx-background-color: linear-gradient(to bottom, #089647, #076A39);
                             -fx-padding: 10 18; -fx-background-radius: 12;">
                    <effect>
                        <DropShadow color="rgba(8, 150, 71, 0.25)" offsetY="2" radius="6"/>
                    </effect>
                    <Label text="Total" style="-fx-font-size: 10px; -fx-text-fill: #B2D944;"/>
                    <Label fx:id="lblTotalProjects" text="--"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                </VBox>
                <VBox alignment="CENTER"
                      style="-fx-background-color: linear-gradient(to bottom, #B2D944, #9A951F);
                             -fx-padding: 10 18; -fx-background-radius: 12;">
                    <effect>
                        <DropShadow color="rgba(178, 217, 68, 0.25)" offsetY="2" radius="6"/>
                    </effect>
                    <Label text="Acceptés" style="-fx-font-size: 10px; -fx-text-fill: #133D03;"/>
                    <Label fx:id="lblAcceptedProjects" text="--"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #133D03;"/>
                </VBox>
                <VBox alignment="CENTER"
                      style="-fx-background-color: linear-gradient(to bottom, #E1B323, #9A951F);
                             -fx-padding: 10 18; -fx-background-radius: 12;">
                    <effect>
                        <DropShadow color="rgba(225, 179, 35, 0.25)" offsetY="2" radius="6"/>
                    </effect>
                    <Label text="En cours" style="-fx-font-size: 10px; -fx-text-fill: #133D03;"/>
                    <Label fx:id="lblInProgressProjects" text="--"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #133D03;"/>
                </VBox>
                <VBox alignment="CENTER"
                      style="-fx-background-color: linear-gradient(to bottom, #848A86, #5a605a);
                             -fx-padding: 10 18; -fx-background-radius: 12;">
                    <effect>
                        <DropShadow color="rgba(132, 138, 134, 0.25)" offsetY="2" radius="6"/>
                    </effect>
                    <Label text="Refusés" style="-fx-font-size: 10px; -fx-text-fill: #e0e5e0;"/>
                    <Label fx:id="lblRefusedProjects" text="--"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                </VBox>
            </HBox>
        </HBox>

        <!-- ========== CONTENT ========== -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background-color: transparent; -fx-border-width: 0;">
            <FlowPane fx:id="projectsContainer" hgap="20" vgap="20" style="-fx-padding: 25;"/>
        </ScrollPane>

        <!-- ========== FOOTER ========== -->
        <HBox alignment="CENTER" spacing="50"
              style="-fx-background-color: linear-gradient(to right, #095032, #076A39, #095032); -fx-padding: 18 30;">
            <HBox spacing="12" alignment="CENTER">
                <Label text="💰" style="-fx-font-size: 22px;"/>
                <VBox spacing="2">
                    <Label text="Budget Total" style="-fx-font-size: 11px; -fx-text-fill: #B2D944;"/>
                    <Label fx:id="lblTotalBudget" text="-- DT"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                </VBox>
            </HBox>

            <Separator orientation="VERTICAL" style="-fx-background-color: rgba(255,255,255,0.3);"/>

            <HBox spacing="12" alignment="CENTER">
                <Label text="🌾" style="-fx-font-size: 22px;"/>
                <VBox spacing="2">
                    <Label text="Surface Totale" style="-fx-font-size: 11px; -fx-text-fill: #B2D944;"/>
                    <Label fx:id="lblTotalSurface" text="-- Ha"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                </VBox>
            </HBox>

            <Separator orientation="VERTICAL" style="-fx-background-color: rgba(255,255,255,0.3);"/>

            <HBox spacing="12" alignment="CENTER">
                <Label text="🕐" style="-fx-font-size: 22px;"/>
                <VBox spacing="2">
                    <Label text="Dernière MAJ" style="-fx-font-size: 11px; -fx-text-fill: #B2D944;"/>
                    <Label fx:id="lblLastUpdate" text="--"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                </VBox>
            </HBox>
        </HBox>
    </VBox>
</HBox>