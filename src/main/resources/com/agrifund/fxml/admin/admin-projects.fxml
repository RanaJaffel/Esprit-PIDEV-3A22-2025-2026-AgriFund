<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@../stylerayen.css" style="-fx-background-color: #F5F5F5;"
            prefWidth="1400" prefHeight="850"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.agrifund.controller.admin.AdminProjectController">

    <!-- SIDEBAR -->
    <left>
        <fx:include source="admin-sidebar.fxml"/>
    </left>

    <top>
        <VBox spacing="0">
            <!-- Header -->
            <HBox alignment="CENTER" spacing="20" style="-fx-background-color: linear-gradient(to right, #1B5E20, #2E7D32); -fx-padding: 20 30;">
                <HBox alignment="CENTER_LEFT" spacing="15" HBox.hgrow="ALWAYS">
                    <Label text="🛡️" style="-fx-font-size: 36px;"/>
                    <VBox spacing="2">
                        <Label text="Gestion des Projets" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Label text="Administration - Vue globale de tous les projets agricoles"
                               style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 13px;"/>
                    </VBox>
                </HBox>

                <HBox spacing="10">
                    <Button text="🔄 Actualiser" onAction="#handleRefresh"
                            style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 8;"/>
                    <Button text="📄 Exporter PDF" onAction="#exportToPDF"
                            style="-fx-background-color: white; -fx-text-fill: #1B5E20; -fx-padding: 10 20; -fx-background-radius: 8; -fx-font-weight: bold;"/>
                    <Button text="🗺 Carte" onAction="#handleShowAllProjectsMap"
                            style="-fx-background-color: #1565C0; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 8;"/>
                </HBox>
            </HBox>

            <!-- Toolbar -->
            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: white; -fx-padding: 15 30; -fx-border-color: #E0E0E0; -fx-border-width: 0 0 1 0;">
                <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-background-color: #F5F5F5; -fx-background-radius: 20; -fx-padding: 8 16;">
                    <Label text="🔍" style="-fx-font-size: 16px;"/>
                    <TextField fx:id="tfSearchProject" promptText="Rechercher projet ou agriculteur..."
                               prefWidth="280" style="-fx-background-color: transparent; -fx-border-width: 0;"/>
                </HBox>

                <ComboBox fx:id="cbFilterStatut" promptText="Statut" prefWidth="160"/>
                <ComboBox fx:id="cbFilterAgriculteur" promptText="Agriculteur" prefWidth="200"/>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Stats rapides -->
                <HBox spacing="20">
                    <VBox alignment="CENTER" style="-fx-background-color: #E8F5E9; -fx-padding: 8 15; -fx-background-radius: 8;">
                        <Label text="Total" style="-fx-font-size: 10px; -fx-text-fill: #666;"/>
                        <Label fx:id="lblTotalProjects" text="--" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"/>
                    </VBox>
                    <VBox alignment="CENTER" style="-fx-background-color: #C8E6C9; -fx-padding: 8 15; -fx-background-radius: 8;">
                        <Label text="Acceptés" style="-fx-font-size: 10px; -fx-text-fill: #666;"/>
                        <Label fx:id="lblAcceptedProjects" text="--" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1B5E20;"/>
                    </VBox>
                    <VBox alignment="CENTER" style="-fx-background-color: #FFF3E0; -fx-padding: 8 15; -fx-background-radius: 8;">
                        <Label text="En cours" style="-fx-font-size: 10px; -fx-text-fill: #666;"/>
                        <Label fx:id="lblInProgressProjects" text="--" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #E65100;"/>
                    </VBox>
                    <VBox alignment="CENTER" style="-fx-background-color: #FFEBEE; -fx-padding: 8 15; -fx-background-radius: 8;">
                        <Label text="Refusés" style="-fx-font-size: 10px; -fx-text-fill: #666;"/>
                        <Label fx:id="lblRefusedProjects" text="--" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #C62828;"/>
                    </VBox>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-width: 0;" VBox.vgrow="ALWAYS">
            <FlowPane fx:id="projectsContainer" hgap="20" vgap="20" style="-fx-padding: 25;"/>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="40" style="-fx-background-color: white; -fx-padding: 15 30; -fx-border-color: #E0E0E0; -fx-border-width: 1 0 0 0;">
            <HBox spacing="8" alignment="CENTER">
                <Label text="💰" style="-fx-font-size: 18px;"/>
                <VBox>
                    <Label text="Budget Total" style="-fx-font-size: 10px; -fx-text-fill: #666;"/>
                    <Label fx:id="lblTotalBudget" text="-- DT" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"/>
                </VBox>
            </HBox>
            <Separator orientation="VERTICAL"/>
            <HBox spacing="8" alignment="CENTER">
                <Label text="🌾" style="-fx-font-size: 18px;"/>
                <VBox>
                    <Label text="Surface Totale" style="-fx-font-size: 10px; -fx-text-fill: #666;"/>
                    <Label fx:id="lblTotalSurface" text="-- Ha" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"/>
                </VBox>
            </HBox>
            <Separator orientation="VERTICAL"/>
            <HBox spacing="8" alignment="CENTER">
                <Label text="🕐" style="-fx-font-size: 18px;"/>
                <VBox>
                    <Label text="Dernière MAJ" style="-fx-font-size: 10px; -fx-text-fill: #666;"/>
                    <Label fx:id="lblLastUpdate" text="--" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #666;"/>
                </VBox>
            </HBox>
        </HBox>
    </bottom>
</BorderPane>