<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.effect.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.agrifund.controller.admin.AdminDecisionListController"
      stylesheets="@../../css/styles.css"
      style="-fx-background-color: #f8faf8;">

    <!-- SIDEBAR - Prend toute la hauteur -->
    <fx:include source="admin-sidebar.fxml"/>

    <!-- MAIN CONTENT -->
    <VBox HBox.hgrow="ALWAYS" spacing="0" style="-fx-background-color: #f8faf8;">

        <!-- ========== HEADER ========== -->
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-background-color: linear-gradient(to right, #089647, #076A39, #095032); -fx-padding: 22 30;">
            <effect>
                <DropShadow color="rgba(8, 150, 71, 0.3)" offsetY="3" radius="10"/>
            </effect>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="📋" style="-fx-font-size: 36px;"/>
                <VBox spacing="3">
                    <Label text="Consultation - Décisions Financières"
                           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;">
                        <effect>
                            <DropShadow color="rgba(0,0,0,0.2)" offsetY="1" radius="3"/>
                        </effect>
                    </Label>
                    <Label text="Toutes les décisions prises par les banques partenaires"
                           style="-fx-text-fill: #B2D944; -fx-font-size: 13px;"/>
                </VBox>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox spacing="12" alignment="CENTER">
                <Label text="📖 Mode lecture seule"
                       style="-fx-text-fill: #E1B323; -fx-font-weight: bold; -fx-font-size: 13px;
                              -fx-background-color: rgba(225, 179, 35, 0.15); -fx-padding: 8 15;
                              -fx-background-radius: 20;"/>

                <Button text="📊 Voir Évaluations" onAction="#handleViewEvaluations"
                        style="-fx-background-color: #476C1A; -fx-text-fill: white;
                               -fx-padding: 10 22; -fx-background-radius: 10; -fx-font-weight: bold; -fx-cursor: hand;">
                    <effect>
                        <DropShadow color="rgba(71, 108, 26, 0.4)" offsetY="2" radius="6"/>
                    </effect>
                </Button>

                <Button text="📈 Statistiques" onAction="#handleExportStats"
                        style="-fx-background-color: #E1B323; -fx-text-fill: #133D03;
                               -fx-padding: 10 22; -fx-background-radius: 10; -fx-font-weight: bold; -fx-cursor: hand;">
                    <effect>
                        <DropShadow color="rgba(225, 179, 35, 0.4)" offsetY="2" radius="6"/>
                    </effect>
                </Button>
            </HBox>
        </HBox>

        <!-- ========== CONTENT ========== -->
        <VBox VBox.vgrow="ALWAYS" spacing="20">
            <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>

            <!-- Info Box -->
            <HBox alignment="CENTER_LEFT" spacing="15"
                  style="-fx-background-color: white; -fx-padding: 18; -fx-background-radius: 12;
                         -fx-border-color: #B2D944; -fx-border-radius: 12; -fx-border-width: 2;">
                <effect>
                    <DropShadow color="rgba(0,0,0,0.06)" offsetY="2" radius="8"/>
                </effect>
                <Label text="ℹ️" style="-fx-font-size: 28px;"/>
                <VBox spacing="4">
                    <Label text="Mode Administrateur - Consultation uniquement"
                           style="-fx-font-weight: bold; -fx-text-fill: #089647; -fx-font-size: 14px;"/>
                    <Label text="Vous pouvez visualiser toutes les décisions prises par l'ensemble des banques. Les modifications ne sont pas autorisées depuis cette interface."
                           style="-fx-text-fill: #848A86; -fx-font-size: 12px;" wrapText="true"/>
                </VBox>
            </HBox>

            <!-- Toolbar -->
            <HBox spacing="15" alignment="CENTER_LEFT"
                  style="-fx-background-color: white; -fx-padding: 15 20; -fx-background-radius: 12;
                         -fx-border-color: #e0e5e0; -fx-border-radius: 12; -fx-border-width: 1;">
                <effect>
                    <DropShadow color="rgba(0,0,0,0.05)" offsetY="2" radius="6"/>
                </effect>

                <HBox alignment="CENTER_LEFT" spacing="8"
                      style="-fx-background-color: #f5f7f5; -fx-background-radius: 25; -fx-padding: 10 18;
                             -fx-border-color: #089647; -fx-border-radius: 25; -fx-border-width: 2;">
                    <Label text="🔍" style="-fx-font-size: 16px;"/>
                    <TextField fx:id="tfSearch" promptText="Projet, banque, statut, justification..."
                               onKeyReleased="#handleSearch" prefWidth="400"
                               style="-fx-background-color: transparent; -fx-border-width: 0; -fx-font-size: 13px;"/>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="🔄 Rafraîchir" onAction="#handleRefresh"
                        style="-fx-background-color: linear-gradient(to bottom, #089647, #076A39);
                               -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-padding: 10 25; -fx-background-radius: 10; -fx-cursor: hand;">
                    <effect>
                        <DropShadow color="rgba(8, 150, 71, 0.3)" offsetY="2" radius="6"/>
                    </effect>
                </Button>
            </HBox>

            <!-- Table -->
            <TableView fx:id="tableDecisions" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: white; -fx-border-color: #089647;
                              -fx-border-width: 2; -fx-border-radius: 12; -fx-background-radius: 12;">
                <effect>
                    <DropShadow color="rgba(8, 150, 71, 0.12)" offsetY="3" radius="10"/>
                </effect>
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="colProjet" text="📁 Projet" prefWidth="180"/>
                    <TableColumn fx:id="colBanque" text="🏦 Banque" prefWidth="150"/>
                    <TableColumn fx:id="colStatut" text="📊 Statut" prefWidth="120"/>
                    <TableColumn fx:id="colJustification" text="📝 Justification" prefWidth="300"/>
                    <TableColumn fx:id="colDateDecision" text="📅 Date Décision" prefWidth="140"/>
                    <TableColumn fx:id="colIdEvaluation" text="ID Éval." prefWidth="80"/>
                </columns>
                <placeholder>
                    <VBox alignment="CENTER" spacing="15" style="-fx-padding: 50;">
                        <Label text="📋" style="-fx-font-size: 48; -fx-opacity: 0.5;"/>
                        <Label text="Aucune décision enregistrée"
                               style="-fx-text-fill: #848A86; -fx-font-size: 16; -fx-font-weight: bold;"/>
                        <Label text="Les décisions des banques apparaîtront ici"
                               style="-fx-text-fill: #a0a5a0; -fx-font-size: 13;"/>
                    </VBox>
                </placeholder>
            </TableView>

            <!-- Statistics Cards -->
            <HBox spacing="20" alignment="CENTER"
                  style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12;
                         -fx-border-color: #e0e5e0; -fx-border-radius: 12; -fx-border-width: 1;">
                <effect>
                    <DropShadow color="rgba(0,0,0,0.06)" offsetY="2" radius="8"/>
                </effect>

                <!-- Total -->
                <VBox spacing="5" alignment="CENTER" prefWidth="150"
                      style="-fx-background-color: linear-gradient(to bottom, #089647, #076A39);
                             -fx-padding: 18; -fx-background-radius: 12;">
                    <effect>
                        <DropShadow color="rgba(8, 150, 71, 0.3)" offsetY="2" radius="6"/>
                    </effect>
                    <Label text="📊 Total" style="-fx-text-fill: #B2D944; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                    <Label fx:id="lblTotal" text="0" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                </VBox>

                <Separator orientation="VERTICAL" style="-fx-background-color: #e0e5e0;"/>

                <!-- Approuvées -->
                <VBox spacing="5" alignment="CENTER" prefWidth="150"
                      style="-fx-background-color: rgba(178, 217, 68, 0.15);
                             -fx-padding: 18; -fx-background-radius: 12;
                             -fx-border-color: #B2D944; -fx-border-radius: 12; -fx-border-width: 1;">
                    <Label text="✅ Approuvées" style="-fx-text-fill: #476C1A; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                    <Label fx:id="lblApprouves" text="0" style="-fx-text-fill: #089647; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                </VBox>

                <Separator orientation="VERTICAL" style="-fx-background-color: #e0e5e0;"/>

                <!-- En attente -->
                <VBox spacing="5" alignment="CENTER" prefWidth="150"
                      style="-fx-background-color: rgba(225, 179, 35, 0.15);
                             -fx-padding: 18; -fx-background-radius: 12;
                             -fx-border-color: #E1B323; -fx-border-radius: 12; -fx-border-width: 1;">
                    <Label text="⏳ En attente" style="-fx-text-fill: #9A951F; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                    <Label fx:id="lblEnAttente" text="0" style="-fx-text-fill: #E1B323; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                </VBox>

                <Separator orientation="VERTICAL" style="-fx-background-color: #e0e5e0;"/>

                <!-- Rejetées -->
                <VBox spacing="5" alignment="CENTER" prefWidth="150"
                      style="-fx-background-color: rgba(220, 53, 69, 0.1);
                             -fx-padding: 18; -fx-background-radius: 12;
                             -fx-border-color: #dc3545; -fx-border-radius: 12; -fx-border-width: 1;">
                    <Label text="❌ Rejetées" style="-fx-text-fill: #c82333; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                    <Label fx:id="lblRejetes" text="0" style="-fx-text-fill: #dc3545; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- ========== FOOTER ========== -->
        <HBox alignment="CENTER_LEFT" spacing="15"
              style="-fx-background-color: linear-gradient(to right, #095032, #076A39, #095032); -fx-padding: 15 30;">
            <Label fx:id="lblStatus" text="Mode consultation"
                   style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="🛡️ Panel Admin - Décisions Financières"
                   style="-fx-text-fill: #B2D944; -fx-font-size: 12px;"/>
            <Label text="•" style="-fx-text-fill: #B2D944;"/>
            <Label text="AgriFund 2025"
                   style="-fx-text-fill: #B2D944; -fx-font-size: 11px;"/>
        </HBox>
    </VBox>
</HBox>
