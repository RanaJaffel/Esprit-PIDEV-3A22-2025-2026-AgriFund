<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.agrifund.controller.admin.AdminSidebarController"
      styleClass="sidebar"
      fx:id="sidebar"
      stylesheets="@/com/agrifund/fxml/admin/sidebar-style.css">

    <!-- HEADER - LOGO -->
    <VBox styleClass="sidebar-header" spacing="8" alignment="CENTER">
        <ImageView fitWidth="180" preserveRatio="true" smooth="true" cache="true">
            <image>
                <Image url="@/com/agrifund/images/logo.png"/>
            </image>
        </ImageView>
        <Label text="ADMINISTRATION" styleClass="admin-badge"/>
    </VBox>

    <!-- PROFIL UTILISATEUR -->
    <VBox styleClass="user-profile-widget" spacing="12" alignment="CENTER">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <StackPane>
            <Circle radius="38" styleClass="avatar-ring"/>
            <ImageView fx:id="userAvatar" fitWidth="70" fitHeight="70" preserveRatio="true"/>
            <Circle radius="8" styleClass="online-indicator" translateX="25" translateY="25"/>
        </StackPane>

        <Label fx:id="userName" text="Admin" styleClass="user-name"/>
        <Label text="Administrateur" styleClass="user-role"/>
    </VBox>

    <!-- MENU SCROLLABLE -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox spacing="2" style="-fx-padding: 5 0 20 0;">

            <!-- PRINCIPAL -->
            <Label text="PRINCIPAL" styleClass="sidebar-section-title"/>

            <Button fx:id="btnDashboard" text="  📊  Tableau de bord"
                    styleClass="sidebar-menu-item"
                    onAction="#goToDashboard" maxWidth="Infinity"/>

            <Button fx:id="btnUsers" text="  👥  Utilisateurs"
                    styleClass="sidebar-menu-item"
                    onAction="#goToUsers" maxWidth="Infinity"/>

            <Button fx:id="btnAgriculteurs" text="  🌾  Agriculteurs"
                    styleClass="sidebar-menu-item"
                    onAction="#goToAgriculteurs" maxWidth="Infinity"/>

            <Button fx:id="btnBanques" text="  🏦  Banques"
                    styleClass="sidebar-menu-item"
                    onAction="#goToBanques" maxWidth="Infinity"/>

            <!-- GESTION -->
            <Region styleClass="sidebar-separator" style="-fx-padding: 10 15;"/>
            <Label text="GESTION" styleClass="sidebar-section-title"/>

            <Button fx:id="btnDocuments" text="  📄  Documents"
                    styleClass="sidebar-menu-item"
                    onAction="#goToDocuments" maxWidth="Infinity"/>

            <Button fx:id="btnMessagerie" text="  💬  Messagerie"
                    styleClass="sidebar-menu-item"
                    onAction="#goToMessagerie" maxWidth="Infinity"/>

            <!-- FINANCE -->
            <Region styleClass="sidebar-separator" style="-fx-padding: 10 15;"/>
            <Label text="FINANCE" styleClass="sidebar-section-title"/>

            <Button fx:id="btnProduitsFinanciers" text="  💰  Produits Financiers"
                    styleClass="sidebar-menu-item"
                    onAction="#goToProduitsFinanciers" maxWidth="Infinity"/>

            <Button fx:id="btnOffresFinancieres" text="  📋  Offres Financières"
                    styleClass="sidebar-menu-item"
                    onAction="#goToOffresFinancieres" maxWidth="Infinity"/>

            <!-- AGRICULTURE -->
            <Region styleClass="sidebar-separator" style="-fx-padding: 10 15;"/>
            <Label text="AGRICULTURE" styleClass="sidebar-section-title"/>

            <Button fx:id="btnProjetsAgricoles" text="  🌱  Projets Agricoles"
                    styleClass="sidebar-menu-item"
                    onAction="#goToProjetsAgricoles" maxWidth="Infinity"/>

            <Button fx:id="btnRessources" text="  🌿  Ressources"
                    styleClass="sidebar-menu-item"
                    onAction="#goToRessources" maxWidth="Infinity"/>

            <!-- DÉCISIONS & RISQUES -->
            <Region styleClass="sidebar-separator" style="-fx-padding: 10 15;"/>
            <Label text="DÉCISIONS &amp; RISQUES" styleClass="sidebar-section-title"/>

            <Button fx:id="btnDecisions" text="  ⚖️  Décisions"
                    styleClass="sidebar-menu-item"
                    onAction="#goToDecisions" maxWidth="Infinity"/>

            <Button fx:id="btnRisques" text="  ⚠️  Risques"
                    styleClass="sidebar-menu-item"
                    onAction="#goToRisques" maxWidth="Infinity"/>

            <!-- IoT & RAPPORTS -->
            <Region styleClass="sidebar-separator" style="-fx-padding: 10 15;"/>
            <Label text="IoT &amp; RAPPORTS" styleClass="sidebar-section-title"/>

            <Button fx:id="btnCapteurs" text="  📡  Capteurs"
                    styleClass="sidebar-menu-item"
                    onAction="#goToCapteurs" maxWidth="Infinity"/>

            <Button fx:id="btnDashboardIoT" text="  📈  Dashboard IoT"
                    styleClass="sidebar-menu-item"
                    onAction="#goToDashboardIoT" maxWidth="Infinity"/>

            <Button fx:id="btnRapports" text="  📝  Rapports"
                    styleClass="sidebar-menu-item"
                    onAction="#goToRapports" maxWidth="Infinity"/>

            <Button fx:id="btnMeteo" text="  🌤️  Météo"
                    styleClass="sidebar-menu-item"
                    onAction="#goToMeteo" maxWidth="Infinity"/>
            <Button fx:id="btnCarte" styleClass="sidebar-menu-item"
                    onAction="#goToCarte" maxWidth="Infinity">
                <graphic>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="🗺️" styleClass="menu-icon"/>
                        <Label text="Carte Interactive" styleClass="menu-text"/>
                    </HBox>
                </graphic>
            </Button>


            <!-- COMPTE -->
            <Region styleClass="sidebar-separator" style="-fx-padding: 10 15;"/>
            <Label text="COMPTE" styleClass="sidebar-section-title"/>

            <Button fx:id="btnProfile" text="  👤  Mon profil"
                    styleClass="sidebar-menu-item"
                    onAction="#goToProfile" maxWidth="Infinity"/>

            <Button fx:id="btnSecurity" text="  🔐  Sécurité"
                    styleClass="sidebar-menu-item"
                    onAction="#goToSecurity" maxWidth="Infinity"/>

            <Button fx:id="btnLogout" text="  🚪  Déconnexion"
                    styleClass="sidebar-logout"
                    onAction="#handleLogout" maxWidth="Infinity"/>

        </VBox>
    </ScrollPane>

    <!-- FOOTER -->
    <HBox styleClass="sidebar-footer" alignment="CENTER" spacing="10">
        <Label text="AgriFund v2.0" styleClass="version-label"/>
        <Circle radius="3" style="-fx-fill: #B2D944;"/>
        <Label text="En ligne" styleClass="version-label"/>
    </HBox>

</VBox>