<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.*?>

<VBox spacing="0"
      style="-fx-background-color: #FFFFFF;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.agrifund.controller.admin.AdminDetailsProduitController">

    <!-- ========== CUSTOM TITLE BAR ========== -->
    <HBox fx:id="titleBar" alignment="CENTER_LEFT" spacing="10"
          style="-fx-background-color: linear-gradient(to right, #1a237e, #283593, #1a237e);
                 -fx-padding: 10 15;"
          onMousePressed="#handleTitleBarPressed"
          onMouseDragged="#handleTitleBarDragged">

        <Label text="🛡️" style="-fx-font-size: 18;"/>
        <Label fx:id="lblWindowTitle" text="Détails du Produit"
               style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="─" onAction="#handleMinimize"
                style="-fx-background-color: transparent; -fx-text-fill: white;
                       -fx-font-size: 12; -fx-font-weight: bold; -fx-padding: 5 12;
                       -fx-cursor: hand; -fx-background-radius: 3;"
                onMouseEntered="#onControlButtonHover" onMouseExited="#onControlButtonExit"/>

        <Button text="□" onAction="#handleMaximize"
                style="-fx-background-color: transparent; -fx-text-fill: white;
                       -fx-font-size: 12; -fx-font-weight: bold; -fx-padding: 5 12;
                       -fx-cursor: hand; -fx-background-radius: 3;"
                onMouseEntered="#onControlButtonHover" onMouseExited="#onControlButtonExit"/>

        <Button text="✕" onAction="#handleFermer"
                style="-fx-background-color: transparent; -fx-text-fill: white;
                       -fx-font-size: 12; -fx-font-weight: bold; -fx-padding: 5 12;
                       -fx-cursor: hand; -fx-background-radius: 3;"
                onMouseEntered="#onCloseButtonHover" onMouseExited="#onCloseButtonExit"/>
    </HBox>

    <!-- ========== MAIN CONTENT ========== -->
    <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent;">

        <VBox spacing="25"
              style="-fx-padding: 30; -fx-background-color: linear-gradient(to bottom, #FFFFFF, #e8eaf6, #c5cae9);">

            <!-- HEADER -->
            <VBox alignment="CENTER" spacing="10"
                  style="-fx-background-color: linear-gradient(to right, #1a237e, #283593, #1a237e);
                         -fx-padding: 25; -fx-background-radius: 20;">
                <effect>
                    <DropShadow color="#1a237e" offsetY="5" radius="15"/>
                </effect>

                <Label text="DÉTAILS DU PRODUIT FINANCIER"
                       style="-fx-text-fill: #FFFFFF; -fx-font-size: 24; -fx-font-weight: bold;"/>
                <Label fx:id="lblNomProduit" text="Nom du produit"
                       style="-fx-text-fill: #9fa8da; -fx-font-size: 18; -fx-font-weight: bold;"/>
            </VBox>

            <!-- INFORMATIONS PRODUIT -->
            <VBox spacing="20" style="-fx-background-color: #FFFFFF; -fx-padding: 25; -fx-background-radius: 15;
                                      -fx-border-color: #1a237e; -fx-border-width: 2; -fx-border-radius: 15;">
                <effect>
                    <DropShadow color="#1a237e" offsetY="5" radius="12"/>
                </effect>

                <Label text="📦 INFORMATIONS PRODUIT" style="-fx-text-fill: #1a237e; -fx-font-size: 16; -fx-font-weight: bold;"/>
                <Separator style="-fx-background-color: #c5cae9;"/>

                <HBox spacing="20">
                    <VBox spacing="8" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #e8eaf6; -fx-padding: 18; -fx-background-radius: 12;">
                        <Label text="🆔 Identifiant" style="-fx-text-fill: #1a237e; -fx-font-size: 12; -fx-font-weight: bold;"/>
                        <Label fx:id="lblId" text="#0" style="-fx-text-fill: #283593; -fx-font-size: 26; -fx-font-weight: bold;"/>
                    </VBox>

                    <VBox spacing="8" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #fff3e0; -fx-padding: 18; -fx-background-radius: 12;">
                        <Label text="🏷️ Type" style="-fx-text-fill: #e65100; -fx-font-size: 12; -fx-font-weight: bold;"/>
                        <Label fx:id="lblType" text="Type" style="-fx-text-fill: #bf360c; -fx-font-size: 20; -fx-font-weight: bold;"/>
                    </VBox>
                </HBox>

                <!-- TAUX -->
                <VBox spacing="10" alignment="CENTER"
                      style="-fx-background-color: linear-gradient(to right, #1a237e, #3949ab, #1a237e);
                             -fx-padding: 20; -fx-background-radius: 12;">
                    <Label text="💹 TAUX D'INTÉRÊT" style="-fx-text-fill: #9fa8da; -fx-font-size: 13; -fx-font-weight: bold;"/>
                    <Label fx:id="lblTaux" text="0.00 %" style="-fx-text-fill: white; -fx-font-size: 42; -fx-font-weight: bold;"/>
                </VBox>

                <!-- MONTANTS -->
                <HBox spacing="20">
                    <VBox spacing="10" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color: #e8f5e9; -fx-padding: 20; -fx-background-radius: 12;
                                 -fx-border-color: #4CAF50; -fx-border-width: 2; -fx-border-radius: 12;">
                        <Label text="💰 Montant Minimum" style="-fx-text-fill: #2E7D32; -fx-font-size: 12; -fx-font-weight: bold;"/>
                        <Label fx:id="lblMontantMin" text="0.00 DT" style="-fx-text-fill: #1B5E20; -fx-font-size: 22; -fx-font-weight: bold;"/>
                    </VBox>

                    <VBox spacing="10" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color: #fff8e1; -fx-padding: 20; -fx-background-radius: 12;
                                 -fx-border-color: #FFA000; -fx-border-width: 2; -fx-border-radius: 12;">
                        <Label text="💵 Montant Maximum" style="-fx-text-fill: #FF8F00; -fx-font-size: 12; -fx-font-weight: bold;"/>
                        <Label fx:id="lblMontantMax" text="0.00 DT" style="-fx-text-fill: #E65100; -fx-font-size: 22; -fx-font-weight: bold;"/>
                    </VBox>
                </HBox>

                <!-- REGLES -->
                <VBox spacing="10">
                    <Label text="📜 Règles Financières" style="-fx-text-fill: #1a237e; -fx-font-size: 13; -fx-font-weight: bold;"/>
                    <TextArea fx:id="txtRegles" wrapText="true" editable="false" prefHeight="80"
                              style="-fx-background-color: #f5f5f5; -fx-border-color: #1a237e;
                                     -fx-border-width: 2; -fx-border-radius: 10; -fx-background-radius: 10;
                                     -fx-font-size: 13; -fx-padding: 10;"/>
                </VBox>

                <!-- STATS -->
                <HBox spacing="20">
                    <VBox spacing="10" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color: #e8eaf6; -fx-padding: 20; -fx-background-radius: 12;">
                        <Label text="📊 Montant Moyen" style="-fx-text-fill: #1a237e; -fx-font-size: 12; -fx-font-weight: bold;"/>
                        <Label fx:id="lblMontantMoyen" text="0 DT" style="-fx-text-fill: #283593; -fx-font-size: 20; -fx-font-weight: bold;"/>
                    </VBox>

                    <VBox spacing="10" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color: #e8eaf6; -fx-padding: 20; -fx-background-radius: 12;">
                        <Label text="📈 Écart Min-Max" style="-fx-text-fill: #1a237e; -fx-font-size: 12; -fx-font-weight: bold;"/>
                        <Label fx:id="lblEcart" text="0 DT" style="-fx-text-fill: #283593; -fx-font-size: 20; -fx-font-weight: bold;"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- SECTION BANQUE -->
            <VBox fx:id="sectionBanque" spacing="15" style="-fx-background-color: #FFFFFF; -fx-padding: 25; -fx-background-radius: 15;
                                      -fx-border-color: #7B1FA2; -fx-border-width: 2; -fx-border-radius: 15;">
                <effect>
                    <DropShadow color="#7B1FA2" offsetY="5" radius="12"/>
                </effect>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="🏦" style="-fx-font-size: 24;"/>
                    <Label text="BANQUE PROPRIÉTAIRE" style="-fx-text-fill: #7B1FA2; -fx-font-size: 16; -fx-font-weight: bold;"/>
                </HBox>
                <Separator style="-fx-background-color: #E1BEE7;"/>

                <HBox spacing="20">
                    <VBox spacing="8" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #f3e5f5; -fx-padding: 15; -fx-background-radius: 10;">
                        <Label text="Nom de la Banque" style="-fx-text-fill: #7B1FA2; -fx-font-size: 11; -fx-font-weight: bold;"/>
                        <Label fx:id="lblBanqueNom" text="-" style="-fx-text-fill: #4A148C; -fx-font-size: 16; -fx-font-weight: bold;"/>
                    </VBox>

                    <VBox spacing="8" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #f3e5f5; -fx-padding: 15; -fx-background-radius: 10;">
                        <Label text="Code Banque" style="-fx-text-fill: #7B1FA2; -fx-font-size: 11; -fx-font-weight: bold;"/>
                        <Label fx:id="lblBanqueCode" text="-" style="-fx-text-fill: #4A148C; -fx-font-size: 16; -fx-font-weight: bold;"/>
                    </VBox>
                </HBox>

                <HBox spacing="20">
                    <VBox spacing="8" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #f3e5f5; -fx-padding: 15; -fx-background-radius: 10;">
                        <Label text="Représentant Légal" style="-fx-text-fill: #7B1FA2; -fx-font-size: 11; -fx-font-weight: bold;"/>
                        <Label fx:id="lblBanqueRepresentant" text="-" style="-fx-text-fill: #4A148C; -fx-font-size: 14;"/>
                    </VBox>

                    <VBox spacing="8" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #f3e5f5; -fx-padding: 15; -fx-background-radius: 10;">
                        <Label text="Siège" style="-fx-text-fill: #7B1FA2; -fx-font-size: 11; -fx-font-weight: bold;"/>
                        <Label fx:id="lblBanqueSiege" text="-" style="-fx-text-fill: #4A148C; -fx-font-size: 14;"/>
                    </VBox>
                </HBox>

                <HBox spacing="20">
                    <VBox spacing="8" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #f3e5f5; -fx-padding: 15; -fx-background-radius: 10;">
                        <Label text="Site Web" style="-fx-text-fill: #7B1FA2; -fx-font-size: 11; -fx-font-weight: bold;"/>
                        <Label fx:id="lblBanqueSiteWeb" text="-" style="-fx-text-fill: #4A148C; -fx-font-size: 14;"/>
                    </VBox>

                    <VBox spacing="8" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #f3e5f5; -fx-padding: 15; -fx-background-radius: 10;">
                        <Label text="Statut du Compte" style="-fx-text-fill: #7B1FA2; -fx-font-size: 11; -fx-font-weight: bold;"/>
                        <Label fx:id="lblBanqueStatut" text="-" style="-fx-text-fill: #4A148C; -fx-font-size: 14; -fx-font-weight: bold;"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- BOUTONS -->
            <HBox spacing="20" alignment="CENTER">
                <Button text="TÉLÉCHARGER PDF" onAction="#handleTelechargerPDF"
                        prefWidth="200" prefHeight="50"
                        style="-fx-background-color: linear-gradient(to right, #7E57C2, #5E35B1);
                               -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14;
                               -fx-background-radius: 25; -fx-cursor: hand;">
                    <effect>
                        <DropShadow color="#4527A0" offsetY="5" radius="12"/>
                    </effect>
                </Button>

                <Button text="FERMER" onAction="#handleFermer"
                        prefWidth="150" prefHeight="50"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #1a237e; -fx-font-weight: bold; -fx-font-size: 14;
                               -fx-border-color: #1a237e; -fx-border-width: 2;
                               -fx-background-radius: 25; -fx-border-radius: 25; -fx-cursor: hand;">
                </Button>
            </HBox>

        </VBox>
    </ScrollPane>
</VBox>