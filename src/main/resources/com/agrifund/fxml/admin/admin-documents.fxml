<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.agrifund.controller.admin.AdminDocumentsController"
            stylesheets="@../../css/styles.css">

    <!-- MAIN CONTENT -->
    <center>
        <VBox styleClass="content-area" spacing="0">
            <!-- Top Bar -->
            <HBox alignment="CENTER" style="-fx-padding: 0 0 30 0;">
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Validation des Documents" styleClass="page-title"/>
                    <Label text="Vérifier et valider les documents soumis" styleClass="page-subtitle"/>
                </VBox>
            </HBox>

            <!-- Stats Cards -->
            <HBox spacing="20" style="-fx-padding: 0 0 30 0;">
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" style="-fx-background-color: linear-gradient(to right, #E1B323, #c9a11f);">
                    <Label fx:id="pendingCount" text="0" styleClass="stat-value"/>
                    <Label text="En attente" styleClass="stat-label"/>
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" style="-fx-background-color: linear-gradient(to right, #089647, #076A39);">
                    <Label fx:id="validatedCount" text="0" styleClass="stat-value"/>
                    <Label text="Validés" styleClass="stat-label"/>
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" style="-fx-background-color: linear-gradient(to right, #dc3545, #c82333);">
                    <Label fx:id="rejectedCount" text="0" styleClass="stat-value"/>
                    <Label text="Rejetés" styleClass="stat-label"/>
                </VBox>
            </HBox>

            <!-- Filter -->
            <HBox spacing="10" style="-fx-padding: 0 0 20 0;">
                <Button fx:id="btnPending" text="⏳ En attente" styleClass="btn"
                        style="-fx-background-color: #E1B323; -fx-text-fill: #060806;" onAction="#filterPending"/>
                <Button fx:id="btnAll" text="📄 Tous" styleClass="btn, btn-secondary" onAction="#filterAll"/>

                <Region HBox.hgrow="ALWAYS"/>

                <ComboBox fx:id="typeFilter" promptText="Type de document" prefWidth="200"/>
                <Button text="🔄 Actualiser" styleClass="btn, btn-secondary" onAction="#refreshList"/>
            </HBox>

            <!-- Documents List -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                <VBox fx:id="documentsList" spacing="15">
                    <!-- Rempli dynamiquement -->
                </VBox>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>