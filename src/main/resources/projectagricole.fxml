<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controles.projectagricolecontroller">

    <!-- Header -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: white; -fx-padding: 15px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <Label text="Gestion des Projets Agricoles" styleClass="title-label" HBox.hgrow="ALWAYS"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Aller vers Ressources ➔" styleClass="btn-nav" onAction="#goToRessources" prefHeight="35"/>
        </HBox>
    </top>

    <!-- Main Content -->
    <center>
        <HBox spacing="20" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Left Side: Form -->
            <VBox spacing="20" prefWidth="350" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                <Label text="Détails du Projet" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #095032;"/>

                <GridPane vgap="15" hgap="10">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="35"/>
                        <ColumnConstraints percentWidth="65"/>
                    </columnConstraints>

                    <Label text="Nom du projet:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="tfNomProject" promptText="Ex: Projet Blé" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Surface (Hectare):" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="tfSurface" promptText="Ex: 25.5" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Budget (DT):" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="tfBudget" promptText="Ex: 12000.00" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Statut:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="cbStatut" promptText="Sélectionner..." maxWidth="1.7976931348623157E308" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Date Soumission:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <DatePicker fx:id="dpDateSoumission" maxWidth="1.7976931348623157E308" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                </GridPane>

                <HBox spacing="10" alignment="CENTER" VBox.vgrow="NEVER">
                    <Button text="Ajouter" styleClass="btn-primary" onAction="#addProject" prefWidth="90" prefHeight="35"/>
                    <Button text="Modifier" styleClass="btn-secondary" onAction="#updateProject" prefWidth="90" prefHeight="35"/>
                    <Button text="Supprimer" styleClass="btn-danger" onAction="#deleteProject" prefWidth="90" prefHeight="35"/>
                </HBox>
                <Button text="Vider les champs" style="-fx-background-color: transparent; -fx-text-fill: #848A86; -fx-cursor: hand;" onAction="#clearFields" maxWidth="1.7976931348623157E308" alignment="CENTER"/>
            </VBox>

            <!-- Right Side: Zone des Cartes (Remplaçant le TableView) -->
            <VBox HBox.hgrow="ALWAYS" spacing="10">
                <Label text="Liste des projets récents" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #060806;"/>

                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                    <!-- Le FlowPane permet aux cartes de s'aligner et de passer à la ligne -->
                    <FlowPane fx:id="projectsContainer" hgap="15" vgap="15" style="-fx-padding: 5;">
                        <!-- Les cartes seront ajoutées ici en Java -->
                    </FlowPane>
                </ScrollPane>
            </VBox>
        </HBox>
    </center>
</BorderPane>