<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@style.css" style="-fx-background-color: #F8F9FA;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controles.projectagricolecontroller">

    <!-- Top Navigation Header -->
    <top>
        <VBox spacing="0">
            <!-- Main Header Bar -->
            <HBox alignment="CENTER" spacing="20" styleClass="page-header">
                <padding>
                    <Insets top="20" right="30" bottom="20" left="30"/>
                </padding>

                <!-- Left: Logo and Title -->
                <HBox alignment="CENTER_LEFT" spacing="15" HBox.hgrow="ALWAYS">
                    <StackPane styleClass="icon-container" style="-fx-min-width: 55; -fx-min-height: 55; -fx-background-color: rgba(255,255,255,0.2);">
                        <Label text="🌿" style="-fx-font-size: 32px;"/>
                    </StackPane>
                    <VBox spacing="0">
                        <Label text="Gestion des Projets Agricoles" styleClass="header-title" style="-fx-font-size: 26px;"/>
                        <Label text="Plateforme de financement et suivi des projets"
                               style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 13px;"/>
                    </VBox>
                </HBox>

                <!-- Right: Navigation Button -->
                <Button text="📦 Ressources →" styleClass="btn-nav"
                        style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"
                        onAction="#goToRessources" prefHeight="40" prefWidth="160"/>
            </HBox>

            <!-- Toolbar Section -->
            <HBox alignment="CENTER_LEFT" spacing="15" styleClass="toolbar">
                <padding>
                    <Insets top="15" right="30" bottom="15" left="30"/>
                </padding>

                <VBox spacing="3">
                    <Label text="🌾 Liste des Projets" styleClass="subtitle-label" style="-fx-font-size: 18px;"/>
                    <Label text="Visualisez et gérez tous vos projets agricoles" style="-fx-text-fill: #6C757D; -fx-font-size: 12px;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Search Field with Icon -->
                <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-background-color: #F8F9FA; -fx-background-radius: 20px; -fx-padding: 8px 16px;">
                    <Label text="🔍" style="-fx-font-size: 16px;"/>
                    <TextField fx:id="tfSearchProject" promptText="Rechercher un projet..."
                               prefWidth="220" style="-fx-background-color: transparent; -fx-border-width: 0;"/>
                </HBox>

                <!-- Filter ComboBox -->
                <ComboBox fx:id="cbFilterStatutList" promptText="Filtrer par statut"
                          prefWidth="160" style="-fx-font-size: 13px;"/>

                <!-- Add Button -->
                <Button text="+ Nouveau Projet" styleClass="btn-primary"
                        onAction="#openAddProjectForm" prefHeight="40" prefWidth="180"/>
            </HBox>
        </VBox>
    </top>

    <!-- Main Content Area -->
    <center>
        <VBox spacing="0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="25" right="30" bottom="25" left="30"/>
            </padding>

            <!-- Statistics Dashboard -->
            <VBox spacing="15">
                <padding>
                    <Insets bottom="15"/>
                </padding>

                <!-- Stats Section Header -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="📊" style="-fx-font-size: 20px;"/>
                    <Label text="Tableau de Bord" styleClass="section-header" style="-fx-font-size: 17px;"/>
                </HBox>

                <!-- Stats Cards Grid -->
                <GridPane hgap="20" vgap="20">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                    </columnConstraints>

                    <!-- Total Projects Card -->
                    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="stat-card" GridPane.columnIndex="0">
                        <StackPane styleClass="icon-container" style="-fx-min-width: 55; -fx-min-height: 55; -fx-background-color: #D8F3DC;">
                            <Label text="📁" style="-fx-font-size: 28px;"/>
                        </StackPane>
                        <VBox spacing="4">
                            <Label text="Total Projets" styleClass="stat-label" style="-fx-font-size: 13px;"/>
                            <Label fx:id="lblTotalProjects" text="--" styleClass="stat-value" style="-fx-font-size: 28px;"/>
                        </VBox>
                    </HBox>

                    <!-- Accepted Projects Card -->
                    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="stat-card" GridPane.columnIndex="1">
                        <StackPane styleClass="icon-container" style="-fx-min-width: 55; -fx-min-height: 55; -fx-background-color: #D5F4E6;">
                            <Label text="✓" style="-fx-font-size: 32px; -fx-text-fill: #40916C; -fx-font-weight: bold;"/>
                        </StackPane>
                        <VBox spacing="4">
                            <Label text="Acceptés" styleClass="stat-label" style="-fx-font-size: 13px;"/>
                            <Label fx:id="lblAcceptedProjects" text="--" styleClass="stat-value" style="-fx-font-size: 28px; -fx-text-fill: #40916C;"/>
                        </VBox>
                    </HBox>

                    <!-- In Progress Projects Card -->
                    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="stat-card" GridPane.columnIndex="2">
                        <StackPane styleClass="icon-container" style="-fx-min-width: 55; -fx-min-height: 55; -fx-background-color: #FFE5CC;">
                            <Label text="⏳" style="-fx-font-size: 28px;"/>
                        </StackPane>
                        <VBox spacing="4">
                            <Label text="En Cours" styleClass="stat-label" style="-fx-font-size: 13px;"/>
                            <Label fx:id="lblInProgressProjects" text="--" styleClass="stat-value" style="-fx-font-size: 28px; -fx-text-fill: #F4A261;"/>
                        </VBox>
                    </HBox>

                    <!-- Refused Projects Card -->
                    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="stat-card" GridPane.columnIndex="3">
                        <StackPane styleClass="icon-container" style="-fx-min-width: 55; -fx-min-height: 55; -fx-background-color: #FFE5E5;">
                            <Label text="✗" style="-fx-font-size: 32px; -fx-text-fill: #E76F51; -fx-font-weight: bold;"/>
                        </StackPane>
                        <VBox spacing="4">
                            <Label text="Refusés" styleClass="stat-label" style="-fx-font-size: 13px;"/>
                            <Label fx:id="lblRefusedProjects" text="--" styleClass="stat-value" style="-fx-font-size: 28px; -fx-text-fill: #E76F51;"/>
                        </VBox>
                    </HBox>
                </GridPane>
            </VBox>

            <!-- Separator -->
            <Separator style="-fx-padding: 10px 0;">
                <padding>
                    <Insets top="10" bottom="10"/>
                </padding>
            </Separator>

            <!-- Projects Grid Section -->
            <VBox spacing="15" VBox.vgrow="ALWAYS">
                <!-- Section Header -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="📋" style="-fx-font-size: 18px;"/>
                    <Label text="Tous les Projets" styleClass="section-header" style="-fx-font-size: 16px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Projects Container with Enhanced Cards -->
                <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS"
                            style="-fx-background-color: transparent; -fx-border-width: 0;">
                    <FlowPane fx:id="projectsContainer" hgap="20" vgap="20"
                              style="-fx-padding: 5; -fx-background-color: transparent;"/>
                </ScrollPane>
            </VBox>
        </VBox>
    </center>

    <!-- Optional Footer with Quick Stats -->
    <bottom>
        <HBox alignment="CENTER" spacing="30" style="-fx-background-color: white; -fx-padding: 12px 30px; -fx-border-color: #E9ECEF; -fx-border-width: 1 0 0 0;">
            <HBox spacing="8" alignment="CENTER">
                <Label text="💰" style="-fx-font-size: 16px;"/>
                <VBox spacing="0">
                    <Label text="Budget Total" style="-fx-font-size: 11px; -fx-text-fill: #6C757D;"/>
                    <Label fx:id="lblTotalBudget" text="-- DT" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2D6A4F;"/>
                </VBox>
            </HBox>

            <Separator orientation="VERTICAL" style="-fx-padding: 0;"/>

            <HBox spacing="8" alignment="CENTER">
                <Label text="🌍" style="-fx-font-size: 16px;"/>
                <VBox spacing="0">
                    <Label text="Surface Totale" style="-fx-font-size: 11px; -fx-text-fill: #6C757D;"/>
                    <Label fx:id="lblTotalSurface" text="-- Ha" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2D6A4F;"/>
                </VBox>
            </HBox>

            <Separator orientation="VERTICAL" style="-fx-padding: 0;"/>

            <HBox spacing="8" alignment="CENTER">
                <Label text="📅" style="-fx-font-size: 16px;"/>
                <VBox spacing="0">
                    <Label text="Dernière Mise à Jour" style="-fx-font-size: 11px; -fx-text-fill: #6C757D;"/>
                    <Label fx:id="lblLastUpdate" text="Aujourd'hui" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2D6A4F;"/>
                </VBox>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </bottom>
</BorderPane>
